<?xml version="1.0" encoding="utf-8"?>
<!--
  字、尺寸、以及界面里反复出现的那几种形状。Palette.xaml 管颜色，这里管其余的一切。

  这两个文件分工的判据是「换主题会不会动它」：颜色会，字号和圆角不会。所以 Palette.xaml 里那三份
  ThemeDictionaries 只剩颜色，原来挂在它尾巴上的「与主题无关」那一段整段搬到了这里 —— 唯独两个
  EgOnScrim* 画刷留在那边，它们是颜色，只是恰好不跟主题走。

  方向是「放映室」：这个客户端没有东西要卖给谁，它是一台把片子交给 mpv 的仪器。所以剧照是胶片，围着
  它的每一样东西都是刻度和标签 —— 标题用机器和仪表上刻的那种字，数字一律等宽，结构靠发丝线而不靠
  色块，海报是方的胶片格而不是圆角卡片。

  在 App.xaml 里并在 Palette.xaml 之后。两份都在应用级，所以谁引用谁的键都解析得到。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Momoka.Shell.Views">

    <!-- ============================ 三种字 ============================ -->

    <!--
      正文。WinForms 那版用的就是它，换过来时保留，两边看着才像同一个产品；Segoe UI Variable 在这里
      没有能用的汉字覆盖。这一个必须留在树根上 —— 自检有一条盯着 ShellPage.FontFamily 就是它。
    -->
    <FontFamily x:Key="EgUiFontFamily">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>

    <!--
      标题字：Bahnschrift 是微软自带的 DIN 1451 可变字体（Win10 1709 起随系统），也就是刻在胶片罐、
      推子条和放映机铭牌上的那种字。SemiCondensed 这一档窄，所以同样的版面能放下更大的号 —— 页面
      标题因此从 28 提到 34 而没有变宽。
      逗号后面那个不是保险，是分工：Bahnschrift 没有汉字，中文标题由 Microsoft YaHei UI 接着画，
      一串里前面的字体缺哪个字就往后落一个。整套字体缺席时（非 Windows 10 1709+）也是落到它，界面
      退回全 YaHei，只是失去这一层区分。
    -->
    <FontFamily x:Key="EgDisplayFontFamily">Bahnschrift SemiCondensed, Microsoft YaHei UI</FontFamily>

    <!--
      数字字。时长、年份、分辨率、码率、集号、条目数一律走它 —— 等宽之后同一列里的数字对得齐，而且
      数字从「一句话里的词」变成「仪表上的读数」，这是整套里最出身份的一个决定。
      Cascadia Mono 排在前面是机会性的：装了 Windows Terminal 或 VS 的机器上有，本机没有，于是落到
      Consolas（`C:\Windows\Fonts\consola.ttf`，每台 Windows 都有）。最后一档兜汉字。
    -->
    <FontFamily x:Key="EgDataFontFamily">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- 字号阶。14 和 12 一个没动 —— 界面里上百处引用它们。 -->
    <x:Double x:Key="EgEyebrowFontSize">11</x:Double>
    <x:Double x:Key="EgCaptionFontSize">12</x:Double>
    <x:Double x:Key="EgBodyFontSize">14</x:Double>
    <x:Double x:Key="EgSubheadFontSize">16</x:Double>
    <!-- 播放页左上角第二行（文件信息）那一档。**它不是「阶里 18 那一个」** ——
         独占 uosc 顶栏给这一行的字号是 `\fs` = `round(alt_title_size * 0.71)`，但 libass 的 `\fs`
         按 **72 DPI 的 pt** 渲染，而这里的 `FontSize` 是 **96 DPI 的 px**：同一个数，屏上差 0.75 倍
         （72/96）。实测为证（两边同串「└ 1920 x 1080 · HEVC · AAC · Studio GreenTea」，当时的 0.77 档）：
         独占窗口档 `\fs18` 墨迹宽 292、独占全屏档 `\fs24` 宽 388（比值 1.33 ＝ 字号比，说明这条换算是线性的），
         而集成照抄 18px 画出来是 385 —— **正好是独占全屏档那一档**，比窗口档大三分之一，用户令
         2026-09-28 更晚「集成模式下面的元数据体积太大了，与独占模式不一致」说的就是它。
         于是先按 18 × 0.75 ＝ 13.5 定档；用户令 2026-09-29「元数据缩小一点点，集成模式和独占模式大小要一致」
         把独占的因子 0.77 收到 0.71（窗口档 `\fs17`、全屏档 `\fs22`），这边跟着落到 17 × 0.75 ＝ 12.75；
         全屏档 `\fs22` → 16.5（见 ApplyTitleScale）。
         嫌大嫌小改这一个数，**但独占 TopBar.lua 的 0.71 因子要一起动**（见那边的 MOMOKA[topbar-subline-size]）。 -->
    <x:Double x:Key="EgSublineFontSize">12.75</x:Double>
    <x:Double x:Key="EgTimelineFontSize">18</x:Double>
    <x:Double x:Key="EgTitleFontSize">20</x:Double>
    <x:Double x:Key="EgHeaderFontSize">36</x:Double>
    <x:Double x:Key="EgDisplayFontSize">52</x:Double>

    <!--
      眉字的字距，千分之一 em 为单位（CharacterSpacing 就是这个单位）。0.14 em 是「小号大写要读得开」
      的那一档；正文一律不动字距。
    -->
    <x:Int32 x:Key="EgEyebrowSpacing">140</x:Int32>

    <!-- ============================ 几何 ============================ -->

    <!-- 你会去点的面板：设置卡片、账号那一块、对话框、浮出菜单。留着圆角，手感上它还是个 Windows 应用。 -->
    <CornerRadius x:Key="EgCardCornerRadius">16</CornerRadius>

    <!--
      同一档圆角，给「一块板要分两截画」的那一处（集页整段上方那块大面板：上截贴在头图那一格里、下截贴在
      尾部那一格，两截各自只有外侧两个角）。这两个键里的 16 必须和上面那个一样 —— XAML 里没有「取一个
      CornerRadius 的前两个角」这种写法，所以是抄一份数而不是引用一份，改圆角要三处一起改。
    -->
    <CornerRadius x:Key="EgCardCornerRadiusTop">16,16,0,0</CornerRadius>
    <CornerRadius x:Key="EgCardCornerRadiusBottom">0,0,16,16</CornerRadius>

    <!--
      封面的圆角（「把封面改成圆角的」）：海报、剧照、单集缩略图那一格，也就是 EgFrameStyle 和详情页头部
      那张海报。8 和上面那个面板的圆角同一个数 —— 整套界面只有这一档圆角，两个键是为了以后能各自改。
      在这之前它是 0：胶片格本来是方的，一墙密排的海报靠直角读得清。现在照用户说的走，圆角回来了。
      圆角只有 Border 剪得动 —— Border 会按自己的 CornerRadius 裁掉孩子，Grid 和 Panel 只是把自己的底色
      和框线画圆，孩子照旧方着。所以凡是「里面那张图自己铺到四边」的块，用下面那个 0，见那条说明。
    -->
    <CornerRadius x:Key="EgPosterCornerRadius">12</CornerRadius>

    <!--
      还是方的那几块：设置里那六块色板。它们的共同点不是「大」，是**里面的东西自己画到边而外面那层剪不动它**：
      那一处外面是 Button，圆角只会让底色缩进去、露出孩子的直角。
      （主页那条通栏轮播从前也在这里 —— 它四边就是窗口的边和侧边栏那道竖线；2026-09-10「弄个框把轮播图框起来
      （圆角）」之后它换成了自己的 EgFrame 圆角框（HomeBanner.xaml 里 Frame 那一段），不再用这个键。）
    -->
    <CornerRadius x:Key="EgBleedCornerRadius">0</CornerRadius>

    <!--
      详情页文件选项那六颗下拉的圆角（「字幕、音频、视频的选择框边角弄圆一些」，2026-09-12）。三个选择器
      （视频／媒体源、音频、字幕）各有两颗 —— 集页宽版式一份站在片名栏里、其余页面和紧凑版式一份站在尾部，
      六颗共用这一个键。Fluent 给 ComboBox 的出厂圆角是 4，站在这套 16 的卡片、12 的封面旁边读着太方；
      取封面那一档 12 —— 下拉高 32，再往上（16）就整颗胶囊了。只圆闭合时那一圈框，点开的下拉列表还是
      框架自己的圆角，跟设置页那些下拉一个样。
    -->
    <CornerRadius x:Key="EgPickerCornerRadius">12</CornerRadius>

    <!--
      详情页那几颗下拉的衣服：<local:EgPicker> 是 ComboBox 的子类，显式样式按「类型精确相等」匹配，框架给
      ComboBox 的那一份隐式样式（generic.xaml 里那条 TargetType="ComboBox"）不会落到子类身上 —— 不接这一行，
      那几颗下拉会一个模板都没有，屏上是空的。接的就是框架那一份，一个字都不改：这次要改的只是弹层开在哪棵树
      里，那件事在 C# 里（EgPicker.OnApplyTemplate），不在样式里。
      隐式（没有 x:Key）而不是给每颗下拉写 Style=""：七颗下拉一个样子，写七遍只会漂。
      摆在这个文件而不是 App.xaml —— 这里管形状、Palette 管颜色，一颗下拉穿什么衣服属于前者。
    -->
    <Style TargetType="local:EgPicker" BasedOn="{StaticResource DefaultComboBoxStyle}" />

    <!-- 发丝线的粗细。结构靠它，不靠色块 —— 所以只有一档，加粗只发生在框线变强调色的时候。 -->
    <Thickness x:Key="EgHairline">1</Thickness>

    <!-- 胶片格右上角那颗方块的边长：一个数字或一个对勾刚好放得下。 -->
    <x:Double x:Key="EgCornerBadgeSize">20</x:Double>

    <!--
      同一颗方块的圆角（「封面右上角的那个改成圆角」，2026-09-14）。取 6，不是封面那档 12 —— 这颗只有
      20 见方，12 就是整颗圆掉了、读不出它是个角标；6 让四个角都磨圆一点，还看得出是块方牌。
      右上角那一角同时在框的圆角里（EgFrameStyle 按 12 剪孩子，比 6 大），所以那一角实际看的是框的弧，
      另外三个角看这里的 6。数字和对勾共用这一颗，圆角自然也共用。
    -->
    <CornerRadius x:Key="EgCornerBadgeCornerRadius">6</CornerRadius>

    <!-- 看到一半时压在下边框线上的那条进度，2px —— 比发丝线粗一档，才看得出它是「读数」不是「边」。 -->
    <x:Double x:Key="EgProgressThickness">2</x:Double>

    <!--
      按键的高度。整套界面只有这一个 —— 头图上的播放键、轮播的播放和详情、翻页箭头、圆图标键，以前是
      38/40/44 三档混着，差 2 像素的两颗键并排放着只会显得没对齐。方形图标键的边长也是它。
    -->
    <x:Double x:Key="EgActionHeight">44</x:Double>

    <!--
      「修改媒体封面图」面板上那六格的框宽（2026-09-13）。

      三档是两个数：格宽和内缩后的图宽。图宽比格宽小 24，是给那一行三个图标键腾的地方 —— 键的边长 40，
      三个并排是 120 + 两个 8 的间隔 = 136，所以 140 的帧宽放得下，而 164 的格宽（140 + 两侧各 12 的余量）
      再乘 6 格加五道间隔，正好落在对话框 1000 的上限里。
    -->
    <x:Double x:Key="EgArtworkFrameWidth">140</x:Double>
    <x:Double x:Key="EgArtworkCellWidth">164</x:Double>

    <!--
      背景图那一排的格宽。它比上面那六格宽一档（188 对 164），因为这一排一行只摆得来四五张 —— 背景图是
      16:9 的横图，摆成六格那样窄一条的话，缩略图里什么都认不出。
    -->
    <x:Double x:Key="EgBackdropFrameWidth">188</x:Double>
    <x:Double x:Key="EgBackdropCellWidth">212</x:Double>

    <!-- ============================ 间距 ============================ -->

    <!--
      间距刻度，2026-09-06 按 WinUI-Gallery 那套重排（「间距 → 统一 24 / 36」）。全部是 4 的倍数 —— Fluent
      的版面就是一张 4 像素的格纸，而这套界面从前是 8、10、12、16、18、20、28 混着，其中 18 和 28 根本不在
      那张格纸上。

        XS  4   贴着的两样东西之间（徽标和它的字）
        S   8   一叠里相邻两行
        M  12   一块板里两组之间
        L  16   卡片之间、货架里两张卡之间
        XL 24   **页面四边、板的内边距** —— 这是这套界面的主间距
        2XL 36  两大块内容之间（页头和第一排货架、正文里两块板）

      为什么写成键而不是各处写数字：这六个数一改，整套跟着改；而这一节存在之前，「页边多宽」这个答案分散在
      七个页面加三个控件里，各写各的。**没有一处新的写死数字该出现在标记里** —— 引这几个键。
    -->
    <x:Double x:Key="EgSpaceXS">4</x:Double>
    <x:Double x:Key="EgSpaceS">8</x:Double>
    <x:Double x:Key="EgSpaceM">12</x:Double>
    <x:Double x:Key="EgSpaceL">16</x:Double>
    <x:Double x:Key="EgSpaceXL">24</x:Double>
    <x:Double x:Key="EgSpace2XL">36</x:Double>

    <!--
      页面四边。四边同一个数（XL，24），2026-09-06 从 28,20,28,20 换过来 —— **Gallery 那套页面是 24 的边距**，
      而 28 是这套界面自己长出来的一个数，不在 4 的格纸上，也和顶上那两行外壳的内缩对不齐。
      跟着这个数走的还有两处，它们必须一起改，否则屏上就是几条差 4 像素的错位竖线：面包屑那一行的左右内缩、
      主页那块牌子的左右、标题栏那一排图标的缩进（17 + 托盘留白 7 = 24）。三样东西一条竖线，见 ShellPage.xaml
      里那两段说明。（从前第四处是标签栏第一格的左边距，那条标签栏 2026-09-08 删掉了。）
    -->
    <Thickness x:Key="EgPageMargin">32,28,32,28</Thickness>

    <!--
      一块板／一张卡里面留多宽。和页边同一个数（XL），所以页边、框线、内边距叠起来是 24 + 1 + 24 —— 板上的
      字和页头的字差 25，看起来是「缩进了一格」而不是「差了几像素」。
      单独一个键而不是直接引 <c>EgSpaceXL</c>：<c>Padding</c> 要的是 Thickness，而刻度那六个是 Double，
      资源引用之间不会替你转换类型（写错的症状是运行时崩在解析这一句上）。
    -->
    <Thickness x:Key="EgPanelPadding">24</Thickness>

    <!--
      一段话最宽排到哪儿。**这是行长，不是版面宽度**：正文 14 号，一个汉字就是 14 像素宽，所以 760 是一行五十来
      个字 —— 读一段话舒服的行长是三十到五十个字，再长眼睛回到下一行的行首就会找错行。
      详情页那段剧情说明从前是通栏的：他那台 1649 宽的窗口上一行七十多个字（2026-09-05 界面复查）。整页跟着通栏
      的东西（那几条卡片带、媒体信息那张表）一个都不用它 —— 那些是并排的格子，格子越宽越好，只有连续的句子有
      行长这回事。
    -->
    <x:Double x:Key="EgProseWidth">760</x:Double>

    <!-- ============================ 文字 ============================ -->
    <!--
      全部带 x:Key，一个隐式样式都没有：应用级的 `Style TargetType="TextBlock"` 会命中界面上每一块
      文字，包括框架控件模板内部的那些。
    -->

    <!--
      眉字：场记板最上面那一行小字，写的是「这是哪一区」。等宽 + 字距拉开 + 一档更淡的字，它的职责
      是定位而不是被读 —— 所以它绝不承担标题的内容，标题在它下面那行。
    -->
    <Style x:Key="EgEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EgDataFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource EgEyebrowFontSize}" />
        <Setter Property="CharacterSpacing" Value="{StaticResource EgEyebrowSpacing}" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextFaintBrush}" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>

    <!-- 页面标题：场记板的第二行，通栏线的上面。 -->
    <Style x:Key="EgPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EgDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource EgHeaderFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>

    <!--
      片名：主页轮播上那一个。整屏最大的一块字。
      （详情页头图上那一行 2026-09-12 分出去成了下面那个 EgHeroTitleStyle —— 那一行会折行，两行的账和
      轮播上这一行不是一笔，理由写在那个键上。）
    -->
    <Style x:Key="EgDisplayTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EgPageTitleStyle}">
        <Setter Property="FontSize" Value="{StaticResource EgDisplayFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
    </Style>

    <!--
      详情页头图上的片名（电影、剧、季、集四种页面共用）。从 EgDisplayTitleStyle 分出来的两处改动
      （2026-09-12，他一张截图两句话：「缩小到上下不会重叠就好」）：

      1. 字号落到页面标题那一档（36）。「无职转生～到了异世界就拿出真本事～」这种长片名在 52 上折两行，
         两行合起来一百三十多像素；而这一行上面顶着徽标、下面紧跟「S3:E2 - 集名」，整段字被它一个人撑高。
         轮播上那一行不折行（单行铺满，字号大正是它的活），所以那一头照旧 52。
      2. 行高写死 45（36 × 1.25）。这一支字体是 Bahnschrift SemiCondensed，汉字从雅黑掉下来 —— 行距按
         Bahnschrift 算，而雅黑的字比那个行距高，于是折行时两行直接叠在一起：他那张截图上第二行的字咬进了
         第一行。LineHeight 只是个下限（LineStackingStrategy 默认取「行高和内容高两者取大」），所以它在这里
         =「还给汉字一个正常的行距」，不是把行压扁。
         ⚠️ 字号要是改回 52，这个 45 就得跟着改（1.25 倍），否则行距又比字小。
    -->
    <Style x:Key="EgHeroTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EgPageTitleStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
        <Setter Property="LineHeight" Value="45" />
    </Style>

    <!-- 分区标题：卡片带的名字、设置页每张卡片的名字。 -->
    <Style x:Key="EgSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EgDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource EgTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
    </Style>

    <Style x:Key="EgSubheadStyle" TargetType="TextBlock" BasedOn="{StaticResource EgSectionTitleStyle}">
        <Setter Property="FontSize" Value="{StaticResource EgSubheadFontSize}" />
    </Style>

    <!--
      读数。凡是数字都走这两个：时长、年份、分辨率、码率、集号、条目数。等宽不只是好看 —— 一列里的
      数字对得齐，而「2024 · 1080P · 2H14M」这种一行几段的读数不会因为字宽不同而挤成一团。
    -->
    <Style x:Key="EgDataStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EgDataFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextDimBrush}" />
    </Style>

    <Style x:Key="EgDataStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource EgDataStyle}">
        <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
    </Style>

    <Style x:Key="EgBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EgUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource EgBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
    </Style>

    <Style x:Key="EgCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource EgBodyStyle}">
        <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextDimBrush}" />
    </Style>

    <!--
      压在剧照上的那几行：详情页头部和主页轮播。两处的暗罩都是写死的黑（浅色主题也一样，压的是照片不是
      主题色），所以字也不跟主题走 —— 颜色取 Palette 里那两支 EgOnScrim 画刷。

      除了颜色，字体和字号跟页面里的完全同一套，一档都不新造：以前这两处各写各的 FontSize="40"、
      FontSize="34"、Opacity="0.86"，于是同一个产品的两个大画面，字不一样大、也不是同一种字。
    -->
    <Style x:Key="EgOnScrimEyebrowStyle" TargetType="TextBlock" BasedOn="{StaticResource EgEyebrowStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimDimBrush}" />
    </Style>

    <Style x:Key="EgOnScrimBodyStyle" TargetType="TextBlock" BasedOn="{StaticResource EgBodyStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
    </Style>

    <Style x:Key="EgOnScrimDataStyle" TargetType="TextBlock" BasedOn="{StaticResource EgDataStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimDimBrush}" />
    </Style>

    <Style x:Key="EgOnScrimDataStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource EgDataStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
    </Style>

    <!-- 卡片带那块牌子压在剧照上时的标题（ShelfHead.OnScrim）：集页把同季那一带摆在头图底下的画面里。 -->
    <Style x:Key="EgOnScrimSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EgSectionTitleStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
    </Style>

    <!--
      场记板压在剧照上的那一份：主页的大图铺到窗口顶边之后，页眉就站在图上了（见 PageSlate.OnScrim）。
      只换颜色，字体字号一档不改 —— 同一块场记板换个底，不该顺手换成另一个字号。
    -->
    <Style x:Key="EgOnScrimPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EgPageTitleStyle}">
        <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
    </Style>

    <!-- ============================ 形状 ============================ -->

    <!--
      通栏发丝线。场记板下面那一条，也是任何两块内容之间要分开时用的那一条 —— 整页只有这一种横向
      结构。用 Border 而不是 Rectangle：它在 Grid 里横向 Stretch 是默认行为，不用写宽度。
    -->
    <Style x:Key="EgRuleStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource EgBorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!--
      胶片格：海报、缩略图、剧照外面那一圈。签名元素就是这根线 —— 卡片的所有状态都由它和它四个角上
      的东西表达，不靠药丸徽章、不靠阴影、不靠缩放：

        · 静止        1px 发丝框，圆角 8（「把封面改成圆角的」，见 EgPosterCornerRadius）
        · 指针/焦点   整圈变强调色（唯一会给整圈上色的事，所以它和持久状态永不撞车）
        · 看到一半    2px 强调色压在下边框线上，长度就是进度
        · 还剩几集    右上角一颗强调色方块，里面是等宽的数字
        · 全看完      同一颗方块，里面换成对勾
        · 没开始看    什么都不加 —— 一屋子海报里绝大多数都是没看过的，标它等于标了全场

      圆角一上来，里面那几件东西是被这一圈剪着的（Border 会按 CornerRadius 裁孩子）：右上角那颗方块
      跟着圆了一个角，底边那条进度两头各被切掉两三个像素。两处都是对的 —— 它们本来就说自己是「框的
      一部分」，框圆了它们就该跟着圆。那颗方块自己另有一档 6 的圆角（EgCornerBadgeCornerRadius，
      2026-09-14）：朝里的三个角是它自己的弧度，只有朝外那一角是这一圈剪出来的 —— 框的 12 比它的 6
      大，所以那一角读的是框的弧。
    -->
    <Style x:Key="EgFrameStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="{StaticResource EgHairline}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource EgPosterCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource EgSurfaceAltBrush}" />
    </Style>

    <!-- 指针在上面、或者键盘焦点落在上面时的同一根线。 -->
    <Style x:Key="EgFrameActiveStyle" TargetType="Border" BasedOn="{StaticResource EgFrameStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource EgAccentBrush}" />
    </Style>

    <!--
      正文里的一块板 —— 详情页那几个板块（媒体源、简介、单集、剧季、相似、演职人员）各是一块。

      形状和底色都照设置页那些卡片抄（内边距 24、1px 发丝框、圆角 8、EgSurfaceAltBrush）：整个界面上
      「一块能放东西的板」只有一种长相。内容因此落在页边 24 + 框 1 + 内边距 24 = 49 上，和设置页每一张
      卡里的字同一条线。**那个 24 是间距刻度里的 XL**，2026-09-06 从 18 换过来的（18 不在 4 的格纸上）。

      底色是实心的，不是亚克力 ——「滑到下面不用显示背景了，五颜六色的太丑了」。中间那一版让每块板都透着
      背后那张固定的剧照、块与块之间留缝漏图，读起来就是一页花的：板上的字压在剧照的颜色上，缝里露出的是
      被切成条的画面。图现在只在头上那一格露着，正文是一张不透明的纸（见 DetailPage 的 BodySheet）。

      给 StackPanel 而不是 Border：正文那几块本来就是 StackPanel（一叠东西，自带 Spacing），包一层
      Border 会让每一块多一级嵌套，而 WinUI 的 StackPanel 自己就有 Background/BorderBrush/Padding/
      CornerRadius 这四样 —— Panel 没有 Padding，所以 TargetType 只能是 StackPanel。
    -->
    <Style x:Key="EgBodyPanelStyle" TargetType="StackPanel">
        <Setter Property="Background" Value="{ThemeResource EgSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource EgHairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource EgPanelPadding}" />
    </Style>

    <!--
      右上角那颗方块。数字和对勾用同一颗，因为它们说的是同一件事 ——「还剩多少」，对勾就是「零」。
      跟框线齐平（没有外边距），它是框的一部分而不是浮在图上的贴纸；四角磨圆 6（见
      EgCornerBadgeCornerRadius），圆了之后它仍是块贴角的牌，不是一颗浮起来的圆形徽章。
    -->
    <Style x:Key="EgCornerBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource EgAccentBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource EgCornerBadgeCornerRadius}" />
        <Setter Property="MinWidth" Value="{StaticResource EgCornerBadgeSize}" />
        <Setter Property="Height" Value="{StaticResource EgCornerBadgeSize}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Padding" Value="4,0,4,0" />
    </Style>

    <Style x:Key="EgCornerBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EgDataFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource EgEyebrowFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextOnAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 保留系统模板的焦点、键盘和高对比行为，只统一交互表面的尺寸。 -->
    <Style x:Key="EgPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="EgSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Background" Value="{ThemeResource EgSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
    </Style>

    <Style x:Key="EgIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--
      「修改媒体封面图」那一格里摆图的位置（2026-09-13）。

      一个 Button 而不是 Border + 手势：这一格整块点下去就是「换这一种图」，用按钮才有焦点环、才有键盘能按到、
      才不必自己接 PointerPressed。默认模板会把内容居中并给它一圈内边距和底色，所以这里把它拆平 —— 这一格要的
      是「一个能点的画框」，不是一颗键。

      虚线框是「这儿本来该有张图、现在没有」：实线发丝框说的是「这是一张图」，虚线的意思是「这儿少一张」。
      ContentDialog 的描边比卡片上那根粗一档才看得出来，所以 DashStyle 用的是 3,2 而不是 1,1。
    -->
    <Style x:Key="EgArtworkTileStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource EgSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource EgHairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource EgPosterCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- 空格子里那颗加号：比图小一圈、比读数淡一档 —— 它是「这儿少一张」而不是「按我」。 -->
    <Style x:Key="EgArtworkEmptyGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource EgTextFaintBrush}" />
    </Style>

    <!--
      ===================== 收窄的滚动条（2026-10-01） =====================

      「收窄首页右边滚动条的背景遮罩」—— 用户点名的是那条比页面底色亮一档的**轨道底**
      （框架模板里的 VerticalTrackRect，Fill = ScrollBarTrackFill = AcrylicInAppFillColorDefaultBrush），
      不是把手、也不是滚动能力。框架那一条轨道跟滚动条本身一样宽（ScrollBarSize = 12），压在首页那张
      通栏剧照的右端就是一条 12 像素宽的亮边；用户要它收窄到只剩把手附近的一点点。

      为什么必须在模板里改、不能只换画刷键：轨道那一格是 Grid.RowSpan="5" 的 Rectangle，宽度由
      ScrollBar 自己的宽撑满（HorizontalAlignment 默认 Stretch），换画刷只能换颜色、换不掉宽度。
      所以这里照抄框架 DefaultScrollBarStyle 的模板，只动 VerticalTrackRect 一处 —— 给它
      HorizontalAlignment="Center" + 一个写死的宽（EgScrollBarTrackWidth），于是它从「铺满 12 像素」
      收成「中间一条 6 像素」。把手（VerticalThumb）与它那支 ScrollBarVerticalThumbMinWidth = 8 一个字
      没动：收的是底，把手的粗细是另一件事（用户说的是「背景遮罩」）。

      为什么会话里看不到滚轮那几档小箭头：这台机器注不进鼠标事件，而且框架那几档 MinorSize 的箭头
      平时 Opacity 就是 0（NoIndicator 那一组把它们逐个归零），所以模板里照抄、不去删 —— 删了会在
      「指针压上去」那一档（Expanded）里少画东西，而那一档这台机器拍不到。

      **这一支只挂在首页的 Scroller 上**（HomePage.xaml 的 ScrollView.Resources），不动全应用：
      「按页面/按用户点名的范围改，改一处记一处」是这一族改动的老规矩（同 EgPicker 那一段）。
      别的页面（详情页、设置页、通知页…）照旧用框架那一档 12 像素的底，哪天用户点名再照这里收。

      **第二轮（同日晚，用户复述同一请求）**：拿设置窗实测加框架源码
      （microsoft-ui-xaml `controls/dev/CommonStyles/ScrollBar_themeresources.xaml`、`controls/dev/ScrollView/ScrollView.xaml`）
      对过之后发现——当前框架的暗色主题里 `ScrollBarBackground`／`ScrollBarBackgroundPointerOver` 三态**全是透明**，
      「悬停时多出一层 12 像素底板」根本不存在；第一轮之后还宽着的其实是**把手本体**：悬停展开到 12、
      滚轮滚动那一下 8。所以第二轮把 ThumbVisual 的可视条钉成与轨道同宽的 6 像素并水平居中（见
      VerticalThumbTemplate 上的注释）：悬停、滚轮两态画出来的条都落在 3..9，与轨道同轴，整支滚动条
      任何状态下最宽就是中间那 6 像素；Thumb 元素的命中区维持框架动画（8↔12）不动，拖拽手感不变。
      用户截图里那条 2 像素亮线是**触控/触摸板平移指示器**（`VerticalPanningThumb`，Width=2，滚动后亮约
      两秒淡出），比 6 像素还细，未动；若他指的是这条线本身，首页可整条隐藏，等点名再做。
      验证边界：悬停展开态这台机器拍不到（注不进指针事件，仓库多条注释同此结论），本轮服务器又恰逢
      掉线、首页截图欠着——读数全部来自设置窗实测与框架源码，不是渲染截图。

      **第三轮定案（同日更晚）**：服务器回来后用户发来新构建的截图并说「还是这么宽」，接着一句
      「遮海报遮太多了，不是滚动条的问题」点破真相——他要的一直是海报前面那条 36 像素的空底
      （首页 Overlay 的右 Padding：海报在那儿被裁断，空底看着像盖住海报的遮罩），滚动条只是恰好
      站在那条带子里。真修在 HomePage.xaml 的 Overlay Padding（右 36→13，海报推进 23 像素）；
      本支样式这两轮收窄照留（轨道 6、把手可视条 6），方向没错、不是他点的那件事。
      **第四轮（同日最晚）**：「滚动条不要延伸到轮播图上」——这支样式只管形状，滚动条的**顶**由
      HomePage.PlaceScrollBar 压到轮播下沿（Margin 随带高走，XAML 里没有那个数）。
    -->
    <x:Double x:Key="EgScrollBarTrackWidth">6</x:Double>

    <Style x:Key="EgNarrowScrollBarStyle" TargetType="ScrollBar" BasedOn="{StaticResource DefaultScrollBarStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root">

                        <Grid.Resources>
                            <ControlTemplate x:Key="RepeatButtonTemplate" TargetType="RepeatButton">
                                <Grid x:Name="Root" Background="Transparent">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>

                            <ControlTemplate x:Key="VerticalIncrementTemplate" TargetType="RepeatButton">
                                <Grid x:Name="Root" Background="{ThemeResource ScrollBarButtonBackground}" BorderBrush="{ThemeResource ScrollBarButtonBorderBrush}" Padding="{ThemeResource ScrollBarVerticalIncreaseMargin}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Foreground">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScrollBarButtonArrowForegroundPointerOver}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Foreground">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScrollBarButtonArrowForegroundPressed}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Foreground">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScrollBarButtonArrowForegroundDisabled}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <FontIcon x:Name="Arrow" RenderTransformOrigin="0.5, 0.5" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEDDC;" Foreground="{ThemeResource ScrollBarButtonArrowForeground}" FontSize="{StaticResource ScrollBarButtonArrowIconFontSize}">
                                        <FontIcon.RenderTransform>
                                            <ScaleTransform x:Name="ScaleTransform" ScaleY="1" ScaleX="1" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Grid>
                            </ControlTemplate>

                            <ControlTemplate x:Key="VerticalDecrementTemplate" TargetType="RepeatButton">
                                <Grid x:Name="Root" Background="{ThemeResource ScrollBarButtonBackground}" BorderBrush="{ThemeResource ScrollBarButtonBorderBrush}" Padding="{ThemeResource ScrollBarVerticalDecreaseMargin}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Foreground">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScrollBarButtonArrowForegroundPointerOver}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Foreground">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScrollBarButtonArrowForegroundPressed}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Foreground">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScrollBarButtonArrowForegroundDisabled}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <FontIcon x:Name="Arrow" RenderTransformOrigin="0.5, 0.5" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xEDDB;" Foreground="{ThemeResource ScrollBarButtonArrowForeground}" FontSize="{StaticResource ScrollBarButtonArrowIconFontSize}">
                                        <FontIcon.RenderTransform>
                                            <ScaleTransform x:Name="ScaleTransform" ScaleY="1" ScaleX="1" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Grid>
                            </ControlTemplate>

                            <ControlTemplate x:Key="VerticalThumbTemplate" TargetType="Thumb">
                                <!-- 第二轮（2026-10-01 晚）：可视条钉成与轨道同宽（EgScrollBarTrackWidth）、居中。
                                     Thumb 元素自己的宽度仍由框架状态动画驱动（悬停 12、滚轮态 8），命中区一个原子没动；
                                     但它身上画的那根条永远 6 像素、水平居中 —— 8 宽时缩进 1 像素、12 宽时缩进 3 像素，
                                     两种状态都正好落在 3..9，与中间那条 6 像素轨道同轴，不再有比轨道宽的东西。
                                     （第一轮只收了轨道；框架暗色主题里 Root 底板三态本来就是透明的，宽的是把手本体。） -->
                                <Rectangle x:Name="ThumbVisual" HorizontalAlignment="Center" Width="{StaticResource EgScrollBarTrackWidth}" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{ThemeResource ScrollBarThumbStrokeThickness}" RadiusX="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter}}" RadiusY="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter}}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ThumbVisual" Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="{StaticResource ScrollBarColorChangeDuration}" Value="{ThemeResource ScrollBarThumbFillDisabled}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" To="0" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="ThumbVisual" />
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Rectangle>
                            </ControlTemplate>
                        </Grid.Resources>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource ScrollBarBackgroundDisabled}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource ScrollBarBorderBrushDisabled}" />
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                        <Setter Target="VerticalTrackRect.Stroke" Value="{ThemeResource ScrollBarTrackStrokeDisabled}" />
                                        <Setter Target="VerticalTrackRect.Fill" Value="{ThemeResource ScrollBarTrackFillDisabled}" />
                                        <Setter Target="VerticalPanningThumb.Background" Value="{ThemeResource ScrollBarPanningThumbBackgroundDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ScrollingIndicatorStates">
                                <VisualState x:Name="TouchIndicator">
                                    <VisualState.Setters>
                                        <Setter Target="VerticalRoot.Visibility" Value="Collapsed" />
                                        <Setter Target="VerticalPanningRoot.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="MouseIndicator">
                                    <VisualState.Setters>
                                        <Setter Target="VerticalPanningRoot.Visibility" Value="Collapsed" />
                                        <Setter Target="VerticalRoot.IsHitTestVisible" Value="True" />
                                        <Setter Target="VerticalThumb.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="NoIndicator">
                                    <VisualState.Setters>
                                        <Setter Target="VerticalThumb.Background" Value="{ThemeResource ScrollBarPanningThumbBackground}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalSmallIncrease" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalLargeIncrease" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalLargeDecrease" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalThumb" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalSmallDecrease" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalTrackRect" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VerticalThumb" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ScrollBarContractDuration}" Value="{StaticResource ScrollBarVerticalThumbMinWidth}" KeySpline="0,0,0,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VerticalThumbTransform" Storyboard.TargetProperty="X" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ScrollBarContractDuration}" Value="{StaticResource ScrollBarThumbOffset}" KeySpline="0,0,0,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="VerticalRoot" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="{StaticResource ScrollBarOpacityChangeDuration}">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" Storyboard.TargetName="VerticalPanningRoot" Storyboard.TargetProperty="Opacity" To="0" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="VerticalPanningRoot" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="{StaticResource ScrollBarContractDuration}">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ConsciousStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="Expanded" To="Collapsed">
                                        <Storyboard>
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" BeginTime="{StaticResource ScrollBarContractBeginTime}" Storyboard.TargetName="VerticalSmallIncrease" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" BeginTime="{StaticResource ScrollBarContractBeginTime}" Storyboard.TargetName="VerticalLargeIncrease" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" BeginTime="{StaticResource ScrollBarContractBeginTime}" Storyboard.TargetName="VerticalLargeDecrease" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" BeginTime="{StaticResource ScrollBarContractBeginTime}" Storyboard.TargetName="VerticalSmallDecrease" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" BeginTime="{StaticResource ScrollBarContractBeginTime}" Storyboard.TargetName="VerticalTrackRect" Storyboard.TargetProperty="Opacity" To="0" />
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VerticalThumb" Storyboard.TargetProperty="Width" BeginTime="{StaticResource ScrollBarContractBeginTime}" EnableDependentAnimation="True">
                                                <SplineDoubleKeyFrame KeyTime="{StaticResource ScrollBarContractDuration}" Value="{StaticResource ScrollBarVerticalThumbMinWidth}" KeySpline="0,0,0,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VerticalThumbTransform" Storyboard.TargetProperty="X" BeginTime="{StaticResource ScrollBarContractBeginTime}">
                                                <SplineDoubleKeyFrame KeyTime="{StaticResource ScrollBarContractDuration}" Value="{StaticResource ScrollBarThumbOffset}" KeySpline="0,0,0,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>

                                <VisualState x:Name="Collapsed">
                                    <VisualState.Setters>
                                        <Setter Target="VerticalThumb.Background" Value="{ThemeResource ScrollBarPanningThumbBackground}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Expanded">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource ScrollBarBackgroundPointerOver}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource ScrollBarBorderBrushPointerOver}" />
                                        <Setter Target="VerticalTrackRect.Stroke" Value="{ThemeResource ScrollBarTrackStrokePointerOver}" />
                                        <Setter Target="VerticalTrackRect.Fill" Value="{ThemeResource ScrollBarTrackFillPointerOver}" />
                                        <Setter Target="VerticalThumb.Background" Value="{ThemeResource ScrollBarThumbBackground}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" BeginTime="{StaticResource ScrollBarExpandBeginTime}" Storyboard.TargetName="VerticalSmallIncrease" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" BeginTime="{StaticResource ScrollBarExpandBeginTime}" Storyboard.TargetName="VerticalLargeIncrease" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" BeginTime="{StaticResource ScrollBarExpandBeginTime}" Storyboard.TargetName="VerticalLargeDecrease" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" BeginTime="{StaticResource ScrollBarExpandBeginTime}" Storyboard.TargetName="VerticalSmallDecrease" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="{StaticResource ScrollBarOpacityChangeDuration}" BeginTime="{StaticResource ScrollBarExpandBeginTime}" Storyboard.TargetName="VerticalTrackRect" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VerticalThumb" Storyboard.TargetProperty="Width" BeginTime="{StaticResource ScrollBarExpandBeginTime}" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ScrollBarExpandDuration}" Value="{StaticResource ScrollBarSize}" KeySpline="0,0,0,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VerticalThumbTransform" Storyboard.TargetProperty="X" BeginTime="{StaticResource ScrollBarExpandBeginTime}">
                                            <SplineDoubleKeyFrame KeyTime="{StaticResource ScrollBarExpandDuration}" Value="0" KeySpline="0,0,0,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="ExpandedWithoutAnimation">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource ScrollBarBackgroundPointerOver}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource ScrollBarBorderBrushPointerOver}" />
                                        <Setter Target="VerticalTrackRect.Stroke" Value="{ThemeResource ScrollBarTrackStrokePointerOver}" />
                                        <Setter Target="VerticalTrackRect.Fill" Value="{ThemeResource ScrollBarTrackFillPointerOver}" />
                                        <Setter Target="VerticalThumb.Background" Value="{ThemeResource ScrollBarThumbBackground}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" BeginTime="{StaticResource ScrollBarExpandBeginTime}" Storyboard.TargetName="VerticalSmallIncrease" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="0" BeginTime="{StaticResource ScrollBarExpandBeginTime}" Storyboard.TargetName="VerticalLargeIncrease" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="0" BeginTime="{StaticResource ScrollBarExpandBeginTime}" Storyboard.TargetName="VerticalLargeDecrease" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="0" BeginTime="{StaticResource ScrollBarExpandBeginTime}" Storyboard.TargetName="VerticalSmallDecrease" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="0" BeginTime="{StaticResource ScrollBarExpandBeginTime}" Storyboard.TargetName="VerticalTrackRect" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VerticalThumb" Storyboard.TargetProperty="Width" BeginTime="{StaticResource ScrollBarExpandBeginTime}" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="{StaticResource ScrollBarSize}" KeySpline="0,0,0,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VerticalThumbTransform" Storyboard.TargetProperty="X" BeginTime="{StaticResource ScrollBarExpandBeginTime}">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0" KeySpline="0,0,0,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="CollapsedWithoutAnimation">
                                    <VisualState.Setters>
                                        <Setter Target="VerticalThumb.Background" Value="{ThemeResource ScrollBarPanningThumbBackground}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" BeginTime="{StaticResource ScrollBarContractBeginTime}" Storyboard.TargetName="VerticalSmallIncrease" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="0" BeginTime="{StaticResource ScrollBarContractBeginTime}" Storyboard.TargetName="VerticalLargeIncrease" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="0" BeginTime="{StaticResource ScrollBarContractBeginTime}" Storyboard.TargetName="VerticalLargeDecrease" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="0" BeginTime="{StaticResource ScrollBarContractBeginTime}" Storyboard.TargetName="VerticalSmallDecrease" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="0" BeginTime="{StaticResource ScrollBarContractBeginTime}" Storyboard.TargetName="VerticalTrackRect" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VerticalThumb" Storyboard.TargetProperty="Width" BeginTime="{StaticResource ScrollBarContractBeginTime}" EnableDependentAnimation="True">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="{StaticResource ScrollBarVerticalThumbMinWidth}" KeySpline="0,0,0,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="VerticalThumbTransform" Storyboard.TargetProperty="X" BeginTime="{StaticResource ScrollBarContractBeginTime}">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="{StaticResource ScrollBarThumbOffset}" KeySpline="0,0,0,1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="VerticalRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" IsHitTestVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 这一处是这支样式与框架那一支的**唯一**差别：轨道从「铺满整条 12 像素」收成
                                 中间一条 EgScrollBarTrackWidth（6）。HorizontalAlignment="Center" 是收窄的关键 ——
                                 默认 Stretch 会把 Width 吃掉，写多宽都还是铺满。圆角两处与框架同款（2x 是
                                 「6 像素＝ScrollBarCornerRadius 的 2 倍」，于是这条窄带的端头仍是圆的、不是齐口），
                                 把手（下面那颗 Thumb）一个字没动。 -->
                            <Rectangle
                                x:Name="VerticalTrackRect"
                                HorizontalAlignment="Center"
                                Width="{StaticResource EgScrollBarTrackWidth}"
                                RadiusX="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopLeftCornerRadiusDoubleValueConverter2x}}"
                                RadiusY="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomRightCornerRadiusDoubleValueConverter2x}}"
                                Grid.RowSpan="5"
                                Opacity="0"
                                StrokeThickness="{ThemeResource ScrollBarTrackBorderThemeThickness}"
                                Fill="{ThemeResource ScrollBarTrackFill}"
                                Stroke="{ThemeResource ScrollBarTrackStroke}" />

                            <RepeatButton x:Name="VerticalSmallDecrease" Grid.Row="0" Opacity="0" Height="{StaticResource ScrollBarSize}" MinWidth="{StaticResource ScrollBarSize}" IsTabStop="False" Interval="50" Padding="{ThemeResource ScrollBarVerticalDecreaseMargin}" Template="{StaticResource VerticalDecrementTemplate}" HorizontalAlignment="Center" />
                            <RepeatButton x:Name="VerticalLargeDecrease" Opacity="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="0" IsTabStop="False" Interval="50" Grid.Row="1" AllowFocusOnInteraction="False" Template="{StaticResource RepeatButtonTemplate}" />
                            <Thumb x:Name="VerticalThumb" Opacity="0" Grid.Row="2" Background="{ThemeResource ScrollBarPanningThumbBackground}" BorderBrush="{ThemeResource ScrollBarThumbBorderBrush}" Template="{StaticResource VerticalThumbTemplate}" Width="{ThemeResource ScrollBarVerticalThumbMinWidth}" MinHeight="{StaticResource ScrollBarVerticalThumbMinHeight}" AutomationProperties.AccessibilityView="Raw" RenderTransformOrigin="1,0.5" CornerRadius="{TemplateBinding CornerRadius}">
                                <Thumb.RenderTransform>
                                    <TranslateTransform x:Name="VerticalThumbTransform" X="{StaticResource ScrollBarThumbOffset}" />
                                </Thumb.RenderTransform>
                            </Thumb>
                            <RepeatButton x:Name="VerticalLargeIncrease" Opacity="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="False" Interval="50" Grid.Row="3" AllowFocusOnInteraction="False" Template="{StaticResource RepeatButtonTemplate}" />
                            <RepeatButton x:Name="VerticalSmallIncrease" Grid.Row="4" Opacity="0" Height="{StaticResource ScrollBarSize}" MinWidth="{StaticResource ScrollBarSize}" IsTabStop="False" Interval="50" Padding="{ThemeResource ScrollBarVerticalIncreaseMargin}" Template="{StaticResource VerticalIncrementTemplate}" HorizontalAlignment="Center" />
                        </Grid>

                        <Grid x:Name="VerticalPanningRoot" MinHeight="24" Visibility="Collapsed" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border x:Name="VerticalPanningThumb" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{ThemeResource ScrollBarPanningThumbBackground}" BorderThickness="0" Width="2" MinHeight="32" Margin="2,0,2,0" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
