<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-neutral core: Emby access, mpv launching/IPC, settings, shader groups.
    Deliberately has no WinForms/System.Drawing reference so it stays unit-testable
    from a plain console test host.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EmbyNian.Core</AssemblyName>
    <RootNamespace>EmbyNian</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmbyNian" />
    <InternalsVisibleTo Include="EmbyNian.Tests" />
  </ItemGroup>

</Project>
