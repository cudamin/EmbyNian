<?xml version="1.0" encoding="utf-8"?>
<!--
  Every colour the shell uses, and the overrides that make the stock WinUI controls wear them.

  This replaces Theme/Palette.cs, which was 20 hardcoded Color fields that every OnPaint reached
  into by name. The values are the same — same dark surfaces, same Emby green — but here a control
  never names a colour: it names a role, and the theme dictionary decides. That is what makes a
  light theme and a high-contrast theme possible at all, neither of which the WinForms shell could
  express.

  Merged after XamlControlsResources in App.xaml, so these keys shadow the framework's own.

  这里写下的每个色值现在只画第一帧。真正生效的是 EmbyNian.Core 的 UiThemes 那五套主题，由
  Theme/ThemeHost.cs 在窗口出现之前把它们写进下面这些 SolidColorBrush 对象里 —— 改的是画刷自己的
  Color，不是换字典条目，所以已经绑上去的那几百处会当场跟着变。字面值和默认那套（emby-dark）保持一致，
  只为了「万一 ThemeHost 没跑起来」时界面还是这个样子，而不是一片透明。Light 那一份现在没有哪套主题会
  选到（唯一的浅色 daylight 2026-09-05 删了），但 ThemeHost 照旧往它里面写，理由见 App.xaml 顶上那段。

  三份字典的键是 Dark / Light / HighContrast，没有 Default —— winui-design 那条规矩，见下面第一份自己
  那段说明。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- Dark is the app's real theme: this is a client whose job is to hand a video to mpv,
             usually in a dim room, and poster art reads better against a dark surface.

             The key is 「Dark」 rather than 「Default」 — winui-design's theming rule is 「custom theme
             dictionaries cover Light, Dark and HighContrast explicitly — never Default」, and this file
             has had a full Light and a full HighContrast beside it all along, so the key name was the
             last thing standing between this dictionary and that rule.

             It is not only a name. 「Default」 is the fallback WinUI reaches for when no dictionary matches
             the current theme, so a dark-keyed entry was being found by accident rather than by request;
             a mistyped 「Dark」 elsewhere would have silently landed here and looked correct. Keyed 「Dark」
             it is found because the theme *is* Dark — App.xaml pins Application.RequestedTheme to Dark for
             exactly that reason, and with no Default left, a lookup that matches nothing now falls through
             to the framework's own value instead of quietly borrowing this one. Two application-scope
             readers (DiagnosticsViewModel.Resolve, PlayerPage.BrushFor), ThemeHost's Painted list, and
             the self-check's PaintedDictionaries all name this key; they moved with it. -->
        <ResourceDictionary x:Key="Dark">

            <!-- surfaces -->
            <Color x:Key="EgWindowColor">#FF0C1116</Color>
            <Color x:Key="EgSurfaceColor">#FF141B22</Color>
            <Color x:Key="EgSurfaceAltColor">#FF1C252E</Color>
            <Color x:Key="EgSurfaceElevatedColor">#FF20262D</Color>
            <Color x:Key="EgSurfaceHoverColor">#FF2C343D</Color>
            <Color x:Key="EgBorderColor">#FF303941</Color>
            <Color x:Key="EgBorderStrongColor">#FF49515A</Color>

            <!-- text -->
            <Color x:Key="EgTextColor">#FFF2F6FA</Color>
            <Color x:Key="EgTextDimColor">#FF9FA4A8</Color>
            <Color x:Key="EgTextFaintColor">#FF7A7F83</Color>
            <Color x:Key="EgTextOnAccentColor">#FF0B1714</Color>

            <!-- accents -->
            <!-- Emby's green, so the client looks like it belongs to the server it talks to. -->
            <Color x:Key="EgAccentColor">#FF6EE7C5</Color>
            <Color x:Key="EgAccentHoverColor">#FF82EACD</Color>
            <Color x:Key="EgAccentPressedColor">#FF5FC7A9</Color>
            <Color x:Key="EgAccentSoftColor">#FF1C332F</Color>

            <!-- 半透明的强调色，给侧边栏选中那颗药丸：压在 Mica 上要透得过去。 -->
            <Color x:Key="EgAccentMutedColor">#336EE7C5</Color>

            <Color x:Key="EgDangerColor">#FFE5534B</Color>
            <Color x:Key="EgWarningColor">#FFE3B341</Color>
            <Color x:Key="EgInfoColor">#FF539BF5</Color>

            <!-- Scrim behind dialogs. -->
            <Color x:Key="EgScrimColor">#B40C0E11</Color>

            <SolidColorBrush x:Key="EgWindowBrush" Color="{StaticResource EgWindowColor}" />
            <SolidColorBrush x:Key="EgSurfaceBrush" Color="{StaticResource EgSurfaceColor}" />
            <SolidColorBrush x:Key="EgSurfaceAltBrush" Color="{StaticResource EgSurfaceAltColor}" />
            <SolidColorBrush x:Key="EgSurfaceElevatedBrush" Color="{StaticResource EgSurfaceElevatedColor}" />
            <SolidColorBrush x:Key="EgSurfaceHoverBrush" Color="{StaticResource EgSurfaceHoverColor}" />
            <SolidColorBrush x:Key="EgBorderBrush" Color="{StaticResource EgBorderColor}" />
            <SolidColorBrush x:Key="EgBorderStrongBrush" Color="{StaticResource EgBorderStrongColor}" />
            <SolidColorBrush x:Key="EgTextBrush" Color="{StaticResource EgTextColor}" />
            <SolidColorBrush x:Key="EgTextDimBrush" Color="{StaticResource EgTextDimColor}" />
            <SolidColorBrush x:Key="EgTextFaintBrush" Color="{StaticResource EgTextFaintColor}" />
            <SolidColorBrush x:Key="EgTextOnAccentBrush" Color="{StaticResource EgTextOnAccentColor}" />
            <SolidColorBrush x:Key="EgAccentBrush" Color="{StaticResource EgAccentColor}" />
            <SolidColorBrush x:Key="EgAccentHoverBrush" Color="{StaticResource EgAccentHoverColor}" />
            <SolidColorBrush x:Key="EgAccentPressedBrush" Color="{StaticResource EgAccentPressedColor}" />
            <SolidColorBrush x:Key="EgAccentSoftBrush" Color="{StaticResource EgAccentSoftColor}" />
            <SolidColorBrush x:Key="EgAccentMutedBrush" Color="{StaticResource EgAccentMutedColor}" />
            <SolidColorBrush x:Key="EgDangerBrush" Color="{StaticResource EgDangerColor}" />
            <SolidColorBrush x:Key="EgWarningBrush" Color="{StaticResource EgWarningColor}" />
            <SolidColorBrush x:Key="EgInfoBrush" Color="{StaticResource EgInfoColor}" />
            <SolidColorBrush x:Key="EgScrimBrush" Color="{StaticResource EgScrimColor}" />

            <!-- 详情页正文那几块玻璃 —— 「把下面的板块也坐上亚克力效果」。
                 唯一一支不是 SolidColorBrush 的角色：亚克力要的就是「透出背后那张图，但透得看不清」，而它
                 背后那张图是固定在页面背景里的剧照（见 DetailPage 的 Backdrop 那一层），正文从它上面滑过去。
                 WinUI 3 只有应用内亚克力（采样的是同一棵树里画在它后面的东西），而这里要的正是这一种。
                 两个 Opacity 一高一低分工：Tint 那个是这层色本身的浓度，Luminosity 那个管背后的明暗透上来
                 多少；透上来的份量约等于 (1-Luminosity)×(1-Tint)。原来那对 0.85/0.55 只剩不到一成，一块玻璃
                 和一块实心板在屏上看不出差别 —— 而「板块也坐上亚克力」要的就是看得出底下压着一张图，所以
                 Luminosity 松到 0.62，透上来的份量翻到一成八。再松就该担心字了：最亮的一格天空能把玻璃抬到
                 #35 上下，简介那档暗字（EgTextDimBrush）压在上面还剩 4.8:1，而正文的底线是 4.5:1。
                 「看得到背景图」这件事不指望这块玻璃透多少 —— 那件事由板块之间的缝和最后一块底下那条空带
                 保证（见 DetailPage 正文那一叠），一张全黑的剧照也不会让缝合上。
                 FallbackColor 是关掉透明效果（省电模式、远程桌面）时的样子：一整块不透明的窗口底色，正文照旧
                 读得出，只是背后那张图不再透上来 —— 那时候缝里露的也是这块底色。 -->
            <AcrylicBrush
                x:Key="EgFrostBrush"
                FallbackColor="{StaticResource EgWindowColor}"
                TintColor="{StaticResource EgWindowColor}"
                TintLuminosityOpacity="0.62"
                TintOpacity="0.55" />

            <!-- 悬停/按下时压上去的那一层。深色主题下是透明的白、浅色主题下是透明的黑 —— 跟
                 HostWindow.PaintCaption 给系统那三颗窗口按钮设的是同一组数字（0x23/0x37 与 0x19/0x2D），
                 所以标题栏两头的按钮摸起来是一样的。不透明的底色在这里不行：标题栏那一条要透出 Mica。 -->
            <SolidColorBrush x:Key="EgOverlayHoverBrush" Color="#23FFFFFF" />
            <SolidColorBrush x:Key="EgOverlayPressedBrush" Color="#37FFFFFF" />

            <!-- what the framework's own controls read -->
            <!-- The accent brushes are what a Button, ToggleSwitch, Slider, RatingControl and
                 NavigationView selection indicator actually paint with. Overriding SystemAccentColor
                 alone is not enough: the framework resolves these with StaticResource while parsing
                 its own dictionary, long before ours is merged, so each derived brush has to be
                 replaced by key. -->
            <Color x:Key="SystemAccentColor">#FF6EE7C5</Color>
            <Color x:Key="SystemAccentColorLight1">#FF82EACD</Color>
            <Color x:Key="SystemAccentColorLight2">#FF97EED5</Color>
            <Color x:Key="SystemAccentColorLight3">#FFABF1DD</Color>
            <Color x:Key="SystemAccentColorDark1">#FF5FC7A9</Color>
            <Color x:Key="SystemAccentColorDark2">#FF4FA68E</Color>
            <Color x:Key="SystemAccentColorDark3">#FF408672</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource EgAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E86EE7C5" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C46EE7C5" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF2D544F" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource EgAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource EgAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource EgAccentColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource EgTextOnAccentColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B40B1714" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource EgTextOnAccentColor}" />

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource EgTextColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource EgTextDimColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource EgTextFaintColor}" />

            <!-- Mica shows through the layer brushes, which is the whole point of using them for the
                 nav pane and the page surface instead of a flat fill. -->
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF0C1116" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF141B22" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF1C252E" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF20262D" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource EgBorderColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource EgBorderColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource EgBorderStrongColor}" />

            <!-- 对话框、飞出菜单、TeachingTip 的底。框架自己那三档是中性灰，主题换了色相之后它们会是画面上
                 唯一没跟着走的一块，所以也接到我们的面上来。 -->
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource EgWindowColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource EgSurfaceColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource EgSurfaceAltColor}" />
        </ResourceDictionary>

        <!-- Not the app's normal theme, but the framework demands a Light dictionary and a user who
             turns the system light should not get unreadable text. Same roles, inverted surfaces. -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="EgWindowColor">#FFF1F3F6</Color>
            <Color x:Key="EgSurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="EgSurfaceAltColor">#FFE8EBEF</Color>
            <Color x:Key="EgSurfaceElevatedColor">#FFF2F2F2</Color>
            <Color x:Key="EgSurfaceHoverColor">#FFD8DBDE</Color>
            <Color x:Key="EgBorderColor">#FFD3D6D9</Color>
            <Color x:Key="EgBorderStrongColor">#FFBABCBF</Color>

            <Color x:Key="EgTextColor">#FF15181D</Color>
            <Color x:Key="EgTextDimColor">#FF64676B</Color>
            <Color x:Key="EgTextFaintColor">#FF878A8E</Color>
            <Color x:Key="EgTextOnAccentColor">#FFF2F7F3</Color>

            <!-- 比深色那套的绿暗一档：白字压在 #52B54B 上只有 2.6:1，压在这个上是 4.7:1。 -->
            <Color x:Key="EgAccentColor">#FF2E7D32</Color>
            <Color x:Key="EgAccentHoverColor">#FF286C2B</Color>
            <Color x:Key="EgAccentPressedColor">#FF215A24</Color>
            <Color x:Key="EgAccentSoftColor">#FFDAE5DE</Color>
            <Color x:Key="EgAccentMutedColor">#2B2E7D32</Color>

            <Color x:Key="EgDangerColor">#FFC0332B</Color>
            <Color x:Key="EgWarningColor">#FF8A6100</Color>
            <Color x:Key="EgInfoColor">#FF1F6FD0</Color>
            <Color x:Key="EgScrimColor">#8C0C0E11</Color>

            <SolidColorBrush x:Key="EgWindowBrush" Color="{StaticResource EgWindowColor}" />
            <SolidColorBrush x:Key="EgSurfaceBrush" Color="{StaticResource EgSurfaceColor}" />
            <SolidColorBrush x:Key="EgSurfaceAltBrush" Color="{StaticResource EgSurfaceAltColor}" />
            <SolidColorBrush x:Key="EgSurfaceElevatedBrush" Color="{StaticResource EgSurfaceElevatedColor}" />
            <SolidColorBrush x:Key="EgSurfaceHoverBrush" Color="{StaticResource EgSurfaceHoverColor}" />
            <SolidColorBrush x:Key="EgBorderBrush" Color="{StaticResource EgBorderColor}" />
            <SolidColorBrush x:Key="EgBorderStrongBrush" Color="{StaticResource EgBorderStrongColor}" />
            <SolidColorBrush x:Key="EgTextBrush" Color="{StaticResource EgTextColor}" />
            <SolidColorBrush x:Key="EgTextDimBrush" Color="{StaticResource EgTextDimColor}" />
            <SolidColorBrush x:Key="EgTextFaintBrush" Color="{StaticResource EgTextFaintColor}" />
            <SolidColorBrush x:Key="EgTextOnAccentBrush" Color="{StaticResource EgTextOnAccentColor}" />
            <SolidColorBrush x:Key="EgAccentBrush" Color="{StaticResource EgAccentColor}" />
            <SolidColorBrush x:Key="EgAccentHoverBrush" Color="{StaticResource EgAccentHoverColor}" />
            <SolidColorBrush x:Key="EgAccentPressedBrush" Color="{StaticResource EgAccentPressedColor}" />
            <SolidColorBrush x:Key="EgAccentSoftBrush" Color="{StaticResource EgAccentSoftColor}" />
            <SolidColorBrush x:Key="EgAccentMutedBrush" Color="{StaticResource EgAccentMutedColor}" />
            <SolidColorBrush x:Key="EgDangerBrush" Color="{StaticResource EgDangerColor}" />
            <SolidColorBrush x:Key="EgWarningBrush" Color="{StaticResource EgWarningColor}" />
            <SolidColorBrush x:Key="EgInfoBrush" Color="{StaticResource EgInfoColor}" />
            <SolidColorBrush x:Key="EgScrimBrush" Color="{StaticResource EgScrimColor}" />

            <!-- 同上，浓一档，而且这一档不跟着 Default 那份松：这一边的字是深色的，背后透上来的剧照是亮的，
                 一成半的画面就够把 #64676B 那档说明字吃掉 —— 深色那边是亮画面把玻璃抬高、暗字更难读，浅色
                 这边是暗画面把玻璃压低、深字更难读，两头都顶着同一条 4.5:1。浅色主题上「看得到背景图」全靠
                 板块之间的缝，不靠玻璃自己透。见 Default 那份里这一支的说明。 -->
            <AcrylicBrush
                x:Key="EgFrostBrush"
                FallbackColor="{StaticResource EgWindowColor}"
                TintColor="{StaticResource EgWindowColor}"
                TintLuminosityOpacity="0.9"
                TintOpacity="0.62" />

            <!-- 白的叠加在一片白上等于什么都没发生 —— 这一对在浅色这边翻成透明的黑。 -->
            <SolidColorBrush x:Key="EgOverlayHoverBrush" Color="#19000000" />
            <SolidColorBrush x:Key="EgOverlayPressedBrush" Color="#2D000000" />

            <Color x:Key="SystemAccentColor">#FF2E7D32</Color>
            <Color x:Key="SystemAccentColorLight1">#FF479045</Color>
            <Color x:Key="SystemAccentColorLight2">#FF60A45C</Color>
            <Color x:Key="SystemAccentColorLight3">#FF80B87D</Color>
            <Color x:Key="SystemAccentColorDark1">#FF286C2B</Color>
            <Color x:Key="SystemAccentColorDark2">#FF215A24</Color>
            <Color x:Key="SystemAccentColorDark3">#FF1B481D</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource EgAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E82E7D32" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C42E7D32" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FFC9DCCA" />

            <!-- The same roles the Default dictionary maps, mapped again here rather than left to fall
                 back to it. A key this dictionary omits resolves from Default, and Default's greens are
                 picked to sit on a near-black surface: as accent *text* on white, #FF6EE7C5 lands around
                 2.4:1, which is the unreadable text this dictionary exists to prevent. -->
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource EgAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource EgAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource EgAccentColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource EgTextOnAccentColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B4FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource EgTextOnAccentColor}" />

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource EgTextColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource EgTextDimColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource EgTextFaintColor}" />

            <!-- No Mica to show through on this side: the layer brushes are opaque so light-mode text
                 keeps its contrast whether or not the backdrop came up. -->
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FFE8EBEF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFF1F3F6" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource EgBorderColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource EgBorderColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource EgBorderStrongColor}" />

            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource EgWindowColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource EgSurfaceColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource EgSurfaceAltColor}" />
        </ResourceDictionary>

        <!-- High contrast takes the system's own colours; overriding them here would be exactly the
             wrong thing to do. Only the app's role names are mapped, onto system brushes. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EgWindowBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EgSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EgSurfaceAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EgSurfaceElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EgSurfaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EgBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EgBorderStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EgTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EgTextDimBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EgTextFaintBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="EgTextOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EgAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EgAccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EgAccentPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EgAccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EgAccentMutedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EgDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EgWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EgInfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EgScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <!-- 高对比度下不上亚克力：那一档的整个意思是「别让任何东西半透明」。换成系统的窗口底色，
                 正文那张纸于是是实心的，背后那张剧照被它整块盖住 —— 这正是该有的样子。 -->
            <SolidColorBrush x:Key="EgFrostBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EgOverlayHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EgOverlayPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 与主题无关的颜色 —— 只有这三个。字号、字体、圆角那一整段搬到 Theme/Styles.xaml 去了：
         判据是「换主题会不会动它」，颜色会，字号和圆角不会。 -->

    <!-- 详情页头图上的文字。头图永远是一张压了深色遮罩的剧照，所以这两个刷子故意不进
         ThemeDictionaries：跟着主题走的话，浅色主题下就是深色字压在深色遮罩上。 -->
    <SolidColorBrush x:Key="EgOnScrimBrush" Color="#FFF3F5F8" />
    <SolidColorBrush x:Key="EgOnScrimDimBrush" Color="#FFC9D0D9" />

    <!-- 主页第一屏那条大图的底（HomeBanner 的 Band）。剧照 2026-09-11 起铺满整条带（「去掉首页封面轮播图的黑边」，
         UniformToFill），所以这个底色只在图还没解码到的那一瞬、还有整条带收起来之前的那一帧看得见 —— 从前它还是
         「剧照只占六成宽、左右那两片就是这个颜色」的那两片，也就是他要去掉的那两条黑边。用它的只剩这一条带。
         和上面那两支同一个理由不跟主题走：带上的字走的是 EgOnScrim 那套浅墨，底色跟着主题变成近白的话就是白底
         白字。 -->
    <SolidColorBrush x:Key="EgBannerBaseBrush" Color="#FF0C0E11" />
</ResourceDictionary>
