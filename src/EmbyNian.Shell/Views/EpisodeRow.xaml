<?xml version="1.0" encoding="utf-8"?>
<!--
  列表视图的一行（纵向），参考 Emby Theater 的 detailsListItem：左边一张 16:9 大图，右边编号标题、
  「日期 · 时长」信息行和两行截断的简介。媒体库的列表模式用它，详情页的 单集 也用它
  （「把季页中的集改回成列表显示」）。

  行主体（点击打开、右键菜单）不在这个控件里：和网格卡片一样，外层模板拿一个容器包着本控件 ——
  媒体库用 ItemContainer，由 ItemsView 的 ItemInvoked 报出打开；详情页用 Button，Click 就是打开。
  两边都把右键菜单挂在本控件上，行和卡片在页面眼里是同一种东西。

  图片上的元素沿用 PosterCard 的语义：占位 glyph 垫在图后、右上已看角标、贴底进度条、悬浮时中央
  播放键。悬浮只出播放键：Emby 的列表行也只有这一个，已看/收藏/更多在右键菜单里。

  尺寸跟卡片同一条规则：宽来自 CardItem.CardWidth（CardSize 固定的那一档），高等于宽的 9/16
  （CardSize.HeightFor），解码宽度和绘制宽度不会对不上。
-->
<UserControl
    x:Class="EmbyNian.Shell.Views.EpisodeRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 中央播放键，比 PosterCard 的 48 略小：列表行的图没有卡片那么大。BasedOn 是必须的，
             同 PosterCard 里那一条的注解。 -->
        <Style x:Key="EgRowPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 行标题的两种写法，只差一个前景色：正在看的那一集用 accent 色，其余用正文色。写成两个
             键控 Style 让代码去换挂，而不是代码里取画刷 —— EgAccentBrush 定义在 Palette.xaml 的
             ThemeDictionaries 里，用 Resources[key] 取会抛，只有 XAML 解析器认得它。
             基座是词表里的正文样式，字号和字体因此不在这儿重写一遍。 -->
        <Style x:Key="EgRowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource EgBodyStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="EgRowTitleCurrentStyle" TargetType="TextBlock" BasedOn="{StaticResource EgRowTitleStyle}">
            <Setter Property="Foreground" Value="{ThemeResource EgAccentBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- Background 是 Transparent 才命中测试得到，同 PosterCard 的根。文字列跟着行一起被外层
         Button 盖住，所以整行（包括右侧文字区）都是点击目标，和 Emby 的 listItem 一致。 -->
    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">

        <Grid.ColumnDefinitions>
            <!-- 三列，和下面三个 Grid.Column 对得上：左缘竖条、16:9 大图、文字。第二列曾经漏掉过，而
                 WinUI 会把越界的 Grid.Column 夹到最后一列上 —— 于是文字和图片挤在同一列里互相压着，
                 简介从大图底下穿过去。列数写少一个不报错，所以只有看一眼画面才会发现。

                 第一列写死 10 而不是 Auto：竖条只出现在正在看的那一行，Auto 会让那一行的图比别的行
                 往右挪三个像素，整列就对不齐了。宽度留着，画不画由竖条自己的显隐决定。 -->
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 「你在这里」：这一集正是当前打开的那一页。剧集页会把自己所在的整季都列出来，所以列表里
             一定有一行是自己，没有标记的话得拿标题跟页顶比对才知道读到哪了。 -->
        <Border
            Background="{ThemeResource EgAccentBrush}"
            CornerRadius="2"
            HorizontalAlignment="Left"
            Margin="0,3"
            Visibility="{x:Bind Card.CurrentVisibility, Mode=OneWay}"
            Width="3" />

        <!-- 胶片格，和海报卡片同一个样式键 —— 发丝框、圆角、底色都在 EgFrameStyle 上，一个局部值都不写；
             指针或焦点上来时整圈换强调色，代码里换 Style（见 EpisodeRow.xaml.cs 的 Paint）。 -->
        <Border
            x:Name="Art"
            Grid.Column="1"
            Height="{x:Bind Card.PosterHeight, Mode=OneWay}"
            Style="{StaticResource EgFrameStyle}"
            Width="{x:Bind Card.CardWidth, Mode=OneWay}">
            <Grid>
                <FontIcon
                    FontSize="26"
                    Foreground="{ThemeResource EgTextFaintBrush}"
                    Glyph="{x:Bind Card.Glyph, Mode=OneWay}" />

                <Image
                    Source="{x:Bind Card.Poster, Mode=OneWay}"
                    Stretch="UniformToFill" />

                <!-- 全看完那颗方块，与 PosterCard 同一处右上角、同一个样式键。 -->
                <Border
                    Style="{StaticResource EgCornerBadgeStyle}"
                    Visibility="{x:Bind Card.WatchedBadgeVisibility, Mode=OneWay}">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource EgTextOnAccentBrush}"
                        Glyph="&#xE73E;" />
                </Border>

                <!-- 看到一半：压在下边框线上那条 2px，长度就是进度。两列一个 Border，与 PosterCard 同款 ——
                     换掉 ProgressBar 的三个理由写在那边。 -->
                <Grid
                    Height="{StaticResource EgProgressThickness}"
                    VerticalAlignment="Bottom"
                    Visibility="{x:Bind Card.ProgressVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind Card.ProgressDone, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind Card.ProgressLeft, Mode=OneWay}" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource EgAccentBrush}" />
                </Grid>

                <!-- 悬浮层只有播放键，显隐直接切换（「不要淡入淡出了」）。这层不画底色：没有底色的
                     Grid 不接指针事件，卡片自己的悬浮跟踪不会被它截走。 -->
                <Grid x:Name="Hover" Visibility="Collapsed">
                    <Button
                        Click="OnPlayClicked"
                        HorizontalAlignment="Center"
                        Style="{StaticResource EgRowPlayButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind Card.PlayActionTip, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind Card.PlayVisibility, Mode=OneWay}">
                        <FontIcon FontSize="18" Glyph="&#xE768;" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- 行文字：垂直居中，跟图的视觉重心对齐。简介两行截断，Emby 的 listItem-overview 同款。 -->
        <StackPanel
            Grid.Column="2"
            Margin="14,0,12,0"
            MinWidth="0"
            Spacing="4"
            VerticalAlignment="Center">
            <TextBlock
                x:Name="RowTitle"
                Style="{StaticResource EgRowTitleStyle}"
                Text="{x:Bind Card.RowTitle, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Card.RowTitle, Mode=OneWay}" />

            <TextBlock
                MaxLines="1"
                Style="{StaticResource EgDataStyle}"
                Text="{x:Bind Card.RowInfo, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind Card.RowInfoVisibility, Mode=OneWay}" />

            <!-- 简介是句子，不是读数，所以它留在正文那支字上 —— 上面那行「日期 · 时长」才走等宽。 -->
            <TextBlock
                LineHeight="19"
                MaxLines="2"
                Style="{StaticResource EgCaptionStyle}"
                Text="{x:Bind Card.RowOverview, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Visibility="{x:Bind Card.RowOverviewVisibility, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
