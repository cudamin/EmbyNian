<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="EmbyNian.Shell.Views.MoviePilotReorganizeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:moviepilot="using:EmbyNian.MoviePilot"
    DefaultButton="None"
    PrimaryButtonClick="OnPrimarySubmit"
    SecondaryButtonClick="OnSecondarySubmit">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
    </ContentDialog.Resources>
    <Grid MinWidth="320" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <InfoBar x:Name="Problem" IsClosable="False" IsOpen="False" Severity="Error" />
        <ScrollViewer x:Name="FormScroll" Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="600">
            <StackPanel Padding="0,0,12,0" Spacing="12">
                <ContentControl x:Name="FormPanel" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource EgSubheadStyle}" Text="1. 找到原整理记录" />
                    <TextBlock Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}"
                        Text="先核对 MoviePilot 原记录，再修改识别信息。不会把 Emby 中的软链接当成新的下载文件。" TextWrapping="Wrap" />
                    <TextBox x:Name="SourcePathBox" Header="Emby 当前文件" IsReadOnly="True" TextWrapping="Wrap" />
                    <AutoSuggestBox x:Name="HistoryQuery" Header="查找整理历史" PlaceholderText="输入原片名或文件名"
                        QueryIcon="Find" QuerySubmitted="OnHistoryQuery" />
                    <ComboBox x:Name="HistoryBox" Header="原整理记录" HorizontalAlignment="Stretch"
                        DisplayMemberPath="Display" SelectionChanged="OnHistoryChanged" />
                    <TextBlock x:Name="HistorySummary" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                    <TextBox x:Name="OriginalSourceBox" Header="本次真正使用的源文件" IsReadOnly="True" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource EgSubheadStyle}" Text="2. 设置正确的媒体与季集" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="TypeBox" Header="类型" HorizontalAlignment="Stretch" SelectionChanged="OnTypeChanged">
                            <ComboBoxItem Content="电影" Tag="电影" /><ComboBoxItem Content="电视剧" Tag="电视剧" />
                        </ComboBox>
                        <ComboBox x:Name="SourceBox" Grid.Column="1" Header="数据源" HorizontalAlignment="Stretch"
                            DisplayMemberPath="Name" SelectionChanged="OnSelectionEdited" />
                    </Grid>
                    <AutoSuggestBox x:Name="MediaIdBox" Header="媒体编号" PlaceholderText="编号，或输入片名查找"
                        QueryIcon="Find" TextChanged="OnMediaIdChanged" QuerySubmitted="OnMediaIdQuery" SuggestionChosen="OnSuggestionChosen" />
                    <Grid x:Name="EpisodeRow" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="SeasonBox" Header="季号（特别篇为 0）" TextChanged="OnEdited" />
                        <TextBox x:Name="EpisodeBox" Grid.Column="1" Header="指定集数（如 24）" TextChanged="OnEdited" />
                    </Grid>
                    <TextBlock Style="{StaticResource EgSubheadStyle}" Text="3. 核对整理目录" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="TargetStorageBox" Header="目的存储" HorizontalAlignment="Stretch" DisplayMemberPath="Name"
                            SelectionChanged="OnSelectionEdited" />
                        <ComboBox x:Name="TransferTypeBox" Grid.Column="1" Header="整理方式" HorizontalAlignment="Stretch"
                            SelectionChanged="OnSelectionEdited">
                            <ComboBoxItem Content="按目的目录配置" Tag="" /><ComboBoxItem Content="复制" Tag="copy" />
                            <ComboBoxItem Content="移动（移走源文件）" Tag="move" /><ComboBoxItem Content="硬链接" Tag="link" /><ComboBoxItem Content="软链接" Tag="softlink" />
                        </ComboBox>
                    </Grid>
                    <ComboBox x:Name="TargetPathBox" Header="目的路径" HorizontalAlignment="Stretch" IsEditable="True"
                        SelectionChanged="OnDirectoryChanged" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <CheckBox x:Name="TypeFolderToggle" Content="按类型建子目录" Checked="OnEdited" Unchecked="OnEdited" />
                        <CheckBox x:Name="CategoryFolderToggle" Grid.Column="1" Content="按类别建子目录" Checked="OnEdited" Unchecked="OnEdited" />
                    </Grid>
                    <Expander x:Name="AdvancedOptions" Header="更多整理选项" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="PartBox" Header="指定 Part（可选）" TextChanged="OnEdited" />
                                <TextBox x:Name="MinSizeBox" Grid.Column="1" Header="最小文件大小（MB）" Text="0" TextChanged="OnEdited" />
                            </Grid>
                            <CheckBox x:Name="ScrapeToggle" Content="整理后刮削元数据" Checked="OnEdited" Unchecked="OnEdited" />
                            <CheckBox x:Name="FromHistoryToggle" Content="复用旧识别（修改季集时不可开启）" Checked="OnEdited" Unchecked="OnEdited" />
                            <TextBlock Style="{StaticResource EgCaptionStyle}" Text="本入口按原记录重新整理，会清理匹配到的旧目标和成功历史；提交前会再次列出影响。" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ContentControl>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="PreviewButton" Click="OnPreview" Content="预览重新整理" Style="{StaticResource EgSecondaryButtonStyle}" />
                    <ProgressRing x:Name="PreviewRing" Grid.Column="1" Width="24" Height="24" IsActive="False" />
                    <TextBlock x:Name="PreviewSummary" Grid.Column="2" Style="{StaticResource EgCaptionStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
                <ItemsControl x:Name="PreviewList" ItemsSource="{x:Bind Lines}" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="moviepilot:MoviePilotTransferLine">
                            <StackPanel Spacing="4" Padding="10" Margin="0,0,0,8" Background="{ThemeResource EgSurfaceAltBrush}">
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="{x:Bind Source}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Style="{StaticResource EgBodyStyle}" Text="{x:Bind Headline}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Text="{x:Bind StatusLine}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="ConfirmationPanel" Visibility="Collapsed" Padding="12" Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="{StaticResource EgCardCornerRadius}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ConfirmationText" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                        <CheckBox x:Name="ConfirmChanges" Content="我已核对源文件、目标路径和旧记录的影响" Checked="OnConfirmed" Unchecked="OnConfirmed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
