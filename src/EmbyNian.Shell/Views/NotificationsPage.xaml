<?xml version="1.0" encoding="utf-8"?>
<!--
  The notifications page (设置 → 通知，2026-09-25): the Emby server's own per-user notification entries,
  listed, added, edited, deleted and test-fired from here. This is the in-app replica of the official web
  app's /settings/notifications.html — same four endpoints, same semantics; the entry data lives on the
  server, never in settings.json.

  Layout follows ServersPage on purpose: heading + command bar, one indeterminate bar, one notice bar, an
  empty state, then the list. Every binding is x:Bind for the same reason as there — compiled against a
  named type, so a renamed property fails the build instead of silently drawing nothing.
-->
<Page
    x:Class="EmbyNian.Shell.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EmbyNian.Shell.Views"
    xmlns:vm="using:EmbyNian.Shell.ViewModels"
    Background="{ThemeResource EgWindowBrush}">

    <Page.Resources>
        <DataTemplate x:Key="EntryTemplate" x:DataType="vm:NotificationRow">
            <Border
                Background="{ThemeResource EgSurfaceBrush}"
                BorderBrush="{ThemeResource EgBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource EgCardCornerRadius}"
                Margin="0,0,0,12"
                Padding="20,16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource EgSubheadFontSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{x:Bind DisplayName}" />
                        <TextBlock
                            FontSize="{StaticResource EgCaptionFontSize}"
                            Foreground="{ThemeResource EgTextDimBrush}"
                            Text="{x:Bind ServiceName}" />
                        <TextBlock
                            FontSize="{StaticResource EgCaptionFontSize}"
                            Foreground="{ThemeResource EgTextFaintBrush}"
                            Text="{x:Bind EventsSummary}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Uid="NotificationsPage_ButtonA1"
                            Style="{StaticResource EgIconButtonStyle}"
                            Command="{x:Bind Owner.TestCommand}"
                            CommandParameter="{x:Bind}">
                            <FontIcon Glyph="&#xE724;" />
                        </Button>
                        <Button x:Uid="NotificationsPage_ButtonA2"
                            Style="{StaticResource EgIconButtonStyle}"
                            Command="{x:Bind Owner.EditCommand}"
                            CommandParameter="{x:Bind}">
                            <FontIcon Glyph="&#xE70F;" />
                        </Button>
                        <Button x:Uid="NotificationsPage_ButtonA3"
                            Style="{StaticResource EgIconButtonStyle}"
                            Command="{x:Bind Owner.DeleteCommand}"
                            CommandParameter="{x:Bind}">
                            <FontIcon Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageLayout" Margin="{StaticResource EgPageMargin}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16" RowSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Width="48" Height="48" CornerRadius="16" Background="{ThemeResource EgAccentSoftBrush}">
                <FontIcon Glyph="&#xE7E7;" Foreground="{ThemeResource EgAccentBrush}" FontSize="24" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Uid="NotificationsPage_Heading" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.Subheading, Mode=OneWay}" Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <CommandBar Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                DefaultLabelPosition="Right" Background="{ThemeResource EgSurfaceBrush}"
                CornerRadius="12" IsOpen="False">
                <AppBarButton x:Uid="NotificationsPage_AddAction" AutomationProperties.AutomationId="NotificationsAddButton"
                    Icon="Add" Command="{x:Bind ViewModel.AddNotificationCommand}" />
                <AppBarButton x:Uid="NotificationsPage_RefreshAction" AutomationProperties.AutomationId="NotificationsRefreshButton"
                    Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
            </CommandBar>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <!-- TwoWay on IsOpen, so dismissing the bar is recorded rather than only drawn. -->
            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" />
        </StackPanel>

        <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--
                  通知接管（这一格做的事：进度到阈值补报播放停止。用户令 2026-09-29：「在设置的通知中新增功能，
                  播放进度达到自定义百分比的时候，自动触发发送 播放-停止」，同日续令「发送通知的判断标准改为播放
                  行为中的 标记已观看阈值(%), 要区分国漫」；2026-09-30 用户令改名「进度到阈值补报播放停止 改名为
                  通知接管」）。这一格与下面那份列表不是一回事：列表是服务器上的通知条目，这一格是客户端自己的
                  行为 —— 进度够到「播放行为」里的标记已看阈值（国漫走国漫那一档）就替服务器补报一趟「播放停止」，
                  好让服务器上那条通知（本机是 Webhooks → MoviePilot）早点转发出去。所以它落在 settings.json，
                  一个字节都不上服务器，阈值也不在这一页 —— 它读的就是「播放行为」里那两行。
                -->
                <Border Background="{ThemeResource EgSurfaceBrush}" BorderBrush="{ThemeResource EgBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource EgCardCornerRadius}" Padding="20,16" Margin="0,0,0,12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Uid="NotificationsPage_StopReportHeading"
                                FontSize="{StaticResource EgSubheadFontSize}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <!-- 说明那行跟「隐藏功能下方说明」（设置 → 界面）走：开着就收起来，只留标题与开关。
                                 这张卡片是手写的，不经过设置行的模板，所以这一条得自己绑（2026-09-30 用户报它没跟上）。 -->
                            <TextBlock x:Name="StopReportNote" x:Uid="NotificationsPage_StopReportNote"
                                FontSize="{StaticResource EgCaptionFontSize}"
                                Foreground="{ThemeResource EgTextDimBrush}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.NoteVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StopReportToggle" x:Uid="NotificationsPage_StopReportToggle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="NotificationsStopReportToggle"
                            IsOn="{x:Bind ViewModel.StopReportEnabled, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Background="{ThemeResource EgSurfaceBrush}" BorderBrush="{ThemeResource EgBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource EgCardCornerRadius}" Padding="32"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" Spacing="16" MaxWidth="420">
                        <FontIcon Glyph="&#xE7E7;" FontSize="40" Foreground="{ThemeResource EgAccentBrush}" />
                        <TextBlock x:Uid="NotificationsPage_EmptyHeading" FontSize="{StaticResource EgTitleFontSize}" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock x:Uid="NotificationsPage_TextBlock8" Foreground="{ThemeResource EgTextDimBrush}"
                            TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 点条目打开编辑器 —— 官方网页端的列表就是这个语义；三颗按钮只做单件事。 -->
                <ListView
                    AutomationProperties.AutomationId="NotificationsEntryList"
                    IsItemClickEnabled="True"
                    ItemClick="OnEntryPicked"
                    ItemTemplate="{StaticResource EntryTemplate}"
                    ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                    SelectionMode="None" />
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
