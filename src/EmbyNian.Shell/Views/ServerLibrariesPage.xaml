<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EmbyNian.Shell.Views.ServerLibrariesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmbyNian.Shell.ViewModels"
    xmlns:emby="using:EmbyNian.Emby"
    Background="{ThemeResource EgWindowBrush}">
    <Page.Resources>
        <Style x:Key="LibrarySection" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource EgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <DataTemplate x:Key="LibraryChoiceTemplate" x:DataType="emby:LibraryChoice">
            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
        </DataTemplate>
        <DataTemplate x:Key="LibraryFieldTemplate" x:DataType="vm:LibraryFieldRow">
            <StackPanel Spacing="5" Margin="0,8" Visibility="{x:Bind Visibility, Mode=OneWay}">
                <ToggleSwitch x:Name="LibraryOptionToggle" IsOn="{x:Bind Checked, Mode=TwoWay}" Visibility="{x:Bind ToggleVisibility}"
                    AutomationProperties.Name="{x:Bind Label}" OnContent="开启" OffContent="关闭">
                    <ToggleSwitch.Header><TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" Style="{StaticResource EgBodyStyle}" /></ToggleSwitch.Header>
                </ToggleSwitch>
                <NumberBox x:Name="LibraryOptionNumber" Header="{x:Bind Label}" Value="{x:Bind Number, Mode=TwoWay}"
                    Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}" SpinButtonPlacementMode="Compact"
                    Visibility="{x:Bind NumberVisibility}" AutomationProperties.Name="{x:Bind Label}" />
                <TextBox x:Name="LibraryOptionText" Header="{x:Bind Label}" Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind TextVisibility}" AutomationProperties.Name="{x:Bind Label}" />
                <ComboBox x:Name="LibraryOptionChoice" Header="{x:Bind Label}" ItemsSource="{x:Bind Choices}" ItemTemplate="{StaticResource LibraryChoiceTemplate}"
                    SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ChoiceVisibility}" AutomationProperties.Name="{x:Bind Label}" />
                <StackPanel Spacing="6" Visibility="{x:Bind LanguagesVisibility}">
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource EgBodyStyle}" />
                    <Button x:Name="LibraryLanguagePicker" Tag="{x:Bind}" Click="OnLanguages" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="{x:Bind Label}">
                        <TextBlock Text="{x:Bind LanguageSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" Style="{StaticResource EgCaptionStyle}" Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Error, Mode=OneWay}" Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource EgCaptionStyle}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LibrarySectionTemplate" x:DataType="vm:LibraryFieldSection">
            <Border Style="{StaticResource LibrarySection}" Margin="0,0,0,14" Visibility="{x:Bind Visibility, Mode=OneWay}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgSectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <ItemsControl ItemsSource="{x:Bind Fields}" ItemTemplate="{StaticResource LibraryFieldTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid>
    <Grid x:Name="PageLayout" RowSpacing="12" Padding="0,0,4,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}" IsClosable="False" Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
        </StackPanel>
        <NavigationView x:Name="LibraryTabs" Grid.Row="1" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False" AlwaysShowHeader="False" SelectionChanged="OnTabChanged"
            Visibility="{x:Bind ViewModel.TabsVisibility, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanUse, Mode=OneWay}">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="LibraryListTab" Content="媒体库" Tag="library" IsSelected="True" />
                <NavigationViewItem x:Name="LibraryAdvancedTab" Content="高级" Tag="advanced" />
            </NavigationView.MenuItems>
        </NavigationView>
        <Grid Grid.Row="2" RowSpacing="16" Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="媒体库" Style="{StaticResource EgSectionTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource EgCaptionStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="LibraryCreateButton" Content="新建媒体库" Command="{x:Bind ViewModel.NewLibraryCommand}" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="LibraryScanAllButton" Content="{x:Bind ViewModel.ScanText, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleScanCommand}" />
                    <Button x:Name="LibraryRefreshButton" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.CanRefreshList, Mode=OneWay}"
                        ToolTipService.ToolTip="刷新列表" AutomationProperties.Name="刷新媒体库列表">
                        <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource EgBodyFontSize}" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <ProgressBar Grid.Row="1" Value="{x:Bind ViewModel.ScanProgress, Mode=OneWay}" Maximum="100" Visibility="{x:Bind ViewModel.ScanVisibility, Mode=OneWay}" />
            <GridView x:Name="LibrariesGrid" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Libraries, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True"
                ItemClick="OnLibraryClick" SizeChanged="OnLibraryGridSizeChanged" IsEnabled="{x:Bind ViewModel.CanUse, Mode=OneWay}" HorizontalAlignment="Stretch">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="280" /></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,0,10,14" /><Setter Property="Padding" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ManagedLibraryRow">
                        <Border Background="{ThemeResource EgSurfaceBrush}" BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource EgCardCornerRadius}">
                            <StackPanel>
                                <Grid Height="145" Background="{ThemeResource EgSurfaceElevatedBrush}">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="{StaticResource EgDisplayFontSize}" Foreground="{ThemeResource EgTextDimBrush}" />
                                    <Grid><Grid.Background><ImageBrush ImageSource="{x:Bind Image, Mode=OneWay}" Stretch="UniformToFill" /></Grid.Background></Grid>
                                </Grid>
                                <Grid Padding="16" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgBodyStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind TypeName}" Style="{StaticResource EgCaptionStyle}" />
                                        <TextBlock Text="{x:Bind Locations}" Style="{StaticResource EgCaptionStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ScanStatus}" Style="{StaticResource EgCaptionStyle}" />
                                    </StackPanel>
                                    <Button x:Name="LibraryCardMenu" Grid.Column="1" VerticalAlignment="Top" Tag="{x:Bind}" Click="OnLibraryMenu"
                                        AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="媒体库选项" Style="{StaticResource SubtleButtonStyle}">
                                        <FontIcon Glyph="&#xE712;" FontSize="{StaticResource EgBodyFontSize}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
        <Grid Grid.Row="2" RowSpacing="14" Visibility="{x:Bind ViewModel.AdvancedVisibility, Mode=OneWay}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Button x:Name="LibraryMetadataBrowseButton" Content="选择服务器元数据目录" Click="OnMetadataDirectory" IsEnabled="{x:Bind ViewModel.CanSaveAdvanced, Mode=OneWay}" />
            <ScrollView x:Name="LibraryAdvancedScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{x:Bind ViewModel.CanSaveAdvanced, Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.AdvancedSections, Mode=OneWay}" ItemTemplate="{StaticResource LibrarySectionTemplate}" MaxWidth="900" HorizontalAlignment="Stretch" />
            </ScrollView>
            <Button x:Name="LibraryAdvancedSaveButton" Grid.Row="2" Content="保存" Command="{x:Bind ViewModel.SaveAdvancedCommand}" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
        <Grid Grid.Row="1" Grid.RowSpan="2" RowSpacing="16" Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Name="LibraryEditorBack" Content="返回" Command="{x:Bind ViewModel.BackCommand}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}" Style="{StaticResource EgSectionTitleStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
            <ScrollView x:Name="LibraryEditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}">
                <StackPanel Spacing="0" MaxWidth="900" HorizontalAlignment="Stretch">
                    <Border Style="{StaticResource LibrarySection}" Margin="0,0,0,14">
                        <StackPanel Spacing="14">
                            <ComboBox x:Name="LibraryContentType" Header="内容类型" ItemsSource="{x:Bind ViewModel.ContentTypes, Mode=OneWay}" ItemTemplate="{StaticResource LibraryChoiceTemplate}"
                                SelectedIndex="{x:Bind ViewModel.ContentTypeIndex, Mode=OneWay}" SelectionChanged="OnContentTypeChanged"
                                Visibility="{x:Bind ViewModel.NewVisibility, Mode=OneWay}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{x:Bind ViewModel.ContentTypeName, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" Visibility="{x:Bind ViewModel.ExistingVisibility, Mode=OneWay}" />
                            <TextBox x:Name="LibraryNameBox" Header="显示名称" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LibrarySection}" Margin="0,0,0,14" Visibility="{x:Bind ViewModel.PathsVisibility, Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="文件夹" Style="{StaticResource EgSectionTitleStyle}" />
                            <ItemsControl x:Name="LibraryPaths" ItemsSource="{x:Bind ViewModel.Paths, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LibraryPathRow">
                                        <Grid Margin="0,4" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap" Style="{StaticResource EgBodyStyle}" />
                                                <TextBlock Text="{x:Bind NetworkPath}" TextWrapping="Wrap" Style="{StaticResource EgCaptionStyle}" />
                                            </StackPanel>
                                            <Button x:Name="LibraryPathEdit" Grid.Column="1" Tag="{x:Bind}" Content="编辑" Click="OnEditPath" AutomationProperties.Name="编辑媒体目录" />
                                            <Button x:Name="LibraryPathRemove" Grid.Column="2" Tag="{x:Bind}" Content="移除" Click="OnRemovePath" AutomationProperties.Name="移除媒体目录" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="LibraryPathAdd" Content="添加文件夹" Click="OnAddPath" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}" ItemTemplate="{StaticResource LibrarySectionTemplate}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryProviderGroup">
                                <Border Style="{StaticResource LibrarySection}" Margin="0,0,0,14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource EgSectionTitleStyle}" TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{x:Bind Providers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LibraryProviderRow">
                                                    <Grid Margin="0,4" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <CheckBox x:Name="LibraryProviderCheck" IsChecked="{x:Bind Enabled, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}">
                                                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                                            </CheckBox>
                                                            <TextBlock Text="{x:Bind Note}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" Visibility="{x:Bind NoteVisibility}" />
                                                            <Button x:Name="LibraryProviderSetup" Content="配置提供者" Tag="{x:Bind}" Click="OnProviderSetup" Visibility="{x:Bind SetupVisibility}" />
                                                        </StackPanel>
                                                        <Button x:Name="LibraryProviderUp" Grid.Column="1" Content="↑" Tag="{x:Bind}" Click="OnProviderUp" VerticalAlignment="Top" Visibility="{x:Bind Group.OrderVisibility, Mode=OneWay}" AutomationProperties.Name="上移提供者" />
                                                        <Button x:Name="LibraryProviderDown" Grid.Column="2" Content="↓" Tag="{x:Bind}" Click="OnProviderDown" VerticalAlignment="Top" Visibility="{x:Bind Group.OrderVisibility, Mode=OneWay}" AutomationProperties.Name="下移提供者" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ImageSections, Mode=OneWay}" ItemTemplate="{StaticResource LibrarySectionTemplate}" />
                </StackPanel>
            </ScrollView>
            <Button x:Name="LibraryEditorSave" Grid.Row="2" Content="保存媒体库" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
    <Frame x:Name="LibraryWebFrame" Visibility="Collapsed" />
    </Grid>
</Page>
