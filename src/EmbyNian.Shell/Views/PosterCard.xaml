<?xml version="1.0" encoding="utf-8"?>
<!-- 共用的影院海报卡：圆角封面、清晰的标题层级，以及轻上浮、图片推近和渐显操作层。 -->
<UserControl
    x:Class="EmbyNian.Shell.Views.PosterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 保留平台按钮模板与焦点反馈；右下操作仅画图标，遮罩负责照片上的对比度。 -->
        <Style x:Key="EgCardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource EgOnScrimBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="EgCardPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- 宽度和海报比例继续由页面的 CardSize 决定，动画只改变绘制，不改变测量。 -->
    <Grid
        x:Name="Root"
        Width="{x:Bind CardWidth, Mode=OneWay}"
        Background="Transparent"
        HorizontalAlignment="Center"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited"
        RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="CardMotion" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="Art"
            Height="{x:Bind PosterHeight, Mode=OneWay}"
            Style="{StaticResource EgFrameStyle}">
            <Grid>
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource EgTextFaintBrush}"
                    Glyph="{x:Bind Card.Glyph, Mode=OneWay}" />
                <Image
                    x:Name="Poster"
                    ImageOpened="OnPosterOpened"
                    RenderTransformOrigin="0.5,0.5"
                    Source="{x:Bind Card.Poster, Mode=OneWay}"
                    Stretch="UniformToFill">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="PosterMotion" />
                    </Image.RenderTransform>
                </Image>
                <Border
                    x:Name="HoverShade"
                    Background="{ThemeResource EgScrimBrush}"
                    IsHitTestVisible="False"
                    Opacity="0" />

                <Border
                    Style="{StaticResource EgCornerBadgeStyle}"
                    Visibility="{x:Bind Card.WatchedBadgeVisibility, Mode=OneWay}">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource EgTextOnAccentBrush}"
                        Glyph="&#xE73E;" />
                </Border>
                <Border
                    Style="{StaticResource EgCornerBadgeStyle}"
                    Visibility="{x:Bind Card.UnplayedVisibility, Mode=OneWay}">
                    <TextBlock
                        Style="{StaticResource EgCornerBadgeTextStyle}"
                        Text="{x:Bind Card.UnplayedText, Mode=OneWay}" />
                </Border>
                <FontIcon
                    Margin="8"
                    FontSize="14"
                    Foreground="{ThemeResource EgDangerBrush}"
                    Glyph="&#xEB52;"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind Card.FavoriteBadgeVisibility, Mode=OneWay}" />

                <Grid
                    Height="{StaticResource EgProgressThickness}"
                    VerticalAlignment="Bottom"
                    Visibility="{x:Bind Card.ProgressVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind Card.ProgressDone, Mode=OneWay}" />
                        <ColumnDefinition Width="{x:Bind Card.ProgressLeft, Mode=OneWay}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Background="{ThemeResource EgOnScrimDimBrush}" Opacity="0.24" />
                    <Border Background="{ThemeResource EgAccentBrush}" />
                </Grid>

                <!-- 整层共同渐显，离开后立即停止命中，淡出完成再收起；键盘仍可从 Shift+F10 进入全部操作。 -->
                <Grid x:Name="Hover" Opacity="0" Visibility="Collapsed">
                    <Button
                        x:Name="PlayButton"
                        AutomationProperties.Name="{x:Bind Card.PlayActionTip, Mode=OneWay}"
                        Click="OnPlayClicked"
                        HorizontalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5"
                        Style="{StaticResource EgCardPlayButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind Card.PlayActionTip, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind Card.PlayVisibility, Mode=OneWay}">
                        <Button.RenderTransform>
                            <ScaleTransform x:Name="PlayMotion" ScaleX="0.92" ScaleY="0.92" />
                        </Button.RenderTransform>
                        <FontIcon Margin="2,0,0,0" FontSize="20" Glyph="&#xE768;" />
                    </Button>
                    <StackPanel
                        x:Name="Actions"
                        Margin="0,0,6,4"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Bottom">
                        <StackPanel.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EgOnScrimBrush" />
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EgOnScrimDimBrush" />
                        </StackPanel.Resources>
                        <Button
                            x:Name="WatchedButton"
                            AutomationProperties.Name="{x:Bind Card.WatchedActionTip, Mode=OneWay}"
                            Click="OnWatchedClicked"
                            Style="{StaticResource EgCardActionButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind Card.WatchedActionTip, Mode=OneWay}"
                            Visibility="{x:Bind Card.UserStateVisibility, Mode=OneWay}">
                            <Grid>
                                <FontIcon FontSize="20" Glyph="&#xEC61;" Visibility="{x:Bind Card.NotWatchedVisibility, Mode=OneWay}" />
                                <FontIcon FontSize="20" Foreground="{ThemeResource EgAccentBrush}" Glyph="&#xEC61;" Visibility="{x:Bind Card.WatchedVisibility, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="FavoriteButton"
                            AutomationProperties.Name="{x:Bind Card.FavoriteActionTip, Mode=OneWay}"
                            Click="OnFavoriteClicked"
                            Style="{StaticResource EgCardActionButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind Card.FavoriteActionTip, Mode=OneWay}"
                            Visibility="{x:Bind Card.UserStateVisibility, Mode=OneWay}">
                            <Grid>
                                <FontIcon FontSize="20" Glyph="&#xEB52;" Visibility="{x:Bind Card.NotFavoriteVisibility, Mode=OneWay}" />
                                <FontIcon FontSize="20" Foreground="{ThemeResource EgDangerBrush}" Glyph="&#xEB52;" Visibility="{x:Bind Card.FavoriteVisibility, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="MoreButton"
                            x:Uid="PosterCard_MoreButton"
                            Click="OnMoreClicked"
                            Style="{StaticResource EgCardActionButtonStyle}">
                            <FontIcon FontSize="20" Glyph="&#xE712;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock
                x:Name="TitleLine"
                FontWeight="SemiBold"
                MaxLines="1"
                Style="{StaticResource EgBodyStyle}"
                Text="{x:Bind Card.Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind Card.Title, Mode=OneWay}" />
            <TextBlock
                x:Name="SubLine"
                MaxLines="1"
                Style="{StaticResource EgDataStyle}"
                Text="{x:Bind Card.Subtitle, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
