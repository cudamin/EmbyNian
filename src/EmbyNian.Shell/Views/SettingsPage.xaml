<?xml version="1.0" encoding="utf-8"?>
<!--
  The settings page. Categories on the left, cards on the right, around sixty rows in total.

  The rows are data, not markup: the view model builds a list of typed row objects and a
  DataTemplateSelector picks the shape for each. Writing sixty rows out by hand would mean the labels,
  ranges and notes live here while the settings they touch live in the view model, and the two drift.

  x:Bind with x:DataType on every template, so a renamed row property fails the build instead of drawing a
  blank control. The colours and metrics are theme resources rather than the literals the procedural version
  used, which is the same palette by value and now follows the theme.
-->
<Page
    x:Class="EmbyNian.Shell.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:local="using:EmbyNian.Shell.Views"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:vm="using:EmbyNian.Shell.ViewModels"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Page.Resources>
        <!--
          控件那一列有多宽。一个数写在一处，六种行（开关、下拉、数字、滑块、输入、字体）共用：这几行的控件
          必须落在同一条竖线上，各写一遍的下场是它们各自跟着自己那点内容飘。
          左边那一列是 *，所以标签和说明拿的是剩下的全部 —— 说明原来被挤在 190 宽里折两行，而右边空着
          四百多像素。
        -->
        <GridLength x:Key="EgSettingControlWidth">320</GridLength>

        <!--
          The label and its optional second line, shared by every row shape that has a label column.
          正文字和小字两档都从词表里来（Theme/Styles.xaml）—— 这两个样式以前只写了字号和颜色，没写字体，
          于是整页六十行标签落回框架默认那支字，比界面里别处的正文大一点也不是同一种字。
        -->
        <Style x:Key="EgSettingLabel" TargetType="TextBlock" BasedOn="{StaticResource EgBodyStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EgSettingNote" TargetType="TextBlock" BasedOn="{StaticResource EgCaptionStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--
          色板那一块。整块的底色、强调条和字都是那一套主题自己的颜色（在 ThemeSwatch 里做成固定画刷），
          所以按钮自己在四个状态下都必须是透明的 —— 视觉状态里的画刷会盖过本地值，指针一压上去就把那套
          主题的底色刷成框架的悬停灰。状态改这一圈线：胶片格的规矩，指针或焦点上来整圈变强调色。
          封面改圆角之后这六块留方（EgBleedCornerRadius）：里面那块底色是按钮的内容，按钮的圆角剪不动它，
          圆角一上就是底色的直角戳在框线外面。
        -->
        <Style x:Key="EgSwatchStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
            <Setter Property="BorderThickness" Value="{StaticResource EgHairline}" />
            <Setter Property="CornerRadius" Value="{StaticResource EgBleedCornerRadius}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <!-- 定死的一块，而不是按内容撑开：色板是拿来比颜色的，六块一样大才好比；名字长一个字宽一截的话，
                 那点差别看着就像是颜色以外还差了别的什么。同样的道理，一格 224×100 也就写在这里一处。 -->
            <Setter Property="Width" Value="224" />
            <Setter Property="Height" Value="100" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <!--
          换次序那两颗箭头。小、透明、只占一个字符宽：它们要塞进一行 40 像素里，还不能把标题那一列挤窄
          （行高写在 SettingHomeLayoutRow.RowHeight）。按钮默认样式在这个尺寸上是一块灰底方砖，一行里并排两块
          比那一行的字还抢眼，所以底色和边框都撤掉 —— 指针压上去那点反馈还在，视觉状态刷的是模板里那一块，盖得过
          这里的透明（同上头色板那一段，只是那儿要的正好相反）。
        -->
        <Style x:Key="EgHomeShiftStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- 墨走角色表，不吃按钮自己那档：框架那档在 daylight 下是白底上的一层浅灰，两颗箭头几乎看不出在那儿。
                 置灰那一档不受影响 —— 「不可用」是视觉状态刷的，盖得过这里的设定（同上头色板那一段）。 -->
            <Setter Property="Foreground" Value="{ThemeResource EgTextBrush}" />
            <Setter Property="Padding" Value="6,1,6,1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
          Keyed rather than inlined into the selector below, because the passthrough group renders the same
          shape for each of its own toggles and a DataTemplate can be used by both.
          <para>
          This is the group's shape only, where a switch sits under a heading among its siblings and carries
          its own label above itself. A switch that is a row on its own uses EgSettingToggleRow instead.
          </para>
        -->
        <DataTemplate x:Key="EgSettingToggle" x:DataType="vm:SettingToggleRow">
            <ToggleSwitch
                Margin="0,3,0,3"
                Header="{x:Bind Label}"
                HorizontalAlignment="Left"
                IsOn="{x:Bind IsOn, Mode=TwoWay}"
                OffContent="关"
                OnContent="开"
                ToolTipService.ToolTip="{x:Bind Note}" />
        </DataTemplate>

        <!--
          一行一个开关：标签和说明占左边那一整片，控件在右边那条固定宽的控件列里 —— 跟同一张卡片上的下拉框、
          数字框、输入框一样，所有控件因此落在同一条竖线上。ToggleSwitch 自带的 Header 会把标签摆到开关上头
          去，那一行于是成了整张卡片上唯一一行标签不在同一条竖线上的，所以这里的标签不走 Header，而是和别的
          行共用 EgSettingLabel。
          标签列是 * 而不是写死的 190：说明那一行原来被挤在 190 里折两行，而右边空着四百多像素 —— 该宽的地方
          窄、该窄的地方宽是同一件事的两头。
        -->
        <DataTemplate x:Key="EgSettingToggleRow" x:DataType="vm:SettingToggleRow">
            <Grid Margin="0,3,0,3" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                    <TextBlock
                        Style="{StaticResource EgSettingNote}"
                        Text="{x:Bind Note}"
                        Visibility="{x:Bind NoteVisibility}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    IsOn="{x:Bind IsOn, Mode=TwoWay}"
                    OffContent="关"
                    OnContent="开"
                    VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <local:SettingRowTemplates x:Key="EgSettingRows" Toggle="{StaticResource EgSettingToggleRow}">

            <local:SettingRowTemplates.Choice>
                <DataTemplate x:DataType="vm:SettingChoiceRow">
                    <Grid Margin="0,3,0,3" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                Visibility="{x:Bind NoteVisibility}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            DisplayMemberPath="Label"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind Choices}"
                            MinWidth="260"
                            SelectedItem="{x:Bind Selected, Mode=TwoWay}" />
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Choice>

            <!--
              A heading and a tighter stack, for switches that are one setting each but read as one
              question. The outer spacing matches the card's so the heading sits away from the group the
              way it did when the two were separate children of the card.
            -->
            <local:SettingRowTemplates.ToggleGroup>
                <DataTemplate x:DataType="vm:SettingToggleGroupRow">
                    <StackPanel Spacing="10">
                        <!-- 词表里的小标题（Theme/Styles.xaml 的 EgSubheadStyle）：以前这里只写了 SemiBold，
                             没写字体也没写字号，一组开关的标题于是比同一张卡片上的别的字都大一点。 -->
                        <TextBlock Style="{StaticResource EgSubheadStyle}" Text="{x:Bind Label}" />
                        <ItemsControl
                            ItemTemplate="{StaticResource EgSettingToggle}"
                            ItemsSource="{x:Bind Toggles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </local:SettingRowTemplates.ToggleGroup>

            <!--
              主题那一行：几块色板，点哪块是哪块 —— 一套配色该让人看见它的颜色，而不是读它的名字。
              每一块都是那一套主题的一个缩影：顶上一条它的「面」色好比标题栏，底下一整片它的「窗」色，
              左边一道它的强调色，名字和深浅两行字用它自己的墨。看到的是「选了它整个界面会是什么样」，
              而不是六个方块。
              右上角那颗角标沿用胶片格那一颗（和海报上「全看完」同一颗）。它跟着当前主题走，而这里正好对得上：
              带角标的永远只有正在用的那一套，那一套的强调色就是角标的底色。
            -->
            <local:SettingRowTemplates.Theme>
                <DataTemplate x:DataType="vm:SettingThemeRow">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource EgSubheadStyle}" Text="{x:Bind Label}" />
                        <TextBlock
                            Style="{StaticResource EgSettingNote}"
                            Text="{x:Bind Note}"
                            Visibility="{x:Bind NoteVisibility}" />
                        <ItemsControl ItemsSource="{x:Bind Swatches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 一格 236×112，块本身 224×100（见 EgSwatchStyle），差出来的就是块与块之间
                                         那道缝。卡片里放得下三块，所以六套是整齐的两行三列；窗口窄了就折成两块
                                         一行，因为它到底还是个折行的网格。 -->
                                    <VariableSizedWrapGrid
                                        ItemHeight="112"
                                        ItemWidth="236"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeSwatch">
                                    <Button
                                        automation:AutomationProperties.Name="{x:Bind Name}"
                                        Command="{x:Bind PickCommand}"
                                        Style="{StaticResource EgSwatchStyle}"
                                        ToolTipService.ToolTip="{x:Bind Note}">
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="EgAccentBrush" />
                                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="EgAccentBrush" />
                                        </Button.Resources>
                                        <Grid Background="{x:Bind Window}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <!-- 上面一条是这套主题的「面」色，下面一大片是它的「窗」色：跟这套
                                                 主题真画出来的窗口一个关系 —— 标题栏一条，底下一整片。 -->
                                            <Border Background="{x:Bind Surface}" />
                                            <StackPanel
                                                Grid.Row="1"
                                                Margin="16,0,12,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontFamily="{StaticResource EgUiFontFamily}"
                                                    FontSize="{StaticResource EgSubheadFontSize}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{x:Bind Ink}"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontFamily="{StaticResource EgDataFontFamily}"
                                                    FontSize="{StaticResource EgEyebrowFontSize}"
                                                    Foreground="{x:Bind InkDim}"
                                                    Text="{x:Bind Kind}" />
                                            </StackPanel>
                                            <Border
                                                Background="{x:Bind Accent}"
                                                Grid.RowSpan="2"
                                                HorizontalAlignment="Left"
                                                Width="6" />
                                            <Border
                                                Grid.RowSpan="2"
                                                Style="{StaticResource EgCornerBadgeStyle}"
                                                Visibility="{x:Bind CheckVisibility, Mode=OneWay}">
                                                <FontIcon
                                                    FontSize="12"
                                                    Foreground="{ThemeResource EgTextOnAccentBrush}"
                                                    Glyph="&#xE73E;" />
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </local:SettingRowTemplates.Theme>

            <local:SettingRowTemplates.Number>
                <DataTemplate x:DataType="vm:SettingNumberRow">
                    <Grid Margin="0,3,0,3" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                Visibility="{x:Bind NoteVisibility}" />
                        </StackPanel>
                        <NumberBox
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Maximum="{x:Bind Maximum}"
                            Minimum="{x:Bind Minimum}"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind Value, Mode=TwoWay}"
                            Width="160" />
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Number>

            <local:SettingRowTemplates.Slider>
                <DataTemplate x:DataType="vm:SettingSliderRow">
                    <Grid Margin="0,3,0,3" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                Visibility="{x:Bind NoteVisibility}" />
                        </StackPanel>
                        <Slider
                            Grid.Column="1"
                            automation:AutomationProperties.Name="mpv 参数滑块"
                            HorizontalAlignment="Stretch"
                            Maximum="{x:Bind Maximum}"
                            Minimum="{x:Bind Minimum}"
                            MinWidth="260"
                            SnapsTo="StepValues"
                            StepFrequency="{x:Bind Step}"
                            TickFrequency="{x:Bind Step}"
                            TickPlacement="None"
                            Value="{x:Bind Value, Mode=TwoWay}" />
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Slider>

            <!--
              No UpdateSourceTrigger here on purpose: x:Bind commits TextBox.Text on lost focus unless told
              otherwise, which is what these want. A path saved per keystroke would rewrite the settings file
              a dozen times while it is being typed, and would hand mpv half a font name.
            -->
            <local:SettingRowTemplates.Text>
                <DataTemplate x:DataType="vm:SettingTextRow">
                    <Grid Margin="0,3,0,3" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                Visibility="{x:Bind NoteVisibility}" />
                        </StackPanel>
                        <TextBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            MinWidth="260"
                            PlaceholderText="{x:Bind Placeholder}"
                            Text="{x:Bind Text, Mode=TwoWay}" />
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Text>

            <!--
              The font picker. The box above the list searches; it is not the value, so unlike every other
              text row here it does commit per keystroke — filtering per keystroke is the whole point, and
              since the setting is written by picking a family out of the list, a half-typed name can never
              reach the settings file. Each line is drawn in the font it offers, which is why a font list
              beats a text box in the first place.
            -->
            <local:SettingRowTemplates.Font>
                <DataTemplate x:DataType="vm:SettingFontRow">
                    <Grid Margin="0,3,0,3" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                Visibility="{x:Bind NoteVisibility}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" MinWidth="260" Spacing="6">
                            <TextBox
                                HorizontalAlignment="Stretch"
                                PlaceholderText="搜索字体：yahei、雅黑、mono…"
                                Text="{x:Bind Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ListView
                                Height="252"
                                ItemsSource="{x:Bind Matches}"
                                SelectedItem="{x:Bind Selected, Mode=TwoWay}"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FontOption">
                                        <StackPanel Padding="0,2,0,2">
                                            <TextBlock
                                                FontFamily="{x:Bind Preview}"
                                                FontSize="15"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontFamily="{x:Bind Preview}"
                                                FontSize="12"
                                                Foreground="{ThemeResource EgTextDimBrush}"
                                                Text="{x:Bind Localized}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind LocalizedVisibility}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Status, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Font>

            <!--
              主页版面那张表：一行一排，勾选决定显不显示，按住往上下拖、或者按右边那两颗箭头决定次序（「新增页里
              拖拽决定这些列表的顺序，勾选显示或者不勾选取消显示」）。

              ListView 而不是 ItemsRepeater：拖拽换位是 ListView 自带的（CanReorderItems ＋ AllowDrop 是鼠标
              拖得动的那两位，ReorderMode 管触摸那条路），它改的就是绑上来那个 ObservableCollection 自己的次序，
              所以「屏上的次序」和「要存的次序」是同一件东西。SelectionMode 关掉：这张表没有「选中」这个概念，点一行
              只有一个意思，就是那个勾。高度由行数算（ListHeight）而不是让它自己滚：设置页本来就是一整页滚动条，套
              一个内层滚动条之后，拖到边上时两个滚动条互相抢，一项都拖不到看不见的地方去。

              CanDragItems 留着是为了「把一项当数据拖出去」那条路和 DragItemsStarting 那两个事件；换位不经过它，
              每个容器上的 CanDrag 也只是它的回声 —— 别拿那一位判断这张表拖不拖得动（自检那一行只把它当读数报）。

              那两颗箭头不是拖拽的备胎，是这件事唯一验得到的形式：这台机器上注不进鼠标事件，拖那一下没法自动做一遍，
              而一张拖不动的表拍出来和拖得动的一模一样（见 SettingHomeLayoutRow 上那段说明）。顺带，不使指针的人也
              有了一条路。
            -->
            <local:SettingRowTemplates.HomeLayout>
                <DataTemplate x:DataType="vm:SettingHomeLayoutRow">
                    <StackPanel Margin="0,3,0,3" Spacing="8">
                        <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                        <TextBlock
                            Style="{StaticResource EgSettingNote}"
                            Text="{x:Bind Note}"
                            Visibility="{x:Bind NoteVisibility}" />

                        <ListView
                            AllowDrop="True"
                            CanDragItems="True"
                            CanReorderItems="True"
                            Height="{x:Bind ListHeight, Mode=OneWay}"
                            ItemsSource="{x:Bind Rows}"
                            ReorderMode="Enabled"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeRowChoice">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            AutomationProperties.Name="{x:Bind Title}"
                                            IsChecked="{x:Bind Visible, Mode=TwoWay}"
                                            MinWidth="0" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Title}"
                                            VerticalAlignment="Center" />

                                        <!-- 换次序那两颗。到顶的「上移」和到底的「下移」置灰（CanUp/CanDown）：
                                             按下去也不动的按钮亮着，第一次按的人只会以为这张表是坏的。 -->
                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.Name="上移"
                                            Command="{x:Bind UpCommand}"
                                            IsEnabled="{x:Bind CanUp, Mode=OneWay}"
                                            Style="{StaticResource EgHomeShiftStyle}"
                                            ToolTipService.ToolTip="往上挪一排">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="12"
                                                Glyph="&#xE70E;" />
                                        </Button>

                                        <Button
                                            Grid.Column="3"
                                            AutomationProperties.Name="下移"
                                            Command="{x:Bind DownCommand}"
                                            IsEnabled="{x:Bind CanDown, Mode=OneWay}"
                                            Style="{StaticResource EgHomeShiftStyle}"
                                            ToolTipService.ToolTip="往下挪一排">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="12"
                                                Glyph="&#xE70D;" />
                                        </Button>

                                        <!-- 把手：这一行拖得动的那句话。图标是 Segoe 的「重新排序」，和框架自己
                                             的拖拽列表用的是同一个。 -->
                                        <FontIcon
                                            Grid.Column="4"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="14"
                                            Foreground="{ThemeResource EgTextFaintBrush}"
                                            Glyph="&#xE76F;"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </DataTemplate>
            </local:SettingRowTemplates.HomeLayout>

            <!--
              一行读数：左边标签、底下一行值（等宽，多半是个路径，所以要能折行），右边一颗可有可无的按钮。
              值不摆进控件列 —— 那一列只有 320 宽，一个路径在里面要折三行；标签列本来就宽，值跟着标签走。
            -->
            <local:SettingRowTemplates.Fact>
                <DataTemplate x:DataType="vm:SettingFactRow">
                    <Grid Margin="0,3,0,3" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource EgSettingControlWidth}" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource EgSettingLabel}" Text="{x:Bind Label}" />
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource EgDataStyle}"
                                Text="{x:Bind Value}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource EgSettingNote}"
                                Text="{x:Bind Note}"
                                Visibility="{x:Bind NoteVisibility}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind RunCommand}"
                            Content="{x:Bind ActionLabel}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind ActionVisibility}" />
                    </Grid>
                </DataTemplate>
            </local:SettingRowTemplates.Fact>
        </local:SettingRowTemplates>
    </Page.Resources>

    <Grid Margin="{StaticResource EgPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:PageSlate
            Eyebrow="SETTINGS"
            Note="改动即时保存"
            Title="设置" />

        <Grid Grid.Row="1" Margin="0,12,0,0" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.Categories}"
                SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />

            <!--
              需求 2 的后半句：「诊断和服务器移动到设置里」. The left-hand list now ends with two entries that are
              not cards — 服务器 and 诊断 are whole pages, with a server list that talks to the network and a
              log view that tails a file, and neither is expressible as a stack of setting rows.

              So the right-hand column holds two things and shows one: the cards, and a frame the two pages
              are navigated into. Which one is visible follows the selected category, decided in the view
              model rather than here so the page and the self-check read the same flag.
            -->
            <Grid Grid.Column="1">
                <!--
                  Every card is built and kept, and picking a category only changes which one is shown — the
                  same as before. There is no server data on this page, so building all of them costs nothing
                  measurable, and a card that stays alive keeps half-typed text across a trip through the
                  category list.
                -->
                <ScrollView
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind ViewModel.CardsVisibility, Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sections}" MaxWidth="900">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingSection">
                                <Border
                                    Padding="18"
                                    Background="{ThemeResource EgSurfaceAltBrush}"
                                    BorderBrush="{ThemeResource EgBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource EgCardCornerRadius}"
                                    Visibility="{x:Bind SectionVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="10">
                                        <!--
                                          设置卡片的牌子和卡片带的牌子是同一块木头（local:ShelfHead）：分区标题、
                                          右端一个等宽读数、底下一条通栏发丝线。这一页原先自己写了个标题 —— 只有
                                          字号和 SemiBold、没写字体，于是每张卡片的名字比媒体库那些带子的名字大
                                          一点，而且是另一种字；那条线也没有，八张卡片全靠间距分家。
                                        -->
                                        <local:ShelfHead Note="{x:Bind Count}" Title="{x:Bind Title}" />
                                        <TextBlock
                                            Style="{StaticResource EgSettingNote}"
                                            Text="{x:Bind Description}" />
                                        <ItemsControl
                                            ItemTemplateSelector="{StaticResource EgSettingRows}"
                                            ItemsSource="{x:Bind Rows}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="10" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollView>

                <!-- Transitions cleared for the same reason the shell's frame clears them (requirement 9). -->
                <Frame
                    x:Name="HostedFrame"
                    Transitions="{x:Null}"
                    Visibility="{x:Bind ViewModel.HostedVisibility, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
