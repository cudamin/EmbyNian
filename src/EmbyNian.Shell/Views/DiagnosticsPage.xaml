<?xml version="1.0" encoding="utf-8"?>
<!--
  The diagnostics page. Three cards on the left describing the session, the player and mpv; the log on the
  right, following along live.

  x:Bind throughout, with x:DataType on the log template, so a renamed view-model property fails the build
  instead of drawing a blank row. Every button is a Command.
-->
<Page
    x:Class="EmbyNian.Shell.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EmbyNian.Shell.Views"
    xmlns:vm="using:EmbyNian.Shell.ViewModels"
    Background="{ThemeResource EgWindowBrush}">

    <Grid x:Name="PageLayout" Margin="{StaticResource EgPageMargin}" RowSpacing="16" SizeChanged="OnLayoutSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16" RowSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Width="48" Height="48" CornerRadius="16" Background="{ThemeResource EgAccentSoftBrush}">
                <FontIcon Glyph="&#xE9D9;" Foreground="{ThemeResource EgAccentBrush}" FontSize="24" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Uid="DiagnosticsPage_Heading" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Uid="DiagnosticsPage_Description" Foreground="{ThemeResource EgTextDimBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <CommandBar Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                DefaultLabelPosition="Right" Background="{ThemeResource EgSurfaceBrush}" CornerRadius="12" IsOpen="False">
                <AppBarButton x:Uid="DiagnosticsPage_RefreshAction" AutomationProperties.AutomationId="DiagnosticsRefreshButton"
                    Icon="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                <AppBarButton x:Uid="DiagnosticsPage_CopyAction" AutomationProperties.AutomationId="DiagnosticsCopyButton"
                    Icon="Copy" Command="{x:Bind ViewModel.CopyCommand}" />
                <AppBarButton x:Uid="DiagnosticsPage_OpenLogsAction" AutomationProperties.AutomationId="DiagnosticsOpenLogsButton"
                    Icon="Folder" Command="{x:Bind ViewModel.OpenLogDirectoryCommand}" />
            </CommandBar>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" />

        <Grid Grid.Row="2" ColumnSpacing="20" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DiagnosticsSideColumn" Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollView x:Name="StatusCards" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <Border
                        Padding="20"
                        Background="{ThemeResource EgSurfaceBrush}"
                        BorderBrush="{ThemeResource EgBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource EgCardCornerRadius}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="DiagnosticsPage_TextBlock5"
                                FontSize="18" Foreground="{ThemeResource EgAccentBrush}"
                                FontWeight="SemiBold" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DiagnosticsPage_TextBlock6" Foreground="{ThemeResource EgTextDimBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SessionState, Mode=OneWay}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DiagnosticsPage_TextBlock7" Foreground="{ThemeResource EgTextDimBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Account, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DiagnosticsPage_TextBlock8" Foreground="{ThemeResource EgTextDimBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Server, Mode=OneWay}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DiagnosticsPage_TextBlock9" Foreground="{ThemeResource EgTextDimBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ServerVersion, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{ThemeResource EgSurfaceBrush}"
                        BorderBrush="{ThemeResource EgBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource EgCardCornerRadius}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="DiagnosticsPage_TextBlock10"
                                FontSize="18" Foreground="{ThemeResource EgAccentBrush}"
                                FontWeight="SemiBold" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DiagnosticsPage_TextBlock11" Foreground="{ThemeResource EgTextDimBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PlayerState, Mode=OneWay}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DiagnosticsPage_TextBlock12" Foreground="{ThemeResource EgTextDimBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Position, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource EgTextDimBrush}"
                                Text="{x:Bind ViewModel.NowPlaying, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{ThemeResource EgSurfaceBrush}"
                        BorderBrush="{ThemeResource EgBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource EgCardCornerRadius}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="DiagnosticsPage_TextBlock13"
                                FontSize="18" Foreground="{ThemeResource EgAccentBrush}"
                                FontWeight="SemiBold" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DiagnosticsPage_TextBlock14" Foreground="{ThemeResource EgTextDimBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Backend, Mode=OneWay}" TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{ThemeResource EgTextDimBrush}" Text="IPC" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Ipc, Mode=OneWay}" />
                            </Grid>
                            <TextBlock x:Uid="DiagnosticsPage_TextBlock15" Foreground="{ThemeResource EgTextDimBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.MpvPath, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="DiagnosticsPage_TextBlock16" Foreground="{ThemeResource EgTextDimBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Shader, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{ThemeResource EgSurfaceBrush}"
                        BorderBrush="{ThemeResource EgBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource EgCardCornerRadius}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="DiagnosticsPage_TextBlock17"
                                FontSize="18" Foreground="{ThemeResource EgAccentBrush}"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Foreground="{ThemeResource EgTextDimBrush}"
                                Text="{x:Bind ViewModel.LogCount, Mode=OneWay}" />
                            <TextBlock x:Uid="DiagnosticsPage_TextBlock18" Foreground="{ThemeResource EgTextDimBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.LogPath, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollView>

            <Border
                x:Name="LogPanel" Grid.Column="1" Grid.RowSpan="2"
                Background="{ThemeResource EgSurfaceBrush}"
                BorderBrush="{ThemeResource EgBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource EgCardCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="20,18,20,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="DiagnosticsPage_TextBlock19"
                            FontSize="20"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource EgTextDimBrush}"
                            Text="{x:Bind ViewModel.UpdatedAt, Mode=OneWay}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <!-- The filter bar. 实时跟随 is a switch rather than a button because it describes a
                         state, and turning it off is how you read a stack trace without the list moving. -->
                    <Grid Grid.Row="1" Margin="20,14" ColumnSpacing="10" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Uid="DiagnosticsPage_ComboBoxA1"
                            AutomationProperties.AutomationId="DiagnosticsCategoryPicker"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />
                        <ComboBox x:Uid="DiagnosticsPage_ComboBoxA2"
                            AutomationProperties.AutomationId="DiagnosticsLevelPicker"
                            Grid.Column="1"
                            ItemsSource="{x:Bind ViewModel.Levels, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedLevel, Mode=TwoWay}" />
                        <Button x:Uid="DiagnosticsPage_ButtonA3"
                            AutomationProperties.AutomationId="DiagnosticsClearFilterButton"
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            Style="{StaticResource EgIconButtonStyle}"
                            Command="{x:Bind ViewModel.ClearFilterCommand}">
                            <FontIcon Glyph="&#xE894;" />
                        </Button>
                        <ToggleSwitch x:Uid="DiagnosticsPage_ToggleSwitch20"
                            AutomationProperties.AutomationId="DiagnosticsFollowSwitch"
                            Grid.Row="1" Grid.Column="1"
                            IsOn="{x:Bind ViewModel.Following, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <ListView
                        AutomationProperties.AutomationId="DiagnosticsLogList"
                        Grid.Row="2"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogRow">
                                <Border
                                    Padding="14,12"
                                    BorderBrush="{ThemeResource EgBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            Foreground="{x:Bind LevelBrush}"
                                            Text="{x:Bind Header}"
                                            TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource EgTextDimBrush}"
                                            Text="{x:Bind Detail}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind DetailVisibility}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="24" Spacing="14" Visibility="{x:Bind ViewModel.EmptyLogsVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE9D9;" FontSize="32" Foreground="{ThemeResource EgAccentBrush}" />
                        <TextBlock x:Uid="DiagnosticsPage_TextBlock21" Foreground="{ThemeResource EgTextDimBrush}"
                            TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <!-- Kept after playback ends, unlike the live Launch* properties: this box is read
                         after something went wrong, by which time those are back to null. -->
                    <StackPanel
                        Grid.Row="3"
                        Margin="12"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.LaunchVisibility, Mode=OneWay}">
                        <TextBlock
                            FontSize="{StaticResource EgCaptionFontSize}"
                            Foreground="{ThemeResource EgTextDimBrush}"
                            Text="{x:Bind ViewModel.LaunchHeading, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBox x:Uid="DiagnosticsPage_TextBox22"
                            AcceptsReturn="True"
                            AutomationProperties.AutomationId="DiagnosticsLaunchOptionsBox"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            MaxHeight="140"
                            MinHeight="72"
                            Text="{x:Bind ViewModel.LaunchOptions, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
