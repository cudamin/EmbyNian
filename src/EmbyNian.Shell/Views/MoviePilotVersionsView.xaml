<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EmbyNian.Shell.Views.MoviePilotVersionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EmbyNian.Shell.Views">
    <Grid Padding="16" Background="{ThemeResource EgWindowBrush}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <AutoSuggestBox x:Name="SearchInput" Header="搜索 MoviePilot 资源"
            PlaceholderText="输入关键字（如：剧名 S01 E01）" QueryIcon="Find" QuerySubmitted="OnSearch" />
        <InfoBar Grid.Row="1" IsClosable="True" IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
        <Grid Grid.Row="2">
            <local:MoviePilotResourceBrowser x:Name="Browser" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}" Width="40" Height="40" />
                <TextBlock Style="{StaticResource EgBodyStyle}" Foreground="{ThemeResource EgTextDimBrush}"
                    Text="正在各站点搜索版本，可能要等一会儿…" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Margin="24,48,24,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                Foreground="{ThemeResource EgTextDimBrush}" Style="{StaticResource EgBodyStyle}" Text="{x:Bind ViewModel.EmptyNotice, Mode=OneWay}"
                TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
