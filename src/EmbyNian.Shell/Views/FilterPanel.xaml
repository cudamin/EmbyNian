<?xml version="1.0" encoding="utf-8"?>
<!--
  Requirement 5: the filter panel, as the content of the 筛选 button's flyout.

  The blocks are data and their two shapes are markup, which is the arrangement the settings page uses:
  FilterPanelViewModel decides which blocks there are — from EmbyFilterBy, the server's version, and what
  the rows on screen actually contain — and FilterSectionTemplates picks the shape for each. Before this
  every CheckBox, Grid and Expander below was built in code and pushed into a named StackPanel.

  No scroller here on purpose: FlyoutPresenter's own template already has one, and a second scroller
  inside it is the arrangement where the wheel scrolls the wrong list.
-->
<UserControl
    x:Class="EmbyNian.Shell.Views.FilterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EmbyNian.Shell.Views"
    xmlns:vm="using:EmbyNian.Shell.ViewModels">

    <UserControl.Resources>
        <!-- The two text shapes below. Keyed styles rather than properties set in code: a ThemeResource
             has to be resolved by the parser to keep following the theme, and a Resources[key] lookup for
             one is not the same thing as a {ThemeResource} in markup. -->
        <Style x:Key="EgFilterGroupStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        <Style x:Key="EgFilterNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource EgCaptionFontSize}" />
            <Setter Property="Foreground" Value="{ThemeResource EgTextFaintBrush}" />
            <Setter Property="Margin" Value="2,4,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- One box, shared by the on/off options and by the genres, tags and years alike: they differ in
             what a tick writes, which is the view model's business, not this template's.

             MinWidth 0 because a CheckBox defaults to 120, which is wider than a third of this panel. -->
        <DataTemplate x:Key="EgFilterCheck" x:DataType="vm:FilterCheck">
            <CheckBox
                Content="{x:Bind Label}"
                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                MinWidth="0"
                Padding="8,5,0,5"
                ToolTipService.ToolTip="{x:Bind Query}" />
        </DataTemplate>

        <local:FilterSectionTemplates x:Key="EgFilterSections">

            <!-- A heading and the on/off boxes under it. ItemsStretch="Fill" is what makes the boxes share
                 the row equally instead of hugging the left, and ColumnWidth is the width below which the
                 row wraps — the two together are the star columns this used to build by hand, filled left
                 to right so reading and tab order agree. -->
            <local:FilterSectionTemplates.ToggleGroup>
                <DataTemplate x:DataType="vm:FilterToggleGroup">
                    <!-- Spacing 12, the same as between one block and the next, because that is what the
                         header and the grid under it had when they were two separate children of the one
                         stack: the nesting is new, the metrics are not. -->
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource EgFilterGroupStyle}" Text="{x:Bind Label}" />
                        <ItemsRepeater ItemTemplate="{StaticResource EgFilterCheck}" ItemsSource="{x:Bind Toggles}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="8"
                                    MinItemWidth="{x:Bind ColumnWidth}" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </DataTemplate>
            </local:FilterSectionTemplates.ToggleGroup>

            <!-- 类型/标签/年份. IsExpanded is two-way and the request starts from the view model's setter,
                 so the section this opens itself and the one the user opens take the same path. -->
            <local:FilterSectionTemplates.Values>
                <DataTemplate x:DataType="vm:FilterValueSection">
                    <Expander
                        Header="{x:Bind Header, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                        Padding="12,4,12,8">
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource EgFilterNoteStyle}"
                                Text="{x:Bind Note, Mode=OneWay}"
                                Visibility="{x:Bind NoteVisibility, Mode=OneWay}" />
                            <ItemsRepeater ItemTemplate="{StaticResource EgFilterCheck}" ItemsSource="{x:Bind Values}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MinColumnSpacing="8"
                                        MinItemWidth="{x:Bind ColumnWidth}" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </local:FilterSectionTemplates.Values>
        </local:FilterSectionTemplates>
    </UserControl.Resources>

    <StackPanel Spacing="10" Width="360">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                FontSize="{StaticResource EgCaptionFontSize}"
                Foreground="{ThemeResource EgTextDimBrush}"
                MaxLines="2"
                Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />

            <!-- Greyed out rather than pressable-and-inert when there is nothing to clear: the command
                 says whether it can run, so the link and the guard cannot disagree. -->
            <HyperlinkButton
                Command="{x:Bind ViewModel.ClearCommand}"
                Content="清除"
                Grid.Column="1"
                Padding="6,2,6,2" />
        </Grid>

        <ItemsControl
            ItemTemplateSelector="{StaticResource EgFilterSections}"
            ItemsSource="{x:Bind ViewModel.Sections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
