<?xml version="1.0" encoding="utf-8"?>
<!--
  主页通栏轮播：背景铺到窗口顶边和两侧，字幕和操作浮在图上，下沿渐变接回首页内容。
  BannerPictureLoader 在解码时读取原图左侧颜色，向左延长原图宽度的 10%；新增区域平滑接到原图，
  与原图合成同一张位图。两层 ImageBrush 保持 UniformToFill，整体等比例覆盖画框，切换和慢镜头一起运行。
  图片、延长区不会分开加载，也不使用镜像场景或固定黑色填充。原图内容和像素比例保持不变。
  轮播内容先取继续观看，不够再取最近添加；带高由 HomeCarousel.Height 按窗口宽度计算。
-->
<UserControl
    x:Class="EmbyNian.Shell.Views.HomeBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 翻页箭头的三个态，同 ShelfStrip 里那三个：盖在剧照上，所以跟主题无关。 -->
        <SolidColorBrush x:Key="EgBannerPageRestBrush" Color="#8C0C0E11" />
        <SolidColorBrush x:Key="EgBannerPageHoverBrush" Color="#D90C0E11" />
        <SolidColorBrush x:Key="EgBannerPagePressBrush" Color="#F20C0E11" />

        <!-- 底边那排小横条。代码里按 Resources 取键，所以键少一个会在自检里就抛出来。 -->
        <SolidColorBrush x:Key="EgBannerDotBrush" Color="#59F3F5F8" />
        <SolidColorBrush x:Key="EgBannerDotOnBrush" Color="#FFF3F5F8" />

        <!-- 带子自己的底在 Theme/Palette.xaml 里（EgBannerBaseBrush）：图还没解码到的那一瞬、整条带收起来之前的
              那一帧，看见的就是它（2026-09-11 剧照铺满整条带之后，它不再在带子的左右两边露面）。右边那一列媒体库
              2026-09-08 删掉之后，用这一支画刷的只剩这一条带。 -->

        <!-- 播放键原来是一块写死的白底黑字，四支画刷四个态。改成跟主题走的强调色之后那四支全没用了 ——
             详情页头图上的播放键本来就是强调色，同一个产品两个最大的画面上，最主要的那颗键不该一个白
             一个绿。 -->
        <SolidColorBrush x:Key="EgBannerGhostRestBrush" Color="#20F3F5F8" />
        <SolidColorBrush x:Key="EgBannerGhostHoverBrush" Color="#38F3F5F8" />
        <SolidColorBrush x:Key="EgBannerGhostPressBrush" Color="#50F3F5F8" />

        <!-- 三个键的高度和圆角都取词表，跟详情页头图上那六颗一样：38 高、圆角 8。BasedOn 是必须的，见
             ShelfStrip 里同一处注释：隐式样式只在没设过 Style 时生效。
             左右边距 8（原来 14）：这两颗贴着带的边沿走，「按钮旁边移动一些」—— 它们各占的那一段（8 到 46）是
             留给箭头的两条窄栏，而字块站在左上区域、左边距比左边那条窄栏更宽（见下面 Info 的 Margin），两边不同
             列，所以箭头落进字块的高度范围时也压不到字。 -->
        <Style x:Key="EgBannerPageButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="{StaticResource EgActionHeight}" />
            <Setter Property="Height" Value="{StaticResource EgActionHeight}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource EgBannerPageRestBrush}" />
            <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
            <!-- 默认收起：指针在带上才浮出，同 ShelfStrip。 -->
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="EgBannerPlayStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="{StaticResource EgActionHeight}" />
            <Setter Property="MinWidth" Value="142" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="24,0,24,2" />
        </Style>

        <Style x:Key="EgBannerGhostStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="{StaticResource EgActionHeight}" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="22,0,22,2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource EgBannerDotBrush}" />
            <Setter Property="Background" Value="{StaticResource EgBannerGhostRestBrush}" />
            <Setter Property="Foreground" Value="{StaticResource EgOnScrimBrush}" />
        </Style>
    </UserControl.Resources>

    <!--
      IsTabStop 在带本身上，左右方向键翻页：翻页箭头默认是收起的，收起的按键接不了焦点，所以不用键盘的人靠
      箭头、用键盘的人靠这里，底边那排小横条则两边都能点。
    -->
    <Grid
        x:Name="Root"
                x:Uid="HomeBanner_Root"
        Background="Transparent"
        IsTabStop="True"
        UseSystemFocusVisuals="True"
        PointerEntered="OnPointerEntered"
        PointerMoved="OnPointerEntered"
        PointerExited="OnPointerExited"
        GotFocus="OnBannerGotFocus"
        LostFocus="OnBannerLostFocus"
        KeyDown="OnKeyDown">

        <!--
          **框没有了**（「占满窗口的上半部分（包括窗口标题），下方使用渐变衔接」，2026-09-11）。2026-09-10 到
          09-11 之间这里是一个 <c>Border</c>，圆角、整圈发丝线、卡片底色三样齐全 —— 那时「弄个框把轮播图框起来
          （圆角）」被落定成「四边各留 24 的卡片」。现在带子要铺到窗口的三条边（上、左、右），贴着窗口的边画
          圆角会在窗口角上剪出三角形的缺口，整圈发丝线也没有边可收（四条边里三条就是窗口自己的边），卡片底色
          更是要遮住剧照；三条理由一起作废，<c>Border</c> 换回 <c>Grid</c>。
          底沿那条「跟内容交代一下」的渐变（<c>Under</c>，09-11「下方使用渐变衔接」加的）09-12 按他一句
          「轮播图的下方不用加黑色渐变」删了 —— 带子的下沿就是一条硬边，直接接底下的货架。
          带子的底色（<c>EgBannerBaseBrush</c>）挪到这一层：<c>Grid</c> 也有 <c>Background</c>，用它兜住图还没
          解码到的那一瞬和整条带收起来之前的那一帧。它不跟主题走（Palette 里那一段写着理由：带上的字走
          <c>EgOnScrim</c> 那套浅墨，底色跟着主题变成近白就是白底白字）。
        -->
        <Grid x:Name="Frame" Background="{StaticResource EgBannerBaseBrush}">
            <!--
              Band 挂一个以中心为原点的 ScaleTransform（换张时整块带子极轻微推近一下，见 HomeBanner.Push）：
              缩放挂在这一层而不是 Root 上，是因为它会连 Frame 那支兜底底色一起放大 —— 那正是要的，不然推近的
              那一瞬间四条边会露出底下那圈底色。
            -->
            <Grid x:Name="Band" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BandScale" />
                </Grid.RenderTransform>

                <!--
                  **带里只有两层剧照，别的什么都不铺**（「去掉首页封面轮播图的黑边」，2026-09-11）。这里在 09-11
                  当天先站过一对镜像的翼、又换成两片纯色底，两版都被他否了；三版镜像翼的毛病按顺序记在文件头那
                  一段，免得下一个窗口又从某一版重新试一遍。**结论是让图自己铺满**：没有边，就没有边的问题。

                  带子的底色（`Frame` 的 `EgBannerBaseBrush`）只剩两个用处 —— 图还没解码到的那一瞬、整条带收起
                  来之前的那一帧。它不跟主题走（Palette 里那一段写着理由：带上的字走 `EgOnScrim` 那套浅墨，底色
                  跟着主题变成近白就是白底白字）。
                -->

                <!--
                  两层剧照轮着上：走下一张时新的那层淡入、旧的那层淡出，所以带上任何时候都有图，不会闪一下底色。

                  **铺满是靠 ImageBrush，不是靠 Image**（「去掉首页封面轮播图的黑边」，2026-09-11）。这两层是空
                  Grid（没有任何孩子），背景是一支 <c>ImageBrush Stretch="UniformToFill"</c>：画刷把图按自己的
                  比例放大到盖住整格、多出来的一截对半裁掉（<c>AlignmentX/Y</c> 默认就是 Center），而空 Grid 由
                  对齐撑满整格 —— 两件事都是定义清楚的。
                  **为什么不用 Image 控件**：它按内容取尺寸、不吃满格子（09-10 那批横幅实验量到过），于是给死
                  `Width`/`Height` 也不保险 —— 2026-09-11 这一版第一趟就撞上了：自检量到元素 1014×570 而带子
                  1014×341，实拍里图从带子顶上开始铺、下沿那一截（花田）整片被裁掉，也就是**裁在了顶上而不是
                  居中**。ImageBrush 没有这条脾气。别把它换回 Image。
                  「上下各裁 5%」（09-10「轮播图上下各裁切百分之五」）和它那个常数 `KeptShare` 随这一改删了：
                  上下各 5% 是把图放进一个只差一成的格子里才说得通的数，现在裁多少是算出来的。
                -->
                <Grid x:Name="LayerA" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="PictureScaleA" />
                    </Grid.RenderTransform>
                    <Grid.Background>
                        <ImageBrush Stretch="UniformToFill" />
                    </Grid.Background>
                </Grid>
                <Grid x:Name="LayerB" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="PictureScaleB" />
                    </Grid.RenderTransform>
                    <Grid.Background>
                        <ImageBrush Stretch="UniformToFill" />
                    </Grid.Background>
                </Grid>

                <!--
                  带上的黑渐变一共四层：顶上给标题栏垫底的一条（Top）、左边那道渐变幕（Fade）、下和右两条只压边缘
                  的。前四层都摆在两层剧照之后、字块之前，所以压得到图、压不到字。颜色全是写死的 ARGB
                  （#0C0E11，同 EgOnScrim* 那一族）：高对比度那本词典里只有画刷没有颜色键，写颜色键会在运行时抛。

                  **顶上那条 120 高的（Top）是 2026-09-10 删掉、2026-09-11 找回来的**：通栏之后标题栏那一行
                  （含系统那三颗窗口按钮）又浮在剧照上，浅墨画在一张亮剧照上读不出来，所以顶上要压一层。它压的是
                  <b>窗口的顶边</b>那一段，不是带子的顶边 —— 带子的顶边就是窗口的顶边，两回事在这里是一回事。
                -->
                <Border x:Name="Top" Height="96" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0" Color="#70101217" />
                            <GradientStop Offset="0.45" Color="#28101217" />
                            <GradientStop Offset="1" Color="#00101217" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!--
                  下边那一条。铺满整条带、按比例取渐变，而不是写死高度：字块最宽的那一档尾巴挨着下沿，底边那排小
                  横条又居中、站在图上 —— 这两样都得这一条托着，而带高在 240 到一屏之间变。**到 0.35 处已经全透明**
                  （第三趟从 0.5 收进来的），所以它压不到字块上半截那两行（徽标和片名）。
                -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                            <GradientStop Offset="0" Color="#990C0E11" />
                            <GradientStop Offset="0.14" Color="#660C0E11" />
                            <GradientStop Offset="0.25" Color="#330C0E11" />
                            <GradientStop Offset="0.35" Color="#000C0E11" />
                            <GradientStop Offset="1" Color="#000C0E11" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!--
                  左边那道渐变幕（2026-09-10 起）：左头近实心（#E6，九成）、往右一路淡出到全透明。它的主顾从头到尾
                  是**那块字** —— 字压在图上，亮剧照上（量过的一张粉色动画剧照：简介 1.9:1）没有它读不出来。
                  09-11「去掉首页封面轮播图的黑边」之后它多了一句更要紧的：**这条带从左沿到右沿都是图了**，字的底下
                  不再有纯色底兜着，全靠它。
                  **多宽由代码算**（Resize）：**「字块左沿 ＋ 字块最宽 ＋ ScrimBreath」**（幕得盖过字的尾巴，右边留
                  一口气再散尽）。从前还要与「左边纯色那一片的宽 ＋ 图宽的三成半」取大的那个 —— 那一项 09-11 随
                  「两边不再有纯色」删了（`FadeShare`）。
                  **右边不配一道对称的浓幕**：右边没有字要托，两边都压浓在屏上就是「一张被左右夹黑的图」—— 那正是
                  他 09-11 要去掉的东西；右边收边只靠下面那条薄薄的一层。
                  它一头在带沿、一头跟着字块算，所以不跟下、右两条走 Rims 那句「半张之前散尽」（自检里判它的是
                  Melts）。
                -->
                <Border x:Name="Fade" HorizontalAlignment="Left">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Offset="0" Color="#F0101217" />
                            <GradientStop Offset="0.35" Color="#C2101217" />
                            <GradientStop Offset="0.70" Color="#66101217" />
                            <GradientStop Offset="1" Color="#00101217" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!--
                  右边那一条：最薄的一层，收的是**带子自己的右沿**。它 09-11 上半天收的是「右片翼压到带沿上」那条
                  硬边；翼和纯色底都拆了之后，它收的是**图自己被裁的那条边**（`UniformToFill` 把图裁在框里，框沿
                  就是一条硬边），外加一点点压角。字不在这一边，所以浓度只有下边那层的一半上下，伸进来的深度也只有
                  它的一半上下。**0x4A 离 Probe 那句「贴边那头 alpha > 0x40」只剩一档**，要再淡得连那句断言一起改。
                  他 09-11 说「去掉黑边」要的是两侧那两片纯色，不是这一条 —— 谁嫌它还黑，改成 0 之后连断言一起改。
                -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                            <GradientStop Offset="0" Color="#4A0C0E11" />
                            <GradientStop Offset="0.19" Color="#000C0E11" />
                            <GradientStop Offset="1" Color="#000C0E11" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!--
                  字块竖向居中站在左边（「字块放到封面居中的位置」，2026-09-10 —— 左边距 60 不动）。**它整块都压在
                  剧照上**（09-11 起带里没有纯色底了，字的中后段更是直接压在剧照上）—— 托着它的是左边那道渐变幕
                  （Fade，宽度由 Resize 按字块算，见上面那一段）。徽标顶在片名头上，同详情页头图上的 TitlePlate。
                  PlaceLogo 早删了：徽标由这一叠布局。

                  竖向这一轴它走过三站：左下（09-09 之前）→ 左上角（09-10「把红框里的东西移动到左上角」，顶距 116
                  再收成 40）→ 现在的居中。底边那排小横条独立贴下沿，和字块不再共用一条避让规则 —— 居中这一版
                  字块最宽那一档的尾巴也够不到下沿那一排（带子最矮 240，字块最高 210，两头还各有一口气）。

                  每一行各有自己的 TranslateTransform，因为换一张时它们错着抬起来（见 HomeBanner.Rise）；动画在代码里
                  搭，Storyboard.TargetName 只在运行时解析，写在这里编译不出错、跑起来才抛。

                  左边距 60（原来 28，页面脊线的位置）让开翻页箭头：箭头从左边占到 46，余下 14 是箭头和字之间的一口气。
                  所以字块不和 PageSlate 的 24 左对齐 —— 页面抬头和画面内容不是一层，后者要让出箭头那条窄栏。
                -->
                <StackPanel
                    x:Name="Info"
                    Margin="60,0,0,0"
                    MaxWidth="620"
                    Spacing="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">

                    <!--
                      下面这四行各自套一层 Grid（<c>…Row</c>），为的是那层跟着字形走的影子（见 TextInk）：影子挂在同
                      一格里排在字前面的那个空元素上，而抬起来那一下的位移和淡入写在这一格上 —— 两样分开写的话，字抬
                      起来了影子还留在原处。所以 **RenderTransform 和 Opacity 都在 Row 这一层，不在字上**。
                      影子只在亮剧照上才看得出用处：量过的账在 TextInk 那段注释里（粉色那张动画剧照上简介 1.9:1）。
                    -->

                    <!-- 剧集自己的徽标，没有就整行收起（StackPanel 的 Spacing 不给收起来的孩子留位置）—— 「这个剧集
                         没有徽标」和「徽标没画出来」在屏上长得一样，而只有后一种是这份代码的错。
                         上限 280×56 抄的是详情页头图上那块 TitlePlate，也就是这个应用里另一处「徽标顶在片名头上」的
                         地方；它在右下角那一版是 240×86，站进字块之后收一档 —— 五行东西叠起来，而带子最矮那一档
                         只有 240 高（HomeCarousel.MinHeight，带子按它自己的宽算出来的高够不到 240 的时候），一整块
                         字得放得进去。 -->
                    <Grid x:Name="LogoRow">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="LogoShift" />
                        </Grid.RenderTransform>
                        <Border x:Name="LogoInk" IsHitTestVisible="False" />
                        <Image
                            x:Name="LogoImage"
                            Stretch="Uniform"
                            MaxHeight="44"
                            MaxWidth="260"
                            HorizontalAlignment="Left"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>

                    <!-- 字号字体字色全在 EgDisplayTitleStyle 里 —— 从 2026-09-12 起它是这一处自己的键（详情页
                         头图上那一行分出去成了 EgHeroTitleStyle：那一行会折行，折行的行距另有讲究）。原来这里
                         写死 40/Bold 而没写字体，于是主页最大的一块字是「更大的正文字」；前景取的还是播放键那支
                         画刷 —— 一支键的画刷去画字，改主题时那两处必然各走各的。
                         MaxLines="1"：这一行不折行（片名长了截断加省略号），所以它用不着详情页那一支的行高。 -->
                    <Grid x:Name="TitleRow">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="TitleShift" />
                        </Grid.RenderTransform>
                        <Border x:Name="TitleInk" IsHitTestVisible="False" />
                        <TextBlock
                            x:Name="TitleText"
                            Style="{StaticResource EgDisplayTitleStyle}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- 集号和那串读数（「S03E09 · 2024 · 1080P · 2H14M」），所以走等宽的那一支 —— 和详情页头图
                         上同一行东西同一种字。 -->
                    <Grid x:Name="CaptionRow">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="CaptionShift" />
                        </Grid.RenderTransform>
                        <Border x:Name="CaptionInk" IsHitTestVisible="False" />
                        <TextBlock
                            x:Name="CaptionText"
                            Style="{StaticResource EgOnScrimDataStrongStyle}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- 两行就够：这条带是「看一眼决定看不看」，不是简介页。字比上面那行读数暗一档 —— 原来这里
                         是 Opacity 0.86 装出来的暗，而暗一档本来就是一支画刷的事。 -->
                    <Grid x:Name="SynopsisRow">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="SynopsisShift" />
                        </Grid.RenderTransform>
                        <Border x:Name="SynopsisInk" IsHitTestVisible="False" />
                        <TextBlock
                            x:Name="SynopsisText"
                            Style="{StaticResource EgOnScrimBodyStyle}"
                            Foreground="{StaticResource EgOnScrimDimBrush}"
                            LineHeight="24"
                            MaxLines="2"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <StackPanel
                        x:Name="Actions"
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="ActionsShift" />
                        </StackPanel.RenderTransform>

                        <!-- 强调色键，四个态全交给 AccentButtonStyle：Palette 那三份词典连 AccentFillColor* 一起
                             改，ThemeHost 换主题时也一起重涂，所以这颗键跟着主题走（同详情页头图上那一颗）。 -->
                        <Button x:Name="PlayButton" Style="{StaticResource EgBannerPlayStyle}" Click="OnPlayClicked">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="13"
                                    Glyph="&#xE768;" />
                                <TextBlock x:Name="PlayText" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="OpenButton"
                    x:Uid="HomeBanner_OpenButton"
                            Style="{StaticResource EgBannerGhostStyle}"
                            Click="OnOpenClicked">
                            <Button.Resources>
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="EgBannerGhostHoverBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="EgBannerGhostPressBrush" />
                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EgOnScrimBrush" />
                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EgOnScrimBrush" />
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Button
                    x:Name="PrevButton"
                    x:Uid="HomeBanner_PrevButton"
                    Style="{StaticResource EgBannerPageButtonStyle}"
                    HorizontalAlignment="Left"
                    Content="&#xE76B;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    IsTabStop="False"
                    Click="OnPrevClicked">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="EgBannerPageHoverBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="EgBannerPagePressBrush" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EgOnScrimBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EgOnScrimBrush" />
                    </Button.Resources>
                </Button>

                <Button
                    x:Name="NextButton"
                    x:Uid="HomeBanner_NextButton"
                    Style="{StaticResource EgBannerPageButtonStyle}"
                    HorizontalAlignment="Right"
                    Content="&#xE76C;"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    IsTabStop="False"
                    Click="OnNextClicked">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="EgBannerPageHoverBrush" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="EgBannerPagePressBrush" />
                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="EgOnScrimBrush" />
                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="EgOnScrimBrush" />
                    </Button.Resources>
                </Button>

                <!-- 小横条在代码里按幻灯片数目造，见 HomeBanner.BuildDots。 -->
                <StackPanel
                    x:Name="Dots"
                    Orientation="Horizontal"
                    Spacing="7"
                    Margin="0,0,0,18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" />

                <StackPanel
                    x:Name="SlideStatus"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,60,28"
                    IsHitTestVisible="False">
                    <TextBlock
                        x:Name="SlideCounter"
                        HorizontalAlignment="Right"
                        Style="{StaticResource EgOnScrimDataStrongStyle}" />
                    <Border Width="120" Height="2" Background="{StaticResource EgBannerDotBrush}" CornerRadius="1">
                        <Border x:Name="CountdownBar" Background="{ThemeResource EgAccentBrush}" CornerRadius="1" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CountdownScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
