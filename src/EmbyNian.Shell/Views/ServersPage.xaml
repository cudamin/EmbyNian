<?xml version="1.0" encoding="utf-8"?>
<!--
  The servers page: saved servers, the accounts on each, a scan of the local network, and what the poster
  cache has taken up on disk.

  Every binding here is x:Bind rather than Binding. The difference that matters is not the speed — it is
  that x:Bind is compiled against a named type, so a renamed property fails the build instead of failing
  silently at runtime, which is exactly how the 「当前」 badge below went unnoticed: it was an InfoBadge
  whose Value is an int, given a string, and nothing said so until the row tried to draw.

  Every button is a Command, not a Click handler. A command that cannot run right now is greyed out by the
  framework, which is what the page's old `if (_busy) return;` guards were trying and failing to convey.
-->
<Page
    x:Class="EmbyNian.Shell.Views.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:emby="using:EmbyNian.Emby"
    xmlns:local="using:EmbyNian.Shell.Views"
    xmlns:vm="using:EmbyNian.Shell.ViewModels"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Page.Resources>
        <!-- Declared before the server template that reaches for it: a StaticResource inside a
             DataTemplate is resolved as the dictionary is parsed, so a forward reference fails. -->
        <DataTemplate x:Key="AccountTemplate" x:DataType="vm:AccountRow">
            <Grid ColumnSpacing="10" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Bind Username}" />
                    <TextBlock
                        FontSize="{StaticResource EgCaptionFontSize}"
                        Foreground="{ThemeResource EgTextDimBrush}"
                        Text="{x:Bind Status}" />
                </StackPanel>
                <Button x:Uid="ServersPage_ButtonA1"
                    Grid.Column="1"
                    Command="{x:Bind Owner.LoginAccountCommand}"
                    CommandParameter="{x:Bind}">
                    <FontIcon Glyph="&#xE8A5;" />
                </Button>
                <Button x:Uid="ServersPage_ButtonA2"
                    Grid.Column="2"
                    Command="{x:Bind Owner.DeleteAccountCommand}"
                    CommandParameter="{x:Bind}">
                    <FontIcon Glyph="&#xE74D;" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ServerTemplate" x:DataType="vm:ServerRow">
            <Border
                Background="{ThemeResource EgSurfaceAltBrush}"
                BorderBrush="{ThemeResource EgBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource EgCardCornerRadius}"
                Margin="0,0,0,12"
                Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    FontSize="{StaticResource EgTitleFontSize}"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}" />
                                <!-- A pill, not an InfoBadge: that control's Value is a number for a
                                     count, and it has no way to show a word. -->
                                <Border
                                    Background="{ThemeResource EgAccentBrush}"
                                    CornerRadius="{StaticResource EgCardCornerRadius}"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind CurrentVisibility}">
                                    <TextBlock x:Uid="ServersPage_TextBlock1"
                                        FontSize="{StaticResource EgCaptionFontSize}"
                                        Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource EgTextDimBrush}"
                                Text="{x:Bind Url}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button x:Uid="ServersPage_ButtonA3"
                                Command="{x:Bind Owner.TestCommand}"
                                CommandParameter="{x:Bind}">
                                <FontIcon Glyph="&#xE72C;" />
                            </Button>
                            <Button x:Uid="ServersPage_ButtonA4"
                                Command="{x:Bind Owner.LoginServerCommand}"
                                CommandParameter="{x:Bind}">
                                <FontIcon Glyph="&#xE8A5;" />
                            </Button>
                            <Button x:Uid="ServersPage_ButtonA5"
                                Command="{x:Bind Owner.DeleteServerCommand}"
                                CommandParameter="{x:Bind}">
                                <FontIcon Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border
                        Background="{ThemeResource EgSurfaceBrush}"
                        BorderBrush="{ThemeResource EgBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource EgCardCornerRadius}"
                        Padding="12,10">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ServersPage_TextBlock2" FontWeight="SemiBold" />
                                <TextBlock
                                    Grid.Column="1"
                                    Foreground="{ThemeResource EgTextDimBrush}"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind AccountSummary}" />
                            </Grid>

                            <ItemsControl ItemTemplate="{StaticResource AccountTemplate}" ItemsSource="{x:Bind Accounts}" />

                            <TextBlock x:Uid="ServersPage_TextBlock3"
                                Foreground="{ThemeResource EgTextFaintBrush}"
                                Visibility="{x:Bind EmptyAccountsVisibility}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource EgPageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:PageSlate x:Uid="ServersPage_localPageSlate4"
            Eyebrow="SERVERS"
            Note="{x:Bind ViewModel.Subheading, Mode=OneWay}">
            <local:PageSlate.Trailing>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button AutomationProperties.AutomationId="ServersAddButton" Command="{x:Bind ViewModel.AddServerCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock x:Uid="ServersPage_TextBlock5" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.AutomationId="ServersDiscoverButton" Command="{x:Bind ViewModel.DiscoverCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE968;" />
                            <TextBlock x:Uid="ServersPage_TextBlock6" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.AutomationId="ServersRefreshButton" Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" />
                            <TextBlock x:Uid="ServersPage_TextBlock7" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </local:PageSlate.Trailing>
        </local:PageSlate>

        <ProgressBar
            Grid.Row="1"
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />

        <!-- TwoWay on IsOpen, so dismissing the bar is recorded rather than only drawn: the next
             message has to be able to reopen it. -->
        <InfoBar
            Grid.Row="1"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}" />

        <ListView
            AutomationProperties.AutomationId="ServersDiscoveredList"
            Grid.Row="2"
            IsItemClickEnabled="True"
            ItemClick="OnDiscoveredPicked"
            ItemsSource="{x:Bind ViewModel.Discovered, Mode=OneWay}"
            Margin="0,32,0,0"
            MaxHeight="184"
            Visibility="{x:Bind ViewModel.DiscoveredVisibility, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="emby:EmbyDiscoveredServer">
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource EgAccentBrush}"
                            Glyph="&#xE774;"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                            <TextBlock
                                FontSize="{StaticResource EgCaptionFontSize}"
                                Foreground="{ThemeResource EgTextDimBrush}"
                                Text="{x:Bind DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollView Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Uid="ServersPage_TextBlock8"
                    Foreground="{ThemeResource EgTextFaintBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,32,0,0"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />

                <ItemsControl ItemTemplate="{StaticResource ServerTemplate}" ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}" />
            </StackPanel>
        </ScrollView>

        <!-- Outside the scroller on purpose: it is the one thing on this page that is about the machine
             rather than about a server, and a long server list would scroll it out of reach. -->
        <Border
            Grid.Row="4"
            Background="{ThemeResource EgSurfaceAltBrush}"
            BorderBrush="{ThemeResource EgBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource EgCardCornerRadius}"
            Padding="16,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="18"
                    Foreground="{ThemeResource EgAccentBrush}"
                    Glyph="&#xEB9F;"
                    VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Uid="ServersPage_TextBlock9" FontWeight="SemiBold" />
                    <TextBlock
                        FontSize="{StaticResource EgCaptionFontSize}"
                        Foreground="{ThemeResource EgTextDimBrush}"
                        Text="{x:Bind ViewModel.CacheSummary, Mode=OneWay}" />
                </StackPanel>
                <Button
                    AutomationProperties.AutomationId="ServersClearCacheButton"
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.ClearCacheCommand}"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" />
                        <TextBlock x:Uid="ServersPage_TextBlock10" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
