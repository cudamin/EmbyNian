<?xml version="1.0" encoding="utf-8"?>
<!--
  需求 6 的「编辑」。A form over ItemMetadataEdit, which owns every rule about what the boxes below
  mean; this file only decides what they look like and in what order they are asked.

  The whole item goes back to the server on save, so the form deliberately shows only the fields it is
  prepared to be authoritative about. Anything not here — the cast, the studios, the image tags — is
  carried through untouched by ItemMetadataEdit.ApplyTo.
-->
<ContentDialog x:Uid="MetadataDialog_ContentDialog1"
    x:Class="EmbyNian.Shell.Views.MetadataDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <!-- Wide enough for a two-column form; the default 548 puts 类型 and 标签 on top of each
             other and turns 简介 into a slot. -->
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer
        HorizontalScrollMode="Disabled"
        MaxHeight="520"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,0,12,0" Spacing="12">

            <!-- Only ever the reason the 保存 button is off, so it stays out of the way until there
                 is one rather than sitting empty above every field. -->
            <InfoBar
                x:Name="Problem"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />

            <TextBox
                x:Name="NameBox"
                x:Uid="MetadataDialog_NameBox"
                TextChanged="OnEdited" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="OriginalTitleBox"
                x:Uid="MetadataDialog_OriginalTitleBox"
                    TextChanged="OnEdited" />

                <TextBox
                    x:Name="SortNameBox"
                x:Uid="MetadataDialog_SortNameBox"
                    Grid.Column="1"
                    TextChanged="OnEdited" />
            </Grid>

            <TextBox
                x:Name="OverviewBox"
                x:Uid="MetadataDialog_OverviewBox"
                AcceptsReturn="True"
                Height="120"
                TextChanged="OnEdited"
                TextWrapping="Wrap" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="OfficialRatingBox"
                x:Uid="MetadataDialog_OfficialRatingBox"
                    PlaceholderText="PG-13"
                    TextChanged="OnEdited" />

                <TextBox
                    x:Name="CommunityRatingBox"
                x:Uid="MetadataDialog_CommunityRatingBox"
                    Grid.Column="1"
                    PlaceholderText="0 – 10"
                    TextChanged="OnEdited" />

                <TextBox
                    x:Name="CriticRatingBox"
                x:Uid="MetadataDialog_CriticRatingBox"
                    Grid.Column="2"
                    PlaceholderText="0 – 100"
                    TextChanged="OnEdited" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="ProductionYearBox"
                x:Uid="MetadataDialog_ProductionYearBox"
                    TextChanged="OnEdited" />

                <TextBox
                    x:Name="PremiereDateBox"
                x:Uid="MetadataDialog_PremiereDateBox"
                    Grid.Column="1"
                    PlaceholderText="2024-05-01"
                    TextChanged="OnEdited" />
            </Grid>

            <TextBox
                x:Name="GenresBox"
                x:Uid="MetadataDialog_GenresBox"
                TextChanged="OnEdited" />

            <TextBox
                x:Name="TagsBox"
                x:Uid="MetadataDialog_TagsBox"
                TextChanged="OnEdited" />

            <!-- Shown only for a season or an episode; a film has no season to be in. -->
            <Grid
                x:Name="IndexRow"
                ColumnSpacing="12"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="ParentIndexBox"
                x:Uid="MetadataDialog_ParentIndexBox"
                    TextChanged="OnEdited" />

                <TextBox
                    x:Name="IndexBox"
                x:Uid="MetadataDialog_IndexBox"
                    Grid.Column="1"
                    TextChanged="OnEdited" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
