<?xml version="1.0" encoding="utf-8"?>
<!--
  一部片的资源（种子）列表，作为搜索页 MoviePilot 那一段之上的一层覆盖面板（不是 ContentDialog：下载要弹二次
  确认，而 WinUI 同时只允许一个 ContentDialog，列表若也是对话框就打架了）。顶上一行标题＋返回，中间一列种子，
  每行一个「下载」。字号/颜色走 Eg* 与主题角色键；不写内联字号（FontIcon 用默认大小）。
-->
<UserControl
    x:Class="EmbyNian.Shell.Views.MoviePilotResourcePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:local="using:EmbyNian.Shell.Views"
    xmlns:vm="using:EmbyNian.Shell.ViewModels"
    Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 返回：返回收起这层覆盖面板，回到片子列表。 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CloseButton" Click="OnClose" Style="{StaticResource EgSecondaryButtonStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" />
                    <TextBlock Text="返回" />
                </StackPanel>
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource EgSubheadStyle}"
                Text="{x:Bind ViewModel.Heading, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />

        <Grid Grid.Row="2">
            <ItemsView
                x:Name="ResourceList"
                IsItemInvokedEnabled="False"
                ItemTransitionProvider="{x:Null}"
                ItemsSource="{x:Bind ViewModel.Resources, Mode=OneWay}"
                SelectionMode="None">
                <ItemsView.Layout>
                    <StackLayout Spacing="10" />
                </ItemsView.Layout>
                <ItemsView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoviePilotResourceRow">
                        <ItemContainer>
                            <Grid
                                Padding="12"
                                ColumnSpacing="12"
                                Background="{ThemeResource EgSurfaceBrush}"
                                BorderBrush="{ThemeResource EgBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource EgCardCornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <Border
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        Background="{ThemeResource EgSurfaceAltBrush}"
                                        CornerRadius="{StaticResource EgPosterCornerRadius}"
                                        Visibility="{x:Bind SiteVisibility}">
                                        <TextBlock Foreground="{ThemeResource EgAccentBrush}" Style="{StaticResource EgCaptionStyle}" Text="{x:Bind SiteName}" />
                                    </Border>
                                    <TextBlock
                                        MaxLines="2"
                                        Style="{StaticResource EgBodyStyle}"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource EgTextDimBrush}"
                                        Style="{StaticResource EgCaptionStyle}"
                                        Text="{x:Bind MetaLine}"
                                        Visibility="{x:Bind MetaVisibility}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    automation:AutomationProperties.Name="{x:Bind DownloadAutomationName}"
                                    Command="{x:Bind DownloadCommand}"
                                    Content="{x:Bind DownloadLabel, Mode=OneWay}"
                                    Style="{StaticResource EgPrimaryButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind DownloadAutomationName}" />
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </ItemsView.ItemTemplate>
            </ItemsView>

            <!-- 搜资源是各站点现捞，慢，用一圈转起来的环 + 一句话，比一根细线让人踏实。 -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}">
                <ProgressRing IsActive="True" Width="40" Height="40" />
                <TextBlock Foreground="{ThemeResource EgTextDimBrush}" Style="{StaticResource EgBodyStyle}" Text="正在各站点搜索资源，可能要等一会儿…" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24,48,24,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                <TextBlock Foreground="{ThemeResource EgTextDimBrush}" Style="{StaticResource EgBodyStyle}" Text="{x:Bind ViewModel.EmptyNotice, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
