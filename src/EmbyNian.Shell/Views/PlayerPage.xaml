            </StackPanel>
            </Grid>

            <!-- 第二行（文件信息「分辨率 · 视频编码 · 音频格式 · 组名」）在**返回键的正下方**，不在上面那个
                 三列 Grid 的列里 —— 这行字比 0 号列宽得多，放进列里会把 Auto 列撑开、把标题推右（用户令
                 2026-09-28「下方那一栏……移动到返回按钮的下方」）。左缘 5＝返回键那块玻璃的左缘（用户令
                 2026-09-28 更晚「把独占模式的标题复刻到集成模式」；独占那头副标题左缘＝窗口左缘＋margin，
                 见 TopBar.lua 的 EMBYNIAN[topbar-subline]）；顶上 36＝返回键玻璃的下沿（5＋30）加 1px 的缝，
                 1 就是独占那两行之间的 `title_spacing`；高 24＝独占的 `alt_title_size`。全屏档这几处
                 （上沿 47、高 31、内边距 13、字号 16.5）由 ApplyTitleScale 一起改。IsHitTestVisible=False：
                 压在这行字上仍然算按在条上、可以拖窗口。 -->
            <Border
                x:Name="SubtitleBox"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="5,36,0,0"
                Height="24"
                Padding="10,0"
                CornerRadius="2"
                Background="{StaticResource PlayerGlassTopBrush}"
                IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.SubtitleVisibility, Mode=OneWay}">
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="{StaticResource EgSublineFontSize}"
                    FontStyle="Italic"
                    Foreground="{StaticResource PlayerInkMetaBrush}"
                    VerticalAlignment="Center"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="└ " /><Run Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
                </TextBlock>
            </Border>
        </Grid>

        <!-- 播放统计面板 2026-09-22 起不在这棵树上：它由 mpv 自己画进 OSD 层（中文覆盖版脚本装箱在
             mpv-ui/scripts/stats.lua，装配见 Core 的 MpvStats）。集成模式的画面本来就是 mpv 的输出，
             所以它照样出现在这里；绘制、读数、按键与生命周期都归 mpv —— 因为验收要的是「统计项与参考
             项目逐项一致」加「全中文」，而自绘的那十一行两条都做不到。 -->

        <!-- A linear, filled volume rail; the mute button is its bottom cell. -->
        <Border x:Name="Rail" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                Width="40" Background="{StaticResource PlayerRailBrush}" Opacity="0" IsHitTestVisible="False">
            <Border.OpacityTransition><ScalarTransition Duration="0:0:0.22" /></Border.OpacityTransition>
            <StackPanel x:Name="RailStack" Spacing="0">
                <Grid x:Name="VolumeTrack" Height="280" SizeChanged="OnVolumeTrackResized">
                    <local:PlayerSlider x:Name="VolumeSlider" x:Uid="PlayerPage_VolumeSlider" Style="{StaticResource BlockSliderStyle}"
                            Orientation="Vertical" Width="40" Minimum="0" Maximum="{x:Bind ViewModel.VolumeMaximum, Mode=OneWay}"
                            StepFrequency="1" IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
                    <Border x:Name="VolumeHundredMark" Height="2" VerticalAlignment="Top" BorderThickness="6,0,6,0"
                            BorderBrush="{StaticResource PlayerStageBrush}" IsHitTestVisible="False" />
                    <TextBlock x:Name="VolumeText" Text="{x:Bind ViewModel.VolumeLabel, Mode=OneWay}" Margin="0,0,0,8"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="{StaticResource PlayerInkBrush}"
                               AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" />
                    <Grid x:Name="VolumeFilledLabel" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                        <Grid.Clip><RectangleGeometry x:Name="VolumeLabelClip" /></Grid.Clip>
                        <TextBlock Text="{x:Bind ViewModel.VolumeLabel, Mode=OneWay}" Margin="0,0,0,8"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="{StaticResource PlayerStageBrush}" />
                    </Grid>
                </Grid>
                <Button x:Name="MuteButton" x:Uid="PlayerPage_MuteButton" Click="OnToggleMute" Width="40" Height="40"
                        Style="{StaticResource OsdButtonStyle}" Padding="0" AutomationProperties.AcceleratorKey="M">
                    <FontIcon x:Name="MuteGlyph" Glyph="{x:Bind ViewModel.SoundGlyph, Mode=OneWay}" Style="{StaticResource RailGlyphStyle}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ================= 跳过片头/片尾 =================

             The one button here whose name is bound rather than written: what it says depends on what is
             being offered （跳过片头, 跳过片尾, 跳过预告）, so a fixed name would be wrong half the time.
             It needs a declared name at all because its content is a panel — a button announces its own
             content only when that content is text, and 「跳过片头」 sitting one level down inside a
             StackPanel is not text as far as the announcement is concerned. Measured: with the name
             removed this was the single control the narration probe reported as 哑的.

             No bottom inset here either: it sits above the transport bar, and the bar has no declared
             height at all — two auto rows and its padding, so its height is whatever its buttons and its
             fonts come to. PlayerPage.PlaceOverlays measures it. The 148 that used to be here was a guess
             at that height, and one larger font in the transport row would have had this offer drawn
             across the seek slider.

             厚度加倍（用户令 2026-09-26「跳过片头/片尾的按钮厚度*2」）：垂直 padding 14→28，圆角 20→28、
             行距 6→10、图标行距 8→10、倒计时条 2→4 一并跟上 —— 只加高不加这些，内容会在加厚后的壳里显得
             上下两块各漂各的；水平 padding 20→24 让左右留白和新的高度成比例。占位与避让仍由 PlaceOverlays
             量出来，这里没有需要跟着改的硬编码高度。

             悬停不再变透明（用户令 2026-09-26「鼠标移到按钮上的时候背景会变成透明的」）：默认模板的
             PointerOver/Pressed 态各拿一套系统 ThemeResource 盖底 —— 深色自定义底上就是「变透明」。修法与
             ProbeSeekTrack 修滑杆白条同款：在按钮自己的资源字典里把那四个键按回来，底用调色板新添的
             悬停/按下两支（同一个 Raised，悬停实一档、按下暗一档），边框照旧 PlayerEdgeStrongBrush。 -->
        <Button
            x:Name="SkipButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,28,0"
            Padding="24,28"
            Background="{StaticResource PlayerSkipBrush}"
            BorderBrush="{StaticResource PlayerEdgeStrongBrush}"
            BorderThickness="1"
            CornerRadius="28"
            Command="{x:Bind ViewModel.TakeSkipCommand}"
            AutomationProperties.Name="{x:Bind ViewModel.SkipCaption, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.SkipVisibility, Mode=OneWay}">
            <Button.Resources>
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="PlayerSkipHoverBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="PlayerSkipPressedBrush" />
                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PlayerEdgeStrongBrush" />
                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PlayerEdgeStrongBrush" />
            </Button.Resources>
            <StackPanel x:Name="SkipStack" Spacing="10">
                <StackPanel x:Name="SkipRow" Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="SkipGlyph" Glyph="&#xE893;" Style="{StaticResource OsdGlyphStyle}" />
                    <TextBlock x:Name="SkipText" Text="{x:Bind ViewModel.SkipCaption, Mode=OneWay}" FontSize="{StaticResource EgSubheadFontSize}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SkipTip" Text="{x:Bind ViewModel.SkipTip, Mode=OneWay}" Foreground="{StaticResource PlayerInkFaintBrush}" FontSize="{StaticResource EgCaptionFontSize}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- The offer's own fifteen seconds, drawn rather than merely counted: a button that is
                     about to lapse should look like one. SkipPrompt.Remaining runs 1 down to 0.

                     Raw, like the other three bars that are pictures of something already said in words:
                     inside a button it would otherwise be read out as a second child with a percentage,
                     and 「跳过片头 15 秒后消失 · 87%」 is not the button's name. -->
                <ProgressBar
                    x:Name="SkipCountdown"
                    Height="4"
                    Maximum="1"
                    Minimum="0"
                    Value="{x:Bind ViewModel.SkipRemaining, Mode=OneWay}"
                    AutomationProperties.AccessibilityView="Raw"
                    Background="{StaticResource PlayerLineBrush}"
                    Foreground="{StaticResource PlayerInkFaintBrush}" />
            </StackPanel>
        </Button>

        <!-- The timeline shares the bottom edge with uosc; its controls sit above it.
             2026-09-27 晚用户令「移除集成模式进度条上方的一大块背景」：控制条原先铺的那层半透明近黑
             （PlayerGlassBrush，不透明度 GlassAlpha=0x40）整块撤掉 —— 按钮与进度条现在直接压在画面上。
             进度条那一行仍有自己的轨道底（SeekTrack 的 PlayerRailBrush），所以拖拽目标照旧看得见；
             只去掉「按钮那一行」背后那块罩子。标题条（TitleStrip）那支玻璃不受影响。 -->
        <Grid x:Name="Bar" VerticalAlignment="Bottom"
              SizeChanged="OnBarResized" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="31" /></Grid.RowDefinitions>
            <Grid x:Name="TransportRow" Margin="8,8,8,8" ColumnSpacing="2" SizeChanged="OnTransportResized">
                <!-- 按钮条按指针离底边的近度淡入（用户令 2026-09-27「参独占模式鼠标位置越靠近窗口下方按钮条
                     越明显」）：强度是 ChromeReveal.BarStrength，页面写在这一行的 Opacity 上；进度条（下面的
                     SeekTrack）用同一条强度长高。只淡按钮这一行，进度条那一行另走裁剪生长。 -->
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.22" />
                </Grid.OpacityTransition>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TransportLeft" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                    <Button x:Name="PreviousButton" x:Uid="PlayerPage_PreviousButton" Style="{StaticResource TransportButtonStyle}" Command="{x:Bind ViewModel.PreviousEpisodeCommand}">
                        <FontIcon Glyph="&#xE892;" Style="{StaticResource TransportGlyphStyle}" />
                    </Button>
                    <Button x:Name="PlayButton" x:Uid="PlayerPage_PlayButton" Style="{StaticResource TransportButtonStyle}" Command="{x:Bind ViewModel.TogglePauseCommand}" AutomationProperties.AcceleratorKey="Space">
                        <FontIcon x:Name="PlayGlyph" Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" Style="{StaticResource TransportGlyphStyle}" />
                    </Button>
                    <Button x:Name="NextButton" x:Uid="PlayerPage_NextButton" Style="{StaticResource TransportButtonStyle}" Command="{x:Bind ViewModel.NextEpisodeCommand}">
                        <FontIcon Glyph="&#xE893;" Style="{StaticResource TransportGlyphStyle}" />
                    </Button>
                    <Button x:Name="TransportStatsButton"  Style="{StaticResource TransportButtonStyle}" Command="{x:Bind ViewModel.CycleStatsCommand}" AutomationProperties.Name="统计" ToolTipService.ToolTip="统计">
                        <FontIcon Glyph="&#xE9D9;" Style="{StaticResource TransportGlyphStyle}" />
                    </Button>
                    <Button x:Name="ChapterButton"  Style="{StaticResource TransportButtonStyle}" AutomationProperties.Name="章节" ToolTipService.ToolTip="章节">
                        <FontIcon Glyph="&#xE8FD;" Style="{StaticResource TransportGlyphStyle}" />
                        <Button.Flyout><MenuFlyout x:Name="ChapterMenu" Placement="Top" Opening="OnChapterMenuOpening" /></Button.Flyout>
                    </Button>
                    <Button x:Name="EpisodeButton" x:Uid="PlayerPage_EpisodeButton" Style="{StaticResource TransportButtonStyle}">
                        <FontIcon Glyph="&#xE8F1;" Style="{StaticResource TransportGlyphStyle}" />
                        <Button.Flyout><MenuFlyout x:Name="EpisodeMenu" Placement="Top" Opening="OnEpisodeMenuOpening" /></Button.Flyout>
                    </Button>
                    <Button x:Name="VersionButton" x:Uid="PlayerPage_VersionButton" Style="{StaticResource TransportButtonStyle}">
                        <FontIcon Glyph="&#xE8B7;" Style="{StaticResource TransportGlyphStyle}" />
                        <Button.Flyout><MenuFlyout x:Name="VersionMenu" Placement="Top" Opening="OnVersionMenuOpening" /></Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="TransportMiddle" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                    <Button x:Name="PreviousChapterButton" VerticalAlignment="Bottom"  Style="{StaticResource TransportButtonStyle}" Click="OnPreviousChapter" AutomationProperties.Name="上一章节" ToolTipService.ToolTip="上一章节">
                        <FontIcon Glyph="&#xE892;" Style="{StaticResource TransportGlyphStyle}" />
                    </Button>
                    <Grid x:Name="SpeedStrip" Width="146" Height="42" Background="{StaticResource PlayerRailBrush}">
                        <local:PlayerSlider x:Name="InlineSpeedSlider" Style="{StaticResource BlockSliderStyle}"
                                            Minimum="0.1" Maximum="20" StepFrequency="0.1" SmallChange="0.1" LargeChange="0.5"
                                            Foreground="Transparent" IsThumbToolTipEnabled="False"
                                            Value="{x:Bind ViewModel.SpeedValue, Mode=TwoWay}" AutomationProperties.Name="播放速度"
                                            ToolTipService.ToolTip="滚轮调速，左右拖动，右键恢复 1×" />
                        <TextBlock Text="{x:Bind ViewModel.SpeedLabel, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Foreground="{StaticResource PlayerInkBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                        <Canvas x:Name="SpeedNotches" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                        <Path Data="M 0,4 L 4,0 L 8,4 Z" Fill="{StaticResource PlayerInkBrush}" HorizontalAlignment="Center"
                              VerticalAlignment="Bottom" Margin="0,0,0,2" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <Button x:Name="SpeedButton"
                x:Uid="PlayerPage_SpeedButton" Content="{x:Bind ViewModel.SpeedLabel, Mode=OneWay}" Style="{StaticResource TransportButtonStyle}" Width="64" Visibility="Collapsed">
                        <Button.Flyout>
                            <Flyout x:Name="SpeedWheelFlyout" Placement="Top" Opened="OnSpeedWheelOpened" Closed="OnSpeedWheelClosed">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <!-- 壳一层全部脱掉：底、边、内边距、圆角、阴影都归下面这块面板自己画，
                                             否则菜单壳的浅色底会从轮盘四周露出一圈。 -->
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="CornerRadius" Value="0" />
                                        <Setter Property="IsDefaultShadowEnabled" Value="False" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <Border
                                    x:Name="SpeedWheelPanel"
                                    Width="104"
                                    Height="252"
                                    Background="{StaticResource PlayerRailBrush}"
                                    CornerRadius="20">
                                    <Grid>
                                        <!-- 中线高亮带：当前值停的那一格。IsHitTestVisible=False —— 拖拽的
                                             手从头到尾只归面板一家记，刻度与高亮带都不许抢。 -->
                                        <Border
                                            Height="40"
                                            Margin="10,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource PlayerTrackBrush}"
                                            CornerRadius="10"
                                            IsHitTestVisible="False" />
                                        <!-- 刻度带：刻度由代码摆上来（PlayerPage.SpeedWheel.BuildSpeedWheel），
                                             Canvas.Top 按 SpeedWheel.TickOffset 逐拍走。 -->
                                        <Canvas x:Name="SpeedWheelTrack" />
                                    </Grid>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="NextChapterButton" VerticalAlignment="Bottom"  Style="{StaticResource TransportButtonStyle}" Click="OnNextChapter" AutomationProperties.Name="下一章节" ToolTipService.ToolTip="下一章节">
                        <FontIcon Glyph="&#xE893;" Style="{StaticResource TransportGlyphStyle}" />
                    </Button>
                </StackPanel>
                <StackPanel x:Name="TransportRight" Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                    <!-- 字幕、音轨与全屏之间的空位（用户令 2026-09-29「集成模式右下角的字幕和音轨键向左移一个键的
                         空位（参考独占模式）」）：独占那边是 uosc 控制条音频与全屏之间的 `gap:1`（main.lua
                         EMBYNIAN[controls]），净宽＝行内缝＋一格（窗口 2＋32、全屏 3＋42）。这边把空位写成
                         AudioButton 的右边距（＝格宽，XAML 初值 32 是窗口档），行缝由 StackPanel 的 Spacing 在
                         它右侧补上，全屏键照旧钉在右缘；全屏/最大化档随 ApplyTransportScale 摆成 42。 -->
                    <Button x:Name="SubtitleButton" x:Uid="PlayerPage_SubtitleButton" Style="{StaticResource TransportButtonStyle}" >
                        <FontIcon Glyph="&#xED1E;" Style="{StaticResource TransportGlyphStyle}" />
                        <Button.Flyout><MenuFlyout x:Name="SubtitleMenu" Placement="Top" Opening="OnSubtitleMenuOpening" /></Button.Flyout>
                    </Button>
                    <Button x:Name="AudioButton" x:Uid="PlayerPage_AudioButton" Style="{StaticResource TransportButtonStyle}" Margin="0,0,32,0" >
                        <FontIcon Glyph="&#xE8D6;" Style="{StaticResource TransportGlyphStyle}" />
                        <Button.Flyout><MenuFlyout x:Name="AudioMenu" Placement="Top" Opening="OnAudioMenuOpening" /></Button.Flyout>
                    </Button>
                    <Button x:Name="FullscreenButton" x:Uid="PlayerPage_FullscreenButton" Style="{StaticResource TransportButtonStyle}" Click="OnToggleFullscreen" AutomationProperties.AcceleratorKey="F">
                        <FontIcon x:Name="FullscreenGlyph" Glyph="&#xE740;" Style="{StaticResource TransportGlyphStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid x:Name="SeekTrack" Grid.Row="1" Height="31" VerticalAlignment="Bottom" Background="Transparent" SizeChanged="OnSeekTrackResized">
                <!-- 进度条那一行自己的底（用户令 2026-09-28 晚「亚克力效果时有时无，去掉亚克力效果吧」）：
                     2026-09-28 白天它曾是「视频取样底图 ＋ AcrylicBrush」两层（取样成功才摆上来），但取样被
                     seek/拖动/换片一次次作废，两层跟着一次次熄掉 —— 用户看到的就是「时有时无」。两层都拆了，
                     TimelineMaterial 只剩一支**恒定**的半透明底色：高级效果开着是 _timelineFallback
                     （TimelineChapterMap.Background 的 0x70），关了是实色 _timelinePaper，高对比度是系统底色
                     —— 换挡逻辑在 UpdateTimelineMaterial，与亚克力时代相同，只是不再有「取样成功才显示」的那一档。
                     独占模式 uosc 时间轴压在画面上的也是一层恒定的半透明深色，两边现在一致。 -->
                <Grid x:Name="TimelineMaterial" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <local:PlayerSlider x:Name="SeekSlider" x:Uid="PlayerPage_SeekSlider" Style="{StaticResource BlockSliderStyle}"
                        Minimum="0" Maximum="1000" StepFrequency="0.001" VerticalAlignment="Stretch"
                        IsThumbToolTipEnabled="False" Value="{x:Bind ViewModel.SeekValue, Mode=TwoWay}" />
                <Canvas x:Name="CacheBar" AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" />
                <Canvas x:Name="TimelineSections" AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" />
                <Border Height="1" VerticalAlignment="Top" Background="{StaticResource PlayerStageBrush}" IsHitTestVisible="False" />
                <Canvas x:Name="ChapterTicks" Height="1" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" />
                <Canvas x:Name="TimelineLoops" AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" />
                <Grid x:Name="TimelineLabels" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                    <TextBlock x:Name="PositionText" Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.PositionClock, Mode=OneWay}" Foreground="{StaticResource PlayerInkBrush}" />
                    <TextBlock x:Name="DurationText" Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.RemainingClock, Mode=OneWay}" Foreground="{StaticResource PlayerInkBrush}" />
                    <TextBlock x:Name="TimelineBufferedText" HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontSize="{StaticResource EgCaptionFontSize}" Foreground="{StaticResource PlayerInkBrush}" Opacity="0.6" Visibility="Collapsed" />
                </Grid>
                <Grid x:Name="TimelinePlayedLabels" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                    <Grid.Clip><RectangleGeometry x:Name="TimelineLabelClip" /></Grid.Clip>
                    <TextBlock Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.PositionClock, Mode=OneWay}" Foreground="{StaticResource PlayerStageBrush}" />
                    <TextBlock Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.RemainingClock, Mode=OneWay}" Foreground="{StaticResource PlayerStageBrush}" />
                    <TextBlock x:Name="TimelineBufferedPlayedText" HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontSize="{StaticResource EgCaptionFontSize}" Foreground="{StaticResource PlayerStageBrush}" Opacity="0.6" Visibility="Collapsed" />
                </Grid>
                <Border x:Name="SeekHoverLine" Width="1" Opacity="0.33" HorizontalAlignment="Left" Background="{StaticResource PlayerInkBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <!-- ================= 浮层收起时的细进度线 =================
             Two pixels at the very bottom edge, shown only while the chrome is hidden: with the bar
             gone there is nothing on screen that says how far in we are, and the answer is worth two
             pixels. Not hit-testable — reaching for it reveals the real bar, which is the thing that
             can be dragged. Inverse of Bar's visibility, so the two are never both up. -->
        <Grid x:Name="ThinLine" Height="2" VerticalAlignment="Bottom"
              AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" Visibility="Collapsed">
            <ProgressBar x:Name="ThinProgress" Height="2" Maximum="1" Minimum="0"
                         Value="{x:Bind ViewModel.ThinFraction, Mode=OneWay}"
                         Background="{StaticResource PlayerLineBrush}" Foreground="{StaticResource PlayerInkSoftBrush}" />
            <Canvas x:Name="ThinTimelineCache" />
            <Canvas x:Name="ThinTimelineSections" />
        </Grid>

        <!-- ================= 暂停/播放提示 =================
             「暂停后显示一秒暂停图标就行（开启播放也弄个一秒的动画），别什么进度条标题音量条都持久显示在
             画面上」. Pausing used to pin the whole chrome — bar, title strip and volume rail — for as long
             as the file stayed paused, on the reasoning that a frozen frame has nothing to watch so the way
             out should stay visible. But 「the way out」 is one bit of information, and three overlays is not
             how you spell it: they cover the frame the pause was called to look at. So the pin is gone (see
             OnStatusApplied) and this is what says it instead — one glyph, in the middle, for a second.

             The one animation in this file, and the exception to the header's 「no storyboards anywhere」.
             That rule is about reveals the pointer asks for: a control you are already reaching for must be
             there the instant you arrive, and a fade only delays it. This is the opposite kind of thing —
             nobody is reaching for it, it appears and leaves on its own, and 「弄个一秒的动画」 is the request.
             A badge that simply blinked on and off for a second would read as a glitch; growing and fading
             reads as an acknowledgement.

             Not hit-testable, and starts collapsed with zero opacity so a layout pass before the first
             pause cannot flash it.

             「不要黑色的圆形边框，只要白色的三角形就可以，然后再放大一些」 took away the dark plate and its
             hairline ring; 「暂停和开始的图标太丑了弄一个白色三角形方块和两个白色的长方块就可以」 took away the
             icon font as well; and 「点击画面暂停和开始的图标要纯白色，去掉灰色」 (2026-09-05) took away the last
             thing that was not white — the same geometry stroked more heavily behind it, which came out as a
             5-pixel grey rim hugging the shape. What is left is one white shape, and the cost of that is
             recorded rather than argued with: over a nearly white frame it is not visible at all.

             「播放页面暂停和开始的图标太丑了，你换一个」 (2026-09-06) is the latest word, and this time what he
             was looking at was the shape itself: sharp-corners-plus-stroke comes out hard-edged, every corner
             rounded only six pixels and the play triangle ending in a point. PulseArt now draws the rounded
             corners into the geometry — pause is two capsule bars (corner radius = half the bar width), play a
             triangle whose base corners round 12 and whose tip rounds 22 — at the same outer sizes as before,
             so the swap changes the softness and not the weight. Fill only: with the corners in the geometry
             there is no stroke to fill, and the self-check holds that line.

             The Canvas must keep its Width and Height. A Canvas does not measure its children, so dropping
             them measures the whole badge as 0×0 — nothing on screen, and every other reading still correct.
             It is a Canvas rather than a Grid so the path draws from (0,0) and is therefore centred by
             construction: inside a Grid it would be centred on its own DesiredSize instead, which is what the
             box's own margin (PulseArt.Box) is there to leave room for. -->
        <Border
            x:Name="PulseBadge"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Canvas x:Name="PulseArtBox" Width="136" Height="136">
                <Path
                    x:Name="PulseShape"
                    Fill="{StaticResource PlayerPulseBrush}" />
            </Canvas>
        </Border>
        <!-- ================= 章节缩略图 =================
             Emby's own chapter still for wherever the pointer is over the seek bar. The server drew
             these when it scanned the file, so this is a cache read rather than a decode — mpv cannot
             be asked for a frame it is not currently showing without seeking to it, and seeking to
             every pixel the pointer crosses is not a preview.

             A server that extracted no chapter images has none to send, and quite a few do not: the
             extraction is off by default on some builds and skipped for some containers. So the picture
             is collapsed rather than left as an empty frame — 「预览没有画面」 was a 212×119 hole with a
             chapter name under it — and what is left is an honest chip: which chapter, and the moment
             the pointer is on.

             Each of the three lines stands on its own, because a file can be missing any of them. No
             chapter marks at all — which is a whole class of server, not an edge case — leaves the time
             by itself, and that is still worth showing: the slider's own tooltip appears only while the
             thumb is being dragged, so hovering the bar would otherwise read as nothing at all.

             Positioned in code: Left/Top alignment plus a TranslateTransform the page sets from
             SeekTrack's own position, which is the only way the popup can sit above the bar without
             this file knowing how tall the bar happens to be. -->
        <Border
            x:Name="ChapterPeek"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Padding="4"
            AutomationProperties.AccessibilityView="Raw"
            Background="{StaticResource PlayerPeekBrush}"
            BorderBrush="{StaticResource PlayerEdgeBrush}"
            BorderThickness="1"
            CornerRadius="2"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ChapterPeekOffset" />
            </Border.RenderTransform>
            <StackPanel Spacing="4">
                <Image
                    x:Name="ChapterImage"
                    Source="{x:Bind ViewModel.ChapterStill, Mode=OneWay}"
                    Width="212"
                    Height="119"
                    Stretch="UniformToFill"
                    Visibility="{x:Bind ViewModel.ChapterStillVisibility, Mode=OneWay}" />
                <TextBlock
                    x:Name="ChapterCaption"
                    FontSize="{StaticResource EgCaptionFontSize}"
                    Foreground="{StaticResource PlayerInkSoftBrush}"
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    MaxLines="3"
                    MaxWidth="360"
                    TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.ChapterCaption, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind ViewModel.ChapterCaptionVisibility, Mode=OneWay}" />

                <!-- The hovered moment. The slider's own thumb tooltip only appears while the thumb is
                     being dragged, so hovering the track had no time readout at all. -->
                <TextBlock
                    x:Name="ChapterClock"
                    FontFamily="Consolas,Cascadia Mono,Segoe UI"
                    FontSize="{StaticResource EgCaptionFontSize}"
                    Foreground="{StaticResource PlayerInkDimBrush}"
                    HorizontalAlignment="Center"
                    Text="{x:Bind ViewModel.ChapterClock, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- ================= 换集时的遮挡层 =================
             Requirement 12. The video surface and mpv's child inside it both stay alive across an
             episode change, which is what stops the window from collapsing and rebuilding — but it
             also means the last frame of the finished episode sits there while mpv tears down one
             file and opens the next at whatever size and format it turns out to be. Nothing is wrong
             with the decode; it is simply nobody's job to have painted over it. This is that job.

             Opaque, and above everything else in the grid, so it cannot lose the race the WinForms
             cover kept losing. -->
        <!-- 换集时立即盖住旧帧；首帧与输出尺寸就绪之后再淡出，见 PlayerPage.Cover.cs。 -->
        <Grid x:Name="Cover" Background="{StaticResource PlayerCoverBrush}" Visibility="Collapsed">
            <!-- 「视频刚开播还在加载缓存没有正片画面时背景要用背景图，全屏播放时背景图要占满全屏，别只在
                 左上角显示」（2026-09-15）。遮罩网格本身铺满整个窗口（全屏时就是整个屏幕），垫底图用
                 UniformToFill 跟着占满、不留边也不变形；压到半透明，进度环和文字才读得清，取不到图时
                 Source 为空，垫底照旧退回纯色。装饰图，不参与命中与朗读。 -->
            <Grid x:Name="CoverArtwork" Opacity="0.5" IsHitTestVisible="False"
                  AutomationProperties.AccessibilityView="Raw">
                <Grid.Background>
                    <ImageBrush ImageSource="{x:Bind ViewModel.CoverBackdrop, Mode=OneWay}"
                                Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                </Grid.Background>
            </Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <!-- IsActive follows the cover rather than sitting on True. A ProgressRing animates through
                     the compositor, which does not stop because an ancestor is collapsed — and this page is
                     built when the shell starts, so a ring left active would be spinning behind a collapsed
                     grid from launch until exit, for every minute the app is not changing episodes. Bound to
                     CoverUp rather than to the Visibility it produces so there is one source for the state. -->
                <ProgressRing
                    x:Name="CoverRing"
                    IsActive="{x:Bind ViewModel.CoverUp, Mode=OneWay}"
                    Width="40"
                    Height="40"
                    AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="CoverText" HorizontalAlignment="Center" Foreground="{StaticResource PlayerInkDimBrush}" Text="{x:Bind ViewModel.CoverMessage, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </local:PictureSurface>
</UserControl>
