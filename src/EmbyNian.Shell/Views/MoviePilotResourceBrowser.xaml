<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EmbyNian.Shell.Views.MoviePilotResourceBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmbyNian.Shell.ViewModels">
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.FiltersVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterText" Header="在结果中筛选" PlaceholderText="标题、副标题或标签；空格分隔多个词"
                    Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8"
                    Style="{StaticResource EgCaptionStyle}" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
            </Grid>
            <Expander x:Name="FilterExpander" Header="筛选与排序" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="SiteFilter" Header="站点" HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Sites, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedSite, Mode=TwoWay}" />
                    <ComboBox x:Name="ResolutionFilter" Grid.Column="1" Header="清晰度" HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Resolutions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedResolution, Mode=TwoWay}" />
                    <ComboBox x:Name="LabelFilter" Grid.Column="2" Header="标签" HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Labels, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedLabel, Mode=TwoWay}" />
                    <ComboBox x:Name="PromotionFilter" Grid.Row="1" Header="优惠" HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind ViewModel.PromotionIndex, Mode=TwoWay}">
                        <x:String>全部优惠</x:String><x:String>免费下载</x:String><x:String>有优惠</x:String>
                    </ComboBox>
                    <ComboBox x:Name="DateFilter" Grid.Row="1" Grid.Column="1" Header="发布时间" HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind ViewModel.DateIndex, Mode=TwoWay}">
                        <x:String>不限时间</x:String><x:String>最近 24 小时</x:String><x:String>最近 7 天</x:String><x:String>最近 30 天</x:String><x:String>最近 90 天</x:String>
                    </ComboBox>
                    <ComboBox x:Name="SortOrder" Grid.Row="1" Grid.Column="2" Header="排序" HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                        <x:String>站点原始顺序</x:String><x:String>做种最多</x:String><x:String>发布时间最新</x:String><x:String>体积最小</x:String><x:String>体积最大</x:String>
                    </ComboBox>
                    <CheckBox x:Name="SeededFilter" Grid.Row="2" Content="仅有做种"
                        IsChecked="{x:Bind ViewModel.SeededOnly, Mode=TwoWay}" />
                    <CheckBox x:Name="HitAndRunFilter" Grid.Row="2" Grid.Column="1" Content="排除 HR"
                        IsChecked="{x:Bind ViewModel.ExcludeHitAndRun, Mode=TwoWay}" />
                    <Button x:Name="ResetFilters" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" Content="清除筛选"
                        Command="{x:Bind ViewModel.ResetCommand}" Style="{StaticResource EgSecondaryButtonStyle}" />
                </Grid>
            </Expander>
        </StackPanel>
        <Grid Grid.Row="1">
            <ListView x:Name="ResourceList" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MoviePilotResourceRow">
                        <Grid Padding="14" RowSpacing="7" Background="{ThemeResource EgSurfaceBrush}"
                            BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource EgCardCornerRadius}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Padding="8,2" Background="{ThemeResource EgSurfaceAltBrush}" CornerRadius="{StaticResource EgPosterCornerRadius}"
                                    VerticalAlignment="Top" Visibility="{x:Bind SiteVisibility}">
                                    <TextBlock Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" Text="{x:Bind SiteName}" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource EgCaptionStyle}" Text="{x:Bind PromotionText}"
                                    TextWrapping="Wrap" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind PromotionHint}" />
                            </Grid>
                            <TextBlock Grid.Row="1" Style="{StaticResource EgBodyStyle}" Text="{x:Bind Title}" TextWrapping="Wrap"
                                MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}"
                                Text="{x:Bind Description}" Visibility="{x:Bind DescriptionVisibility}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Row="3" Spacing="4">
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}"
                                    Text="{x:Bind LabelsText}" Visibility="{x:Bind LabelsVisibility}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextDimBrush}"
                                    Text="{x:Bind MetaLine}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgTextFaintBrush}"
                                    Text="{x:Bind PublishedLine}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button x:Name="OpenTorrentPage" Content="种子页面" Command="{x:Bind OpenDetailsCommand}"
                                    Style="{StaticResource EgSecondaryButtonStyle}" AutomationProperties.Name="{x:Bind DetailsAutomationName}"
                                    ToolTipService.ToolTip="{x:Bind DetailsHint}" />
                                <Button x:Name="DownloadResource" Content="{x:Bind DownloadLabel, Mode=OneWay}" Command="{x:Bind DownloadCommand}"
                                    Style="{StaticResource EgPrimaryButtonStyle}" AutomationProperties.Name="{x:Bind DownloadAutomationName}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock Margin="20,32" HorizontalAlignment="Center" VerticalAlignment="Top"
                Style="{StaticResource EgBodyStyle}" Text="没有符合筛选条件的资源，可清除筛选后重试。"
                TextWrapping="Wrap" TextAlignment="Center" Visibility="{x:Bind ViewModel.NoMatchesVisibility, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
