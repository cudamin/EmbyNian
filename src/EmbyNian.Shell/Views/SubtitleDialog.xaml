<?xml version="1.0" encoding="utf-8"?>
<!--
  「搜索和修改字幕」。一张表上两件事：这个文件现在挂着哪几条外挂字幕（可以删），和按语言去刮削源上搜一批
  （可以下）。

  没有「确定」键，只有「关闭」：删和下都是按下那一行的按钮当场就做的，没有一个「保存」时刻。表关掉之后
  ItemCommands 才决定要不要让这一页重读（见 Touched）。
-->
<ContentDialog
    x:Class="EmbyNian.Shell.Views.SubtitleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EmbyNian.Shell.Views"
    Title="搜索和修改字幕"
    CloseButtonText="关闭">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <!-- MinWidth 而不是 Width：这张表里两个列表本身没有宽度，光靠内容撑的话整张表会缩成三百来像素宽，
         而写死一个宽度在小窗口上会被裁掉右边那颗按钮。 -->
    <StackPanel MinWidth="560" Spacing="12">
        <TextBlock Style="{StaticResource EgSectionTitleStyle}" Text="现有的外挂字幕" />

        <TextBlock
            x:Name="NoTracks"
            Style="{StaticResource EgDataStyle}"
            Text="这个文件上没有外挂字幕（内嵌在视频文件里的那些不能在这里删）。"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <ItemsControl x:Name="Tracks">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="views:SubtitleTrack">
                    <Grid ColumnSpacing="12" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            MaxLines="1"
                            Style="{StaticResource EgBodyStyle}"
                            Text="{x:Bind Label}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />

                        <Button
                            Click="OnDelete"
                            Content="删除"
                            Grid.Column="1" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource EgRuleStyle}" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 名字不叫 Language：那和 FrameworkElement.Language 撞名，生成的字段会隐藏基类那个属性
                 （CS0108）。 -->
            <ComboBox
                x:Name="LanguageBox"
                Header="语言"
                MinWidth="140" />

            <Button
                x:Name="SearchButton"
                Click="OnSearch"
                Content="搜索字幕"
                Grid.Column="1"
                Style="{StaticResource AccentButtonStyle}"
                VerticalAlignment="Bottom" />

            <ProgressRing
                x:Name="Busy"
                Grid.Column="2"
                HorizontalAlignment="Left"
                IsActive="False"
                VerticalAlignment="Bottom" />
        </Grid>

        <TextBlock
            x:Name="Status"
            Style="{StaticResource EgDataStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <ListView
            x:Name="Results"
            MaxHeight="260"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:SubtitleCandidate">
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                MaxLines="1"
                                Style="{StaticResource EgBodyStyle}"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                MaxLines="1"
                                Style="{StaticResource EgDataStyle}"
                                Text="{x:Bind Detail}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button
                            Click="OnDownload"
                            Content="下载"
                            Grid.Column="1"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
