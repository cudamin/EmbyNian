<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EmbyNian.Shell.Views.ServerDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmbyNian.Shell.ViewModels"
    Background="{ThemeResource EgWindowBrush}">
    <Page.Resources>
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource EgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource EgBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource EgCardCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>
    <Grid x:Name="PageLayout" Padding="0,0,4,0" RowSpacing="16" SizeChanged="OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="控制台" Style="{StaticResource EgSectionTitleStyle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{x:Bind ViewModel.Updated, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ServerDashboardMoreButton" AutomationProperties.Name="服务器选项" ToolTipService.ToolTip="服务器选项">
                    <FontIcon Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="ServerRenameMenuItem" Text="更改服务器的显示名称"
                                Icon="Edit" Command="{x:Bind ViewModel.RenameServerCommand}" />
                            <MenuFlyoutItem x:Name="ServerInformationMenuItem" Text="查看服务器信息"
                                IsEnabled="{x:Bind ViewModel.HasSnapshot, Mode=OneWay}" Click="OnServerInformation">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ServerDashboardPowerButton" AutomationProperties.Name="服务器电源" ToolTipService.ToolTip="服务器电源">
                    <FontIcon Glyph="&#xE7E8;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="ServerRestartMenuItem" Text="重启 Emby Server"
                                Icon="Refresh" Command="{x:Bind ViewModel.RestartServerCommand}" />
                            <MenuFlyoutItem x:Name="ServerShutdownMenuItem" Text="关闭 Emby Server"
                                Command="{x:Bind ViewModel.ShutdownServerCommand}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="ServerDashboardRefreshButton" Command="{x:Bind ViewModel.RefreshCommand}" Content="刷新" />
                <Button x:Name="ServerDashboardWebButton" Click="OnOpenWebConsole" Content="网页控制台" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}" IsClosable="False"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.NoticeVisibility, Mode=OneWay}" />
        </StackPanel>
        <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
                <Border Style="{StaticResource DashboardCard}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource EgAccentSoftBrush}">
                                <FontIcon Glyph="&#xE968;" FontSize="{StaticResource EgTitleFontSize}" Foreground="{ThemeResource EgAccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="DashboardServerName" Text="{x:Bind ViewModel.ServerName, Mode=OneWay}"
                                    Style="{StaticResource EgSectionTitleStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.Health, Mode=OneWay}" Style="{StaticResource EgBodyStyle}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="服务器版本" Style="{StaticResource EgCaptionStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.Version, Mode=OneWay}" Style="{StaticResource EgDataStrongStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.OperatingSystem, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="在线设备" Style="{StaticResource EgCaptionStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.OnlineCount, Mode=OneWay}" Style="{StaticResource EgSectionTitleStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="正在播放" Style="{StaticResource EgCaptionStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.PlayingCount, Mode=OneWay}" Style="{StaticResource EgSectionTitleStyle}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource EgBorderBrush}" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="连接地址" Style="{StaticResource EgCaptionStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Address, Mode=OneWay}" Style="{StaticResource EgBodyStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            <TextBlock Text="局域网地址" Style="{StaticResource EgCaptionStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.LocalAddress, Mode=OneWay}" Style="{StaticResource EgBodyStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            <TextBlock Text="远程访问地址" Style="{StaticResource EgCaptionStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.WanAddress, Mode=OneWay}" Style="{StaticResource EgBodyStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid x:Name="DashboardColumns" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource DashboardCard}" VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                            <TextBlock Text="在线设备" Style="{StaticResource EgSubheadStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="{x:Bind ViewModel.SessionsMessage, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                            <ItemsControl x:Name="DashboardSessionList" ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DashboardSessionRow">
                                        <Border BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind Device}" Style="{StaticResource EgSubheadStyle}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Client}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind User}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind State}" Style="{StaticResource EgCaptionStyle}" Foreground="{ThemeResource EgAccentBrush}" />
                                                <TextBlock Text="{x:Bind Media}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Playback}" Style="{StaticResource EgCaptionStyle}" Visibility="{x:Bind PlaybackVisibility}" TextWrapping="Wrap" />
                                                <ProgressBar Value="{x:Bind Progress}" Maximum="100" Visibility="{x:Bind ProgressVisibility}" AutomationProperties.Name="播放进度" />
                                                <TextBlock Text="{x:Bind LastActive}" Style="{StaticResource EgCaptionStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ActivityCard" Grid.Column="1" Style="{StaticResource DashboardCard}" VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                            <TextBlock Text="活动记录" Style="{StaticResource EgSubheadStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="{x:Bind ViewModel.ActivitySummary, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ActivityMessage, Mode=OneWay}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" />
                            <ItemsControl x:Name="DashboardActivityList" ItemsSource="{x:Bind ViewModel.Activities, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DashboardActivityRow">
                                        <Border BorderBrush="{ThemeResource EgBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource EgBodyStyle}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource EgCaptionStyle}" TextWrapping="Wrap" Visibility="{x:Bind DetailVisibility}" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind Date}" Style="{StaticResource EgCaptionStyle}" />
                                                    <TextBlock Text="{x:Bind Severity}" Style="{StaticResource EgCaptionStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
