<?xml version="1.0" encoding="utf-8"?>
<!--
  页头那块牌子：每一页最上面那一块。

  **2026-09-06 按 WinUI-Gallery 那套重排**（「参考这个重新设计 ui 界面」，他选的是「整套重画」那一档）。
  Gallery 每一页的头是两行加一条线 —— 大标题，底下一行说明，然后一道分隔线；这里现在就是那个形状：

      电视节目                                      ［排序 视图 筛选］
      LIBRARY · 312 项
      ────────────────────────────────────────────────────────────

  换掉的是从前那一版「眉字在左上、读数在右上、标题在第二行」：那一版把「这是哪一区」和「多少项」摆成同一行的
  两端，于是页面最靠上的一行是两块小字，最大的那行字反倒在第二行 —— 而一页最该先被读到的就是它叫什么。
  **`Eyebrow` 和 `Note` 两个属性一个都没删**，它们现在合成底下那一行说明（中间一个「·」），所以七个页面的标记
  一个字都不用改，而 `LibraryRequest.Eyebrow` 那份「这是搜索还是剧季还是类型」的信息也照旧在屏上。

  **标签栏上写着「主页」而这里又写一次，是有意的，不是重复没清掉**：Gallery 自己也这样（左边导航写 Button，
  页面标题也写 Button）—— 一个是控件说「你选了哪一格」，一个是内容说「这一页是什么」，而页面滚下去之后只有
  后者跟着走。

  Trailing 是标题右边那一格，给页面自己的工具条（LibraryPage 的排序/视图/筛选就在那儿）。窗口窄到放不下
  时把 TrailingBelow 打开，那一格整块挪到线下面去靠右排 —— 挪的是同一个 ContentPresenter，不是两份拷贝，
  所以工具条不会有两套键盘顺序。
-->
<UserControl
    x:Class="EmbyNian.Shell.Views.PageSlate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="TitleText"
            MaxLines="1"
            Style="{StaticResource EgPageTitleStyle}"
            TextTrimming="CharacterEllipsis" />

        <!-- 起始位置是标题右边这一格；TrailingBelow 会把它搬到第 3 行去。 -->
        <ContentPresenter
            x:Name="TrailingHost"
            Grid.Column="1"
            Margin="12,0,0,0"
            VerticalAlignment="Bottom" />

        <!-- 说明那一行 —— Gallery 的页头里标题底下那一行灰字。这里装的是 Eyebrow ＋ Note 合起来的一句
             （「LIBRARY · 312 项」），走读数字（等宽、12 号、暗一档）：它多半是数字，而这一套里数字一律等宽。
             ColumnSpan 2，因为工具条在标题那一行的右边，这一行整条是它自己的。 -->
        <TextBlock
            x:Name="NoteText"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,2,0,0"
            MaxLines="1"
            Style="{StaticResource EgDataStyle}"
            TextTrimming="CharacterEllipsis" />

        <!-- 通栏线。ColumnSpan 2 是它「通栏」的全部实现 —— 内容和线同宽，所以页头和下面的内容左右都对齐。
             压在剧照上时收起，见 PageSlate.OnScrim：那一条线是「线上是哪儿、线下是内容」的分界，而图上
             没有线下面那一半。 -->
        <Border
            x:Name="Rule"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="0,8,0,0"
            Style="{StaticResource EgRuleStyle}" />
    </Grid>
</UserControl>
