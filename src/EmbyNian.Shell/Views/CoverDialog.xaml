<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Uid="CoverDialog_ContentDialog1"
    x:Class="EmbyNian.Shell.Views.CoverDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EmbyNian.Shell.Views"
    DefaultButton="Primary"
    PrimaryButtonText="完成">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1080</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="{StaticResource EgSpaceL}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Notice"
            Style="{StaticResource EgDataStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <Button x:Name="RefreshArtworkButton"
            Grid.Row="1"
            Click="OnRefreshArtwork"
            Content="刷新图片列表"
            Style="{StaticResource EgSecondaryButtonStyle}" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource EgSpaceXL}">
                <ItemsControl x:Name="Slots" ItemsSource="{x:Bind Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid ItemWidth="{StaticResource EgArtworkCellWidth}"
                                MaximumRowsOrColumns="6" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:ArtworkSlot">
                            <StackPanel Margin="0,0,0,12" Spacing="{StaticResource EgSpaceS}"
                                Width="{StaticResource EgArtworkFrameWidth}">
                                <Button Click="OnSwap" Padding="0" Height="{x:Bind FrameHeight}"
                                    IsEnabled="{x:Bind Ready, Mode=OneWay}"
                                    AutomationProperties.AutomationId="ArtworkTile"
                                    AutomationProperties.Name="{x:Bind Hint, Mode=OneWay}"
                                    Style="{StaticResource EgArtworkTileStyle}"
                                    Tag="{x:Bind}" ToolTipService.ToolTip="{x:Bind Hint, Mode=OneWay}">
                                    <Grid>
                                        <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill"
                                            Visibility="{x:Bind HasPicture, Mode=OneWay}" />
                                        <FontIcon Glyph="&#xE710;" Style="{StaticResource EgArtworkEmptyGlyphStyle}"
                                            Visibility="{x:Bind EmptyMark, Mode=OneWay}" />
                                    </Grid>
                                </Button>
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource EgDataStrongStyle}"
                                    Text="{x:Bind Caption}" TextTrimming="CharacterEllipsis" />
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="{StaticResource EgSpaceS}">
                                    <Button Click="OnSwap" IsEnabled="{x:Bind Ready, Mode=OneWay}"
                                        AutomationProperties.AutomationId="ChangeArtwork"
                                        AutomationProperties.Name="{x:Bind Hint, Mode=OneWay}"
                                        Style="{StaticResource EgIconButtonStyle}" Tag="{x:Bind}"
                                        ToolTipService.ToolTip="换一张（从刮削源挑，或者从本机传）">
                                        <FontIcon FontSize="14" Glyph="&#xE721;" />
                                    </Button>
                                    <Button Click="OnView" IsEnabled="{x:Bind CanDelete, Mode=OneWay}"
                                        AutomationProperties.AutomationId="ViewArtwork" AutomationProperties.Name="{x:Bind ViewName}"
                                        Style="{StaticResource EgIconButtonStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="看大图">
                                        <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                    </Button>
                                    <Button Click="OnDelete" IsEnabled="{x:Bind CanDelete, Mode=OneWay}"
                                        AutomationProperties.AutomationId="DeleteArtwork" AutomationProperties.Name="{x:Bind DeleteName}"
                                        Style="{StaticResource EgIconButtonStyle}" Tag="{x:Bind}"
                                        ToolTipService.ToolTip="删除这一种图（不可撤销）">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="{StaticResource EgSpaceM}">
                    <TextBlock Style="{StaticResource EgSectionTitleStyle}" Text="背景图" />
                    <ItemsControl x:Name="BackdropSlots" ItemsSource="{x:Bind Backdrops}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid ItemWidth="{StaticResource EgBackdropCellWidth}" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:ArtworkSlot">
                                <StackPanel Margin="0,0,0,12" Spacing="{StaticResource EgSpaceS}"
                                    Width="{StaticResource EgBackdropFrameWidth}">
                                    <Button Click="OnView" Padding="0" Height="{x:Bind FrameHeight}" IsEnabled="{x:Bind CanDelete, Mode=OneWay}"
                                        AutomationProperties.AutomationId="ArtworkTile" AutomationProperties.Name="{x:Bind ViewName}"
                                        Style="{StaticResource EgArtworkTileStyle}" Tag="{x:Bind}" ToolTipService.ToolTip="看大图">
                                        <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Button>
                                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource EgDataStyle}"
                                        Text="{x:Bind Caption}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="{StaticResource EgSpaceS}">
                                        <Button Click="OnSwap" IsEnabled="{x:Bind Ready, Mode=OneWay}"
                                            AutomationProperties.AutomationId="AddRemoteBackdrop" AutomationProperties.Name="{x:Bind Hint}"
                                            Style="{StaticResource EgIconButtonStyle}" Tag="{x:Bind}"
                                            ToolTipService.ToolTip="从刮削源另加一张（保留现有背景图）">
                                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                                        </Button>
                                        <Button Click="OnDelete" IsEnabled="{x:Bind CanDelete, Mode=OneWay}"
                                            AutomationProperties.AutomationId="DeleteArtwork" AutomationProperties.Name="{x:Bind DeleteName}"
                                            Style="{StaticResource EgIconButtonStyle}" Tag="{x:Bind}"
                                            ToolTipService.ToolTip="删掉这一张（不可撤销）">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="AddBackdropButton" Click="OnAddBackdrop" Style="{StaticResource EgSecondaryButtonStyle}"
                        AutomationProperties.Name="从本机再加一张背景图">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource EgSpaceS}">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Style="{StaticResource EgBodyStyle}" Text="从本机再加一张背景图…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
