<?xml version="1.0" encoding="utf-8"?>
<!--
  「修改媒体封面图」。一格一张候选封面：图在上、一行说明在下（哪家刮削源、多大、什么语言）。

  用 GridView 而不是列表：挑封面是用眼睛挑的，一行行的文字说明帮不上忙。缩略图由服务器代取（见
  EmbyClient.GetRemoteImageBytesAsync）——刮削源那些地址客户端多半连不上，而服务器既然列得出这一批就连得上。
-->
<ContentDialog
    x:Class="EmbyNian.Shell.Views.CoverDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EmbyNian.Shell.Views"
    Title="修改媒体封面图"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonText="用这一张">

    <ContentDialog.Resources>
        <!-- 默认的 548 只放得下两列封面。 -->
        <x:Double x:Key="ContentDialogMaxWidth">860</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12">
        <TextBlock
            x:Name="Notice"
            Style="{StaticResource EgDataStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <GridView
            x:Name="Grid"
            Height="420"
            SelectionChanged="OnPicked"
            SelectionMode="Single">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="views:CoverChoice">
                    <StackPanel Margin="0,0,0,8" Width="150">
                        <!-- 固定高、Uniform：候选封面的形状不一（海报、方的、偶尔一张横的），一格格高矮
                             不齐的网格看不出哪张更好。 -->
                        <Border
                            Height="210"
                            Style="{StaticResource EgFrameStyle}">
                            <Image
                                Source="{x:Bind Picture, Mode=OneWay}"
                                Stretch="Uniform" />
                        </Border>
                        <TextBlock
                            MaxLines="2"
                            Margin="0,6,0,0"
                            Style="{StaticResource EgDataStyle}"
                            Text="{x:Bind Caption}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </StackPanel>
</ContentDialog>
