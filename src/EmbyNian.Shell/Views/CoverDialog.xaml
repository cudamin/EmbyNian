<?xml version="1.0" encoding="utf-8"?>
<!--
  「修改媒体封面图」—— 一个条目手上每一种图各占一格的面板。

  一架仪器上的图样清单：上面六格（封面海报图、徽标、缩略图、横幅图、光盘封面、艺术图），底下单独一排
  背景图（它是唯一可以有不止一张的），每格都是「图 / 读数 / 三个键」的三段。

  为什么不是从前那种「一个网格列二十几张候选」：那种形状只能回答一个问题（用哪张海报），而这个面板要回答
  六个 —— 徽标、横幅图、背景图各有各的用途（见 ItemArtwork），只改得了海报的话，用户看着剧名上方那枚
  刮错的徽标是没有任何办法的。候选那一步没有丢，它退到了每一格的「换」键后面（CoverPickerDialog）。

  格子高矮不一是有意的：海报 2:3、横幅 5:1、光盘是方的，全按同一个高度摆的话，一张 5:1 的横幅图会被
  压成一条线，而一张海报会被拉宽到认不出。高度按各图种的宽高比算（ArtworkKind.FrameHeight）。
-->
<ContentDialog x:Uid="CoverDialog_ContentDialog1"
    x:Class="EmbyNian.Shell.Views.CoverDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EmbyNian.Shell.Views"
    xmlns:local="using:EmbyNian.Shell.Views"
    DefaultButton="Primary"
    PrimaryButtonText="完成">

    <ContentDialog.Resources>
        <!-- 默认的 548 连三格都放不下。这一版要横着摆六格：六格各 164 宽，加上对话框自己的左右内边距，
             1000 差了一口气 —— 第六格会被挤到第二行去。 -->
        <x:Double x:Key="ContentDialogMaxWidth">1080</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="{StaticResource EgSpaceL}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="Notice"
            Grid.Row="0"
            Style="{StaticResource EgDataStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource EgSpaceXL}">

                <!-- 六格。一张一张，各改各的。 -->
                <ItemsControl x:Name="Slots" ItemsSource="{x:Bind Groups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                ItemWidth="{StaticResource EgArtworkCellWidth}"
                                MaximumRowsOrColumns="6"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:ArtworkSlot">
                            <StackPanel
                                Margin="0,0,0,12"
                                Spacing="{StaticResource EgSpaceS}"
                                Width="{StaticResource EgArtworkFrameWidth}">

                                <!-- 图那一格。有图是自己的缩略图，没图是虚线框加一个加号 —— 两者点下去都是
                                     「换这一种图」，所以它整块是那一颗键。 -->
                                <Button
                                    Click="OnSwap"
                                    Padding="0"
                                    Style="{StaticResource EgArtworkTileStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind Hint}">
                                    <Grid>
                                        <Image
                                            Source="{x:Bind Picture, Mode=OneWay}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind HasPicture}" />
                                        <FontIcon
                                            Glyph="&#xE710;"
                                            Style="{StaticResource EgArtworkEmptyGlyphStyle}"
                                            Visibility="{x:Bind EmptyMark}" />
                                    </Grid>
                                </Button>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource EgDataStrongStyle}"
                                    Text="{x:Bind Caption}"
                                    TextTrimming="CharacterEllipsis" />

                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource EgSpaceS}">

                                    <!-- 换：从刮削源上挑一张，或者从本机传一张 —— 两件事一个入口，因为对用户
                                         来说是同一句话「这一格不要这张了」。 -->
                                    <Button
                                        Click="OnSwap"
                                        Style="{StaticResource EgIconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="换一张（从刮削源挑，或者从本机传）">
                                        <FontIcon FontSize="14" Glyph="&#xE721;" />
                                    </Button>

                                    <!-- 看大图。 -->
                                    <Button
                                        Click="OnView"
                                        Style="{StaticResource EgIconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="看大图">
                                        <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                                    </Button>

                                    <!-- 删。没有图的时候禁用 —— 一颗删掉空东西的键只会让人以为坏了。 -->
                                    <Button
                                        Click="OnDelete"
                                        IsEnabled="{x:Bind Has}"
                                        Style="{StaticResource EgIconButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="删除这一种图（不可撤销）">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 背景图那一排：唯一可以有不止一张的图种，所以它有自己的一摞，多出来的是「再加一张」。 -->
                <StackPanel Spacing="{StaticResource EgSpaceM}">
                    <TextBlock
                        Style="{StaticResource EgSectionTitleStyle}"
                        Text="背景图" />

                    <ItemsControl ItemsSource="{x:Bind Backdrops}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    ItemWidth="{StaticResource EgBackdropCellWidth}"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:ArtworkSlot">
                                <StackPanel
                                    Margin="0,0,0,12"
                                    Spacing="{StaticResource EgSpaceS}"
                                    Width="{StaticResource EgBackdropFrameWidth}">

                                    <Button
                                        Click="OnView"
                                        Padding="0"
                                        Style="{StaticResource EgArtworkTileStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="看大图">
                                        <Image
                                            Source="{x:Bind Picture, Mode=OneWay}"
                                            Stretch="UniformToFill" />
                                    </Button>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource EgDataStyle}"
                                        Text="{x:Bind Caption}"
                                        TextTrimming="CharacterEllipsis" />

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource EgSpaceS}">
                                        <Button
                                            Click="OnSwap"
                                            Style="{StaticResource EgIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="换这一张">
                                            <FontIcon FontSize="14" Glyph="&#xE721;" />
                                        </Button>
                                        <Button
                                            Click="OnDelete"
                                            Style="{StaticResource EgIconButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="删掉这一张（不可撤销）">
                                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 再加一张背景图：上传只在这一处，因为其余几种图一个条目本来就只有一张。 -->
                    <Button
                        Click="OnAddBackdrop"
                        Style="{StaticResource EgIconButtonStyle}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource EgSpaceS}">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock Style="{StaticResource EgBodyStyle}" Text="再加一张背景图…" />
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
