<?xml version="1.0" encoding="utf-8"?>
<!--
  HTML 颜色选择器 —— 「字幕颜色改为使用HTML颜色代码，参考 rapidtables 那个网页设置添加个一样的功能」。

  布局就是那张参考图的三段：
    左边  纯色/黑/白三层的正方形：底色是当前色相，压一层从左白到透、再一层从上透到黑 ——
          横轴是饱和度，纵轴是明度，指哪儿是哪儿，一个圆圈落在当前颜色上。
    中间  竖着的色相条，七段彩虹渐变，拖哪儿色相就是多少。
    右边  R/G/B 和 H/S/V 六个数字框（和参考图一样左右两列），加上底下的 #RRGGBB 输入框和「不设置」。

  颜色的算术（RGB↔HSV、#RRGGBB 的读写）在 Core 的 HtmlColor 上，这里只管把指头变成数、把数画出来。

  拖动期间只改屏上的东西（圆圈、色块、数字框），不写 Color —— 那是两Way绑到设置行上的，写一次就是
  存一次盘；松手、数字框落定、颜色代码敲够六位才是提交。这就是为什么颜色行那一头不会在拖动中保存四十次。
-->
<UserControl
    x:Class="EmbyNian.Shell.Views.HtmlColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 色相条：红橙黄绿青蓝紫回到红，七个档。方向是竖的，所以 StartPoint/EndPoint 走上下。 -->
        <LinearGradientBrush x:Key="HueRamp" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#FFFF0000" Offset="0" />
            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
            <GradientStop Color="#FF00FF00" Offset="0.3333" />
            <GradientStop Color="#FF00FFFF" Offset="0.5" />
            <GradientStop Color="#FF0000FF" Offset="0.6667" />
            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
            <GradientStop Color="#FFFF0000" Offset="1" />
        </LinearGradientBrush>

        <!-- 饱和度那层：左白右透，盖在色相底色上。 -->
        <LinearGradientBrush x:Key="WhiteRamp" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#FFFFFFFF" Offset="0" />
            <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <!-- 明度那层：上透下黑。 -->
        <LinearGradientBrush x:Key="BlackRamp" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#FF000000" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid RowSpacing="12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="8">
            <!-- 饱和度 × 明度 的那块方。PointerCapture 在代码后置里接，Canvas 只是为了圆圈好摆。 -->
            <Canvas
                x:Name="SatValSquare"
                x:Uid="HtmlColorPicker_SatValSquare"
                Width="176"
                Height="176"
                Background="Transparent">
                <Rectangle
                    x:Name="HueBase"
                    Width="176"
                    Height="176"
                    IsHitTestVisible="False" />
                <Rectangle
                    Width="176"
                    Height="176"
                    IsHitTestVisible="False"
                    Fill="{StaticResource WhiteRamp}" />
                <Rectangle
                    Width="176"
                    Height="176"
                    IsHitTestVisible="False"
                    Fill="{StaticResource BlackRamp}" />
                <Ellipse
                    x:Name="SatValThumb"
                    Width="12"
                    Height="12"
                    IsHitTestVisible="False"
                    Stroke="{ThemeResource EgTextBrush}"
                    StrokeThickness="2"
                    Fill="Transparent" />
            </Canvas>

            <!-- 当前颜色的那一长条，底下压着颜色代码。 -->
            <Border x:Name="PreviewBlock" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource EgBorderBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock
                    x:Uid="HtmlColorPicker_HashLabel"
                    VerticalAlignment="Center"
                    Style="{StaticResource EgBodyStyle}" />
                <TextBox
                    x:Name="HexBox"
                    x:Uid="HtmlColorPicker_HexBox"
                    Width="110"
                    AutomationProperties.AutomationId="HtmlColorHexBox" />
            </StackPanel>
        </StackPanel>

        <!-- 色相条，拖动的接法同上头那块方。 -->
        <Canvas
            x:Name="HueBar"
            x:Uid="HtmlColorPicker_HueBar"
            Grid.Column="1"
            Width="18"
            Height="176"
            Background="{StaticResource HueRamp}">
            <Border
                x:Name="HueThumb"
                Width="22"
                Height="6"
                IsHitTestVisible="False"
                Background="Transparent"
                BorderBrush="{ThemeResource EgTextBrush}"
                BorderThickness="2"
                CornerRadius="2" />
        </Canvas>

        <StackPanel Grid.Column="2" Spacing="8">
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Uid="HtmlColorPicker_RLabel" VerticalAlignment="Center" />
                <NumberBox
                    x:Name="RedBox"
                    Grid.Column="1"
                    x:Uid="HtmlColorPicker_RedBox"
                    AutomationProperties.AutomationId="HtmlColorRedBox"
                    Maximum="255"
                    Minimum="0"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact" />

                <TextBlock x:Uid="HtmlColorPicker_GLabel" Grid.Column="2" VerticalAlignment="Center" />
                <NumberBox
                    x:Name="GreenBox"
                    Grid.Column="3"
                    x:Uid="HtmlColorPicker_GreenBox"
                    AutomationProperties.AutomationId="HtmlColorGreenBox"
                    Maximum="255"
                    Minimum="0"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact" />

                <TextBlock x:Uid="HtmlColorPicker_BLabel" Grid.Row="1" VerticalAlignment="Center" />
                <NumberBox
                    x:Name="BlueBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    x:Uid="HtmlColorPicker_BlueBox"
                    AutomationProperties.AutomationId="HtmlColorBlueBox"
                    Maximum="255"
                    Minimum="0"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact" />

                <TextBlock x:Uid="HtmlColorPicker_HLabel" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" />
                <NumberBox
                    x:Name="HueBox"
                    Grid.Row="1"
                    Grid.Column="3"
                    x:Uid="HtmlColorPicker_HueBox"
                    AutomationProperties.AutomationId="HtmlColorHueBox"
                    Maximum="360"
                    Minimum="0"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact" />

                <TextBlock x:Uid="HtmlColorPicker_SLabel" Grid.Row="2" VerticalAlignment="Center" />
                <NumberBox
                    x:Name="SaturationBox"
                    Grid.Row="2"
                    Grid.Column="1"
                    x:Uid="HtmlColorPicker_SaturationBox"
                    AutomationProperties.AutomationId="HtmlColorSaturationBox"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact" />

                <TextBlock x:Uid="HtmlColorPicker_VLabel" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" />
                <NumberBox
                    x:Name="ValueBox"
                    Grid.Row="2"
                    Grid.Column="3"
                    x:Uid="HtmlColorPicker_ValueBox"
                    AutomationProperties.AutomationId="HtmlColorValueBox"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact" />
            </Grid>

            <!-- 「不设置」= 存空串 = 跟随 mpv 自己的默认。三行颜色都有这一档，所以它必须是控件本身。 -->
            <Button
                x:Name="ClearButton"
                x:Uid="HtmlColorPicker_ClearButton"
                AutomationProperties.AutomationId="HtmlColorClearButton"
                HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</UserControl>
