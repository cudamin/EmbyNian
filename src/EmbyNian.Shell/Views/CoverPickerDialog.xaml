<?xml version="1.0" encoding="utf-8"?>
<!--
  「换一张」弹出来的候选表：服务器上这个条目这一种图，各家刮削源各给几张。

  一格一张候选：图在上、一行说明在下（哪家、多大、什么语言）。用 GridView 而不是列表：挑图是用眼睛挑的，
  一行行的文字说明帮不上忙。缩略图由服务器代取（见 EmbyClient.GetRemoteImageBytesAsync）—— 刮削源那些
  地址客户端多半连不上，而服务器既然列得出这一批就连得上。

  这些都是从前的 CoverDialog 整个搬过来的，只多了一件事：底下一颗「从本机传一张」。它和这张表里的候选
  是同一个问题的两个答案（「这一格用什么图」），所以摆在一起而不是拆成两个入口。
-->
<ContentDialog x:Uid="CoverPickerDialog_ContentDialog1"
    x:Class="EmbyNian.Shell.Views.CoverPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EmbyNian.Shell.Views"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <!-- 默认的 548 只放得下两列封面。 -->
        <x:Double x:Key="ContentDialogMaxWidth">860</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="{StaticResource EgSpaceM}">
        <TextBlock
            x:Name="Notice"
            Style="{StaticResource EgDataStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <GridView
            x:Name="Grid"
            Height="380"
            SelectionChanged="OnPicked"
            SelectionMode="Single">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="views:CoverChoice">
                    <StackPanel Margin="0,0,0,8" Width="150">
                        <!-- 固定高、Uniform：候选封面的形状不一（海报、方的、偶尔一张横的），一格格高矮
                             不齐的网格看不出哪张更好。 -->
                        <Border
                            Height="210"
                            Style="{StaticResource EgFrameStyle}">
                            <Image
                                Source="{x:Bind Picture, Mode=OneWay}"
                                Stretch="Uniform" />
                        </Border>
                        <TextBlock
                            MaxLines="2"
                            Margin="0,6,0,0"
                            Style="{StaticResource EgDataStyle}"
                            Text="{x:Bind Caption}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- 这一条路和上面那些候选是同一件事的两个答案，所以摆在同一张表里。 -->
        <Button
            Click="OnUpload"
            Style="{StaticResource EgSecondaryButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource EgSpaceS}">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
                <TextBlock Style="{StaticResource EgBodyStyle}" Text="从本机传一张…" />
            </StackPanel>
        </Button>
    </StackPanel>
</ContentDialog>
