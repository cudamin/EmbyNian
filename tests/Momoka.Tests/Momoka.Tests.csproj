<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hand-rolled test host instead of xUnit/NUnit, so `dotnet run` is the test runner. This began as a
    necessity — the machine's NuGet cache was empty and the build had to work offline — and is kept as
    a preference: the test project takes no package references at all, which means the only thing it
    can be testing is Core.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Momoka.Tests</AssemblyName>
    <RootNamespace>Momoka.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Momoka.Core\Momoka.Core.csproj" />
    <None Include="..\..\assets\shaders\**\*.glsl;..\..\assets\shaders\**\*.hook">
      <Link>shaders\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
