<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hand-rolled test host instead of xUnit/NUnit: the machine's NuGet cache is empty
    and the build must work offline, so `dotnet run` is the test runner.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>EmbyMpvClient.Tests</AssemblyName>
    <RootNamespace>EmbyMpvClient.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EmbyMpvClient.Core\EmbyMpvClient.Core.csproj" />
  </ItemGroup>

</Project>
