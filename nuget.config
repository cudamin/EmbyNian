<?xml version="1.0" encoding="utf-8"?>
<!--
  Pinned explicitly because EmbyNian.Shell needs Microsoft.WindowsAppSDK from nuget.org and a
  machine-level config that clears or reorders sources would otherwise break restore. Core and the
  test project still have no package references at all.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
